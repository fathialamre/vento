// The Settings window's pages, one per feature: the controls each page
// shows and the callbacks they ask for changes through. The window
// (`settings_window.slint`) lays them out and passes the settings in.

import { LineText, Theme, ThemeColors } from "theme.slint";
import { Icons } from "wheel.slint";
import {
    PanelIcons, RowSeparator, Switch, Segmented, MenuField, TextButton, IconButton, Stepper,
    ShortcutField, ReorderRow, DragGrip, WrapText, SettingRow, RowBody, RowError, RowButton, Chip,
    Slider, SweepBand,
} from "controls.slint";

// One action in the Wheel page's list, shown on the wheel or not.
export struct ActionRow { icon: image, label: string, shown: bool }

// One folder in the Move page: its Finder icon (when `has-icon`), its name,
// where it is (its parent folder, the home folder as ~) and whether it is
// missing on disk.
export struct FolderRow { icon: image, has-icon: bool, name: string, place: string, missing: bool }

// Why the settings file was not loaded.
export component Notice inherits Rectangle {
    in property <string> text;

    border-radius: 8px;
    background: Theme.surface;

    HorizontalLayout {
        padding: 8px;
        spacing: 8px;

        VerticalLayout {
            layout-order: Theme.rtl ? 2 : 0;
            alignment: start;

            Image {
                source: Icons.missing;
                width: 14px;
                height: 14px;
                colorize: Theme.danger;
            }
        }

        Text {
            layout-order: Theme.rtl ? 1 : 0;
            horizontal-alignment: Theme.rtl ? right : left;
            text: root.text;
            font-size: 12px;
            color: Theme.text;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }
    }
}

// How to use a page's feature, the last row of its panel: a header that
// opens and closes it, and while open the steps, numbered. It shows `open`
// as given and asks for the other state when clicked; the window keeps it.
export component HowTo inherits Rectangle {
    in property <[string]> steps;
    in property <bool> open;
    callback toggled(bool);

    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 14px;
        padding-bottom: 14px;
        spacing: 10px;

        header := Rectangle {
            height: 18px;
            accessible-role: button;
            accessible-label: @tr("How to use");
            accessible-expandable: true;
            accessible-expanded: root.open;
            accessible-action-default => { root.toggled(!root.open); }
            accessible-action-expand => { root.toggled(!root.open); }

            HorizontalLayout {
                spacing: 8px;

                VerticalLayout {
                    layout-order: Theme.rtl ? 3 : 0;
                    alignment: center;

                    Image {
                        source: Icons.info;
                        width: 14px;
                        height: 14px;
                        colorize: Theme.accent;
                    }
                }

                Text {
                    layout-order: Theme.rtl ? 2 : 0;
                    horizontal-alignment: Theme.rtl ? right : left;
                    text: @tr("How to use");
                    font-size: 13px;
                    font-weight: 500;
                    color: Theme.text;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                // Points down while open, else to where the line reads on.
                VerticalLayout {
                    layout-order: Theme.rtl ? 1 : 0;
                    alignment: center;

                    Image {
                        source: root.open ? PanelIcons.open-down : Theme.rtl ? Icons.back : Icons.back-rtl;
                        width: 14px;
                        height: 14px;
                        colorize: Theme.muted;
                    }
                }
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.toggled(!root.open); }
            }
        }

        if root.open: VerticalLayout {
            spacing: 6px;

            for step[i] in root.steps: HorizontalLayout {
                spacing: 8px;

                VerticalLayout {
                    layout-order: Theme.rtl ? 2 : 0;
                    alignment: start;

                    Rectangle {
                        width: 18px;
                        height: 18px;
                        border-radius: self.height / 2;
                        background: Theme.accent-soft;

                        Text {
                            text: i + 1;
                            font-size: 11px;
                            font-weight: 600;
                            color: Theme.accent;
                        }
                    }
                }

                WrapText {
                    layout-order: Theme.rtl ? 1 : 0;
                    text: step;
                    font-size: 12px;
                    color: Theme.text;
                    horizontal-stretch: 1;
                }
            }
        }
    }
}

// A small picture of a window in one look of a theme: its sidebar, and a
// title in the accent over two lines of text.
component LookPicture inherits Rectangle {
    in property <ThemeColors> look;

    // The sidebar's width, and where the text starts and how wide it runs.
    property <length> side: self.width * 0.3;
    property <length> text-x: Theme.rtl ? 6px : self.side + 6px;
    property <length> text-w: self.width - self.side - 12px;

    background: root.look.bg;

    Rectangle {
        x: Theme.rtl ? root.width - root.side : 0px;
        width: root.side;
        background: root.look.card;
    }

    for line[i] in [0.6, 0.85, 0.7]: Rectangle {
        x: Theme.rtl ? root.text-x + root.text-w * (1 - line) : root.text-x;
        y: i == 0 ? 6px : 9px + i * 9px;
        width: root.text-w * line;
        height: i == 0 ? 7px : 5px;
        border-radius: 3px;
        background: i == 0 ? root.look.accent.transparentize(0.4) : root.look.muted.transparentize(0.6);
    }
}

// One look the Appearance setting can take, as a picture with its name
// under it, ringed in the accent while chosen. System shows the light and
// the dark side by side.
component LookTile inherits VerticalLayout {
    in property <string> label;
    in property <bool> chosen;
    // 0 System, 1 Light, 2 Dark, as the setting counts them.
    in property <int> kind;
    callback clicked();

    spacing: 6px;
    accessible-role: radio-button;
    accessible-label: self.label;
    accessible-checkable: true;
    accessible-checked: self.chosen;
    accessible-action-default => { self.clicked(); }

    Rectangle {
        height: 62px;
        border-radius: 10px;
        border-width: 2px;
        border-color: root.chosen ? Theme.accent : touch.has-hover ? Theme.panel-line : transparent;

        Rectangle {
            x: 4px;
            y: 4px;
            width: parent.width - 8px;
            height: parent.height - 8px;
            border-radius: 6px;
            clip: true;

            if root.kind != 0: LookPicture {
                width: parent.width;
                height: parent.height;
                look: Theme.look(Theme.palette, root.kind == 2);
            }

            // The light half first, where the line starts.
            if root.kind == 0: LookPicture {
                x: Theme.rtl ? parent.width / 2 : 0px;
                width: parent.width / 2;
                height: parent.height;
                look: Theme.look(Theme.palette, false);
            }
            if root.kind == 0: LookPicture {
                x: Theme.rtl ? 0px : parent.width / 2;
                width: parent.width / 2;
                height: parent.height;
                look: Theme.look(Theme.palette, true);
            }

            // Its edge, over the picture.
            Rectangle {
                border-radius: 6px;
                border-width: 1px;
                border-color: #8080802e;
            }
        }

        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.clicked(); }
        }
    }

    Text {
        horizontal-alignment: center;
        text: root.label;
        font-size: 12px;
        font-weight: root.chosen ? 500 : 400;
        color: root.chosen ? Theme.text : Theme.muted;
    }
}

// The Appearance setting's three looks, side by side.
component LookPicker inherits HorizontalLayout {
    // 0 System, 1 Light, 2 Dark.
    in property <int> current;
    callback chosen(int);

    spacing: 10px;
    accessible-role: radio-group;
    accessible-label: @tr("Appearance");

    LookTile {
        layout-order: Theme.rtl ? 3 : 0;
        kind: 1;
        label: @tr("Light");
        chosen: root.current == 1;
        clicked => { root.chosen(1); }
    }

    LookTile {
        layout-order: Theme.rtl ? 2 : 0;
        kind: 2;
        label: @tr("Dark");
        chosen: root.current == 2;
        clicked => { root.chosen(2); }
    }

    LookTile {
        layout-order: Theme.rtl ? 1 : 0;
        kind: 0;
        label: @tr("System");
        chosen: root.current == 0;
        clicked => { root.chosen(0); }
    }
}

// One shape the resting virtual island can take, drawn small on the
// island's dark with its name under it, ringed in the accent while chosen.
component ShapeTile inherits VerticalLayout {
    in property <string> label;
    in property <bool> chosen;
    // 0 the island's pill, 1 a circle, as the setting counts them.
    in property <int> kind;
    callback clicked();

    spacing: 6px;
    width: 120px;
    accessible-role: radio-button;
    accessible-label: self.label;
    accessible-checkable: true;
    accessible-checked: self.chosen;
    accessible-action-default => { self.clicked(); }

    Rectangle {
        height: 64px;
        border-radius: 10px;
        border-width: 2px;
        border-color: root.chosen ? Theme.accent : touch.has-hover ? Theme.panel-line : transparent;

        Rectangle {
            x: 2px;
            y: 2px;
            width: parent.width - 4px;
            height: parent.height - 4px;
            border-radius: 8px;
            background: #1c1c1e;

            // The shape itself: black, with a faint edge and the orange dot.
            Rectangle {
                width: root.kind == 0 ? 60px : 18px;
                height: root.kind == 0 ? 14px : 18px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: self.height / 2;
                background: #000000;
                border-width: 1px;
                border-color: #ffffff22;

                Rectangle {
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    background: #ff6a1a;
                    x: root.kind == 0
                        ? (Theme.rtl ? parent.width - self.width - 8px : 8px)
                        : (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }

        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.clicked(); }
        }
    }

    Text {
        horizontal-alignment: center;
        text: root.label;
        font-size: 12px;
        font-weight: root.chosen ? 500 : 400;
        color: root.chosen ? Theme.text : Theme.muted;
    }
}

// The Shape setting's two shapes, side by side.
component ShapePicker inherits HorizontalLayout {
    // 0 Island, 1 Circle.
    in property <int> current;
    callback chosen(int);

    spacing: 8px;
    alignment: Theme.rtl ? end : start;
    accessible-role: radio-group;
    accessible-label: @tr("Shape");

    ShapeTile {
        layout-order: Theme.rtl ? 1 : 0;
        kind: 0;
        label: @tr("Island");
        chosen: root.current == 0;
        clicked => { root.chosen(0); }
    }

    ShapeTile {
        layout-order: Theme.rtl ? 0 : 1;
        kind: 1;
        label: @tr("Circle");
        chosen: root.current == 1;
        clicked => { root.chosen(1); }
    }
}

// One shimmer style, drawn on a still island over its name, ringed in the
// accent while chosen. Hovering it or choosing it plays the style once
// over 1.2 s (never when Reduce motion is on); nothing else moves.
component ShimmerTile inherits VerticalLayout {
    in property <string> label;
    in property <bool> chosen;
    // The style as the setting counts them: 0 Off, 1 Sweep, 2 Edge run,
    // 3 Halo, 4 Sparkle, 5 Liquid.
    in property <int> kind;
    // Whether the island is drawn as the circle rather than the pill.
    in property <bool> circle;
    // Whether the previews stay still.
    in property <bool> reduce-motion;
    callback clicked();

    // How far the moment has played, 0 to 1; 0 while it is not playing.
    property <bool> playing;
    property <duration> start;
    property <float> t: root.playing ? min(1, (animation-tick() - root.start) / 1200ms) : 0;
    // The island drawn, its width growing for Liquid, and where it sits.
    property <length> base-w: root.circle ? 18px : 56px;
    property <length> base-h: root.circle ? 18px : 14px;
    property <length> grow: root.kind == 5 ? 4px * (0.5 + 0.5 * Math.cos(root.t * 720deg)) : 0px;
    property <length> w: root.base-w + root.grow;
    property <length> h: root.base-h;
    function play() {
        if !root.reduce-motion && root.kind != 0 && !root.playing {
            root.start = animation-tick();
            root.playing = true;
            play-timer.restart();
        }
    }
    changed chosen => {
        if root.chosen {
            root.play();
        }
    }
    play-timer := Timer {
        interval: 1200ms;
        running: root.playing;
        triggered => {
            root.playing = false;
        }
    }

    spacing: 6px;
    width: 96px;
    accessible-role: radio-button;
    accessible-label: self.label;
    accessible-checkable: true;
    accessible-checked: self.chosen;
    accessible-action-default => { self.clicked(); }

    Rectangle {
        height: 64px;
        border-radius: 10px;
        border-width: 2px;
        border-color: root.chosen ? Theme.accent : touch.has-hover ? Theme.panel-line : transparent;

        Rectangle {
            x: 2px;
            y: 2px;
            width: parent.width - 4px;
            height: parent.height - 4px;
            border-radius: 8px;
            background: #1c1c1e;

            // Halo: a faint orange ring just outside the edge, lit and
            // faded, like the island's own.
            if root.kind == 3: Rectangle {
                width: root.w + 8px;
                height: root.h + 8px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: self.height / 2;
                border-width: 2px;
                border-color: #ff6a1a;
                opacity: root.playing ? 0.15 + 0.6 * Math.sin(root.t * 180deg) : 0.15;
            }

            // The island, black with a faint edge; Sweep and Edge run
            // are drawn on it, kept within its shape (the renderer clips
            // only to rectangles, so they are cut to it by hand).
            island := Rectangle {
                width: root.w;
                height: root.h;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: self.height / 2;
                background: #000000;
                border-width: 1px;
                border-color: #ffffff22;
                clip: true;

                // Sweep: a band of light crossing from side to side.
                if root.kind == 1: SweepBand {
                    x: 0px;
                    y: 0px;
                    w: root.w;
                    h: root.h;
                    band: 10px;
                    left: root.playing ? -10px + root.t * (root.w + 10px) : (root.w - 10px) / 2;
                    slices: 5;
                    peak: 0.4;
                }

                // Edge run: a short bright segment on the edge; played, it
                // runs along the top, then back along the bottom, showing
                // only on the straight run between the round ends. On the
                // circle, a dot runs round just inside the edge.
                if root.kind == 2 && !root.circle: Rectangle {
                    property <bool> top: root.t < 0.5;
                    // Where the segment would be, and the straight run it
                    // shows on.
                    property <length> at: !root.playing ? (root.w - 12px) / 2
                        : self.top ? -12px + root.t * 2 * (root.w + 12px)
                        : root.w - (root.t - 0.5) * 2 * (root.w + 12px);
                    property <length> from: max(root.h / 2, self.at);
                    property <length> to: min(root.w - root.h / 2, self.at + 12px);
                    width: max(0px, self.to - self.from);
                    height: 2px;
                    background: #ffffffdd;
                    x: self.from;
                    y: !root.playing || self.top ? 0px : root.h - 2px;
                }

                if root.kind == 2 && root.circle: Rectangle {
                    width: 4px;
                    height: 4px;
                    border-radius: 2px;
                    background: #ffffffdd;
                    x: (root.w - self.width) / 2 + (root.playing ? 6.5px * Math.sin(root.t * 360deg) : 0px);
                    y: (root.h - self.height) / 2 - (root.playing ? 6.5px * Math.cos(root.t * 360deg) : 6.5px);
                }
            }

            // Sparkle: three tiny four-point stars, each twinkling in turn.
            for pos[i] in [{ fx: 0.2, fy: 0.15 }, { fx: 0.5, fy: 0.8 }, { fx: 0.8, fy: 0.2 }]: Path {
                width: 5px;
                height: 5px;
                x: island.x + pos.fx * (root.w - 5px);
                y: island.y + pos.fy * (root.h - 5px);
                viewbox-width: 5;
                viewbox-height: 5;
                commands: "M 2.5 0 L 3 2 L 5 2.5 L 3 3 L 2.5 5 L 2 3 L 0 2.5 L 2 2 Z";
                fill: #ffffff;
                visible: root.kind == 4;
                opacity: root.playing
                    ? 0.2 + 0.8 * Math.max(0, Math.sin(Math.clamp((root.t - 0.2 * i) / 0.6, 0, 1) * 180deg))
                    : 0.85;
            }
        }

        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.clicked(); }
            changed has-hover => {
                if self.has-hover {
                    root.play();
                }
            }
        }
    }

    Text {
        horizontal-alignment: center;
        text: root.label;
        font-size: 12px;
        font-weight: root.chosen ? 500 : 400;
        color: root.chosen ? Theme.text : Theme.muted;
    }
}

// The Shimmer setting's styles, Off first, in rows as wide as the page
// allows.
component ShimmerPicker inherits Rectangle {
    in property <int> current;
    in property <bool> circle;
    in property <bool> reduce-motion;
    callback chosen(int);

    property <[string]> names: [
        @tr("Off"), @tr("Sweep"), @tr("Edge run"), @tr("Halo"), @tr("Sparkle"), @tr("Liquid"),
    ];
    property <length> gap: 8px;
    property <length> cell-w: 96px;
    property <length> cell-h: 88px;
    property <int> columns: max(1, floor((self.width + self.gap) / (self.cell-w + self.gap)));

    height: ceil(self.names.length / self.columns) * (self.cell-h + self.gap) - self.gap;
    accessible-role: radio-group;
    accessible-label: @tr("Shimmer");

    for name[i] in root.names: ShimmerTile {
        property <int> column: mod(i, root.columns);

        // Each row starts at the page's start edge: the right one in a
        // right-to-left language.
        x: Theme.rtl ? root.width - root.cell-w - self.column * (root.cell-w + root.gap)
            : self.column * (root.cell-w + root.gap);
        y: floor(i / root.columns) * (root.cell-h + root.gap);
        height: root.cell-h;
        kind: i;
        label: name;
        circle: root.circle;
        reduce-motion: root.reduce-motion;
        chosen: root.current == i;
        clicked => { root.chosen(i); }
    }
}

// The themes, each a dot in its accent over its name, the chosen one
// ringed in the accent: one row where the page is wide enough, else rows
// of four.
component ThemePicker inherits Rectangle {
    in property <[string]> names;
    in property <int> current;
    callback chosen(int);

    property <length> gap: 4px;
    property <int> columns: (self.width - 6 * self.gap) / 7 >= 60px ? 7 : 4;
    property <length> cell-w: (self.width - (self.columns - 1) * self.gap) / self.columns;
    property <length> cell-h: 50px;

    height: ceil(self.names.length / self.columns) * (self.cell-h + self.gap) - self.gap;
    accessible-role: radio-group;
    accessible-label: @tr("Theme");

    for name[i] in root.names: Rectangle {
        property <bool> on: i == root.current;
        property <int> column: mod(i, root.columns);

        x: (Theme.rtl ? root.columns - 1 - self.column : self.column) * (root.cell-w + root.gap);
        y: floor(i / root.columns) * (root.cell-h + root.gap);
        width: root.cell-w;
        height: root.cell-h;
        border-radius: 8px;
        border-width: self.on ? 1.5px : 0px;
        border-color: Theme.accent;
        background: !self.on && touch.has-hover ? Theme.field : transparent;
        accessible-role: radio-button;
        accessible-label: name;
        accessible-checkable: true;
        accessible-checked: self.on;
        accessible-action-default => { root.chosen(i); }

        Rectangle {
            y: 8px;
            width: 16px;
            height: 16px;
            border-radius: 8px;
            background: Theme.look(i, Theme.dark).accent;
        }

        LineText {
            x: 2px;
            y: 30px;
            width: parent.width - 4px;
            horizontal-alignment: center;
            text: name;
            font-size: 11px;
            font-weight: parent.on ? 500 : 400;
            color: parent.on ? Theme.text : Theme.muted;
        }

        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.chosen(i); }
        }
    }
}

// The wheel's actions, one row each: a grip to drag the row into a new
// place, the action's icon and name, and a switch to show or hide it.
// While a row is dragged it follows the pointer and the rows it passes
// make room; it drops at the row nearest to where it was let go. The shown
// rows come first and a row stays among its own kind (switching it on or
// off moves it between them).
component ActionList inherits Rectangle {
    in property <[ActionRow]> rows;
    // How many of the rows are shown on the wheel (they come first).
    in property <int> shown-count;
    callback toggled(int, bool);
    callback moved(int, int);

    property <length> row-h: 34px;
    // The row being dragged (-1 for none), how far it has moved, the first
    // and last place it can go, and the place it would drop at now.
    property <int> drag-from: -1;
    property <length> drag-offset;
    property <int> drag-lo: self.drag-from < self.shown-count ? 0 : self.shown-count;
    property <int> drag-hi: self.drag-from < self.shown-count
        ? self.shown-count - 1
        : self.rows.length - 1;
    property <int> drag-to: self.drag-from < 0
        ? -1
        : clamp(self.drag-from + round(self.drag-offset / self.row-h), self.drag-lo, self.drag-hi);

    height: self.rows.length * self.row-h;

    for row[i] in root.rows: ReorderRow {
        index: i;
        drag-from: root.drag-from;
        drag-to: root.drag-to;
        drag-offset: root.drag-offset;
        row-h: root.row-h;
        width: root.width;
        accessible-role: list-item;
        accessible-label: row.label;

        HorizontalLayout {
            padding-left: Theme.rtl ? 6px : 2px;
            padding-right: Theme.rtl ? 2px : 6px;
            spacing: 8px;

            DragGrip {
                layout-order: Theme.rtl ? 4 : 0;
                index: i;
                row-h: root.row-h;
                lo: root.drag-lo;
                hi: root.drag-hi;
                drop-to: root.drag-to;
                drag-from <=> root.drag-from;
                drag-offset <=> root.drag-offset;
                moved(from, to) => { root.moved(from, to); }
            }

            VerticalLayout {
                layout-order: Theme.rtl ? 3 : 0;
                alignment: center;

                Image {
                    source: row.icon;
                    width: 16px;
                    height: 16px;
                    colorize: row.shown ? Theme.text : Theme.muted;
                }
            }

            Text {
                layout-order: Theme.rtl ? 2 : 0;
                horizontal-alignment: Theme.rtl ? right : left;
                text: row.label;
                font-size: 13px;
                color: row.shown ? Theme.text : Theme.muted;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            VerticalLayout {
                layout-order: Theme.rtl ? 1 : 0;
                alignment: center;

                Switch {
                    on: row.shown;
                    label: row.label;
                    toggled(on) => { root.toggled(i, on); }
                }
            }
        }
    }
}

export component WheelPage inherits VerticalLayout {
    // 0 Honeycomb, 1 Petals.
    in property <int> wheel-layout;
    in property <[ActionRow]> actions;
    in property <int> shown-actions;
    callback layout-chosen(int);
    callback action-toggled(int, bool);
    callback action-moved(int, int);

    SettingRow {
        label: @tr("Layout");
        description: @tr("How the actions sit around the pointer");

        Segmented {
            width: 180px;
            items: [@tr("Honeycomb"), @tr("Petals")];
            current: root.wheel-layout;
            chosen(i) => { root.layout-chosen(i); }
        }
    }

    RowSeparator { }

    SettingRow {
        label: @tr("Actions");
        description: @tr("Drag to reorder");
        padding-bottom: 6px;
    }

    RowBody {
        padding-left: 10px;
        padding-right: 10px;
        padding-bottom: 6px;

        ActionList {
            rows: root.actions;
            shown-count: root.shown-actions;
            toggled(i, on) => { root.action-toggled(i, on); }
            moved(from, to) => { root.action-moved(from, to); }
        }
    }
}

// A folder's icon and name, with where it is after them in a dimmer
// colour; dimmed as a whole when the folder is missing.
component FolderLabel inherits HorizontalLayout {
    in property <FolderRow> folder;

    spacing: 8px;

    VerticalLayout {
        layout-order: Theme.rtl ? 3 : 0;
        alignment: center;

        if root.folder.has-icon: Image {
            source: root.folder.icon;
            width: 16px;
            height: 16px;
            opacity: root.folder.missing ? 0.4 : 1;
        }
        if !root.folder.has-icon: Image {
            source: PanelIcons.folder;
            width: 16px;
            height: 16px;
            colorize: Theme.muted;
            opacity: root.folder.missing ? 0.4 : 1;
        }
    }

    // The name keeps to its own width, up to half the narrowest page (the
    // window's least width leaves the page 340 px); where it is takes the
    // rest.
    LineText {
        layout-order: Theme.rtl ? 2 : 0;
        horizontal-alignment: Theme.rtl ? right : left;
        text: root.folder.name;
        font-size: 13px;
        color: root.folder.missing ? Theme.muted : Theme.text;
        vertical-alignment: center;
        horizontal-stretch: 0;
        max-width: 170px;
    }

    LineText {
        layout-order: Theme.rtl ? 1 : 0;
        horizontal-alignment: Theme.rtl ? right : left;
        text: root.folder.missing ? @tr("Missing") : root.folder.place;
        font-size: 11px;
        color: Theme.muted;
        vertical-alignment: center;
        horizontal-stretch: 1;
    }
}

// The pinned folders, in ring order: a grip to drag a row into a new
// place, the folder, and a button to unpin it.
component PinnedList inherits Rectangle {
    in property <[FolderRow]> rows;
    callback moved(int, int);
    callback unpinned(int);

    property <length> row-h: 34px;
    // The row being dragged (-1 for none), how far it has moved, and the
    // place it would drop at now.
    property <int> drag-from: -1;
    property <length> drag-offset;
    property <int> drag-to: self.drag-from < 0
        ? -1
        : clamp(self.drag-from + round(self.drag-offset / self.row-h), 0, self.rows.length - 1);

    height: self.rows.length * self.row-h;

    for row[i] in root.rows: ReorderRow {
        index: i;
        drag-from: root.drag-from;
        drag-to: root.drag-to;
        drag-offset: root.drag-offset;
        row-h: root.row-h;
        width: root.width;
        accessible-role: list-item;
        accessible-label: row.name;

        HorizontalLayout {
            padding-left: 2px;
            padding-right: 2px;
            spacing: 8px;

            DragGrip {
                layout-order: Theme.rtl ? 3 : 0;
                index: i;
                row-h: root.row-h;
                lo: 0;
                hi: root.rows.length - 1;
                drop-to: root.drag-to;
                drag-from <=> root.drag-from;
                drag-offset <=> root.drag-offset;
                moved(from, to) => { root.moved(from, to); }
            }

            FolderLabel {
                layout-order: Theme.rtl ? 2 : 0;
                folder: row;
                horizontal-stretch: 1;
            }

            VerticalLayout {
                layout-order: Theme.rtl ? 1 : 0;
                alignment: center;

                IconButton {
                    icon: Icons.remove;
                    label: @tr("Unpin {}", row.name);
                    clicked => { root.unpinned(i); }
                }
            }
        }
    }
}

// What a list with no rows shows instead.
component EmptyLine inherits Text {
    horizontal-alignment: Theme.rtl ? right : left;
    height: 30px;
    font-size: 12px;
    color: Theme.muted;
    vertical-alignment: center;
}

export component MovePage inherits VerticalLayout {
    in property <[FolderRow]> pinned;
    in property <bool> pinned-full;
    in property <[FolderRow]> recent;
    // The recent history holds folders, shown or not.
    in property <bool> has-history;
    in property <bool> can-pin;
    in property <string> hold;
    in property <bool> hold-can-decrease;
    in property <bool> hold-can-increase;
    callback add-folder();
    callback pinned-moved(int, int);
    callback unpinned(int);
    callback recent-pinned(int);
    callback recent-cleared();
    callback hold-stepped(int);

    SettingRow {
        label: @tr("Pinned");
        padding-bottom: 6px;

        TextButton {
            label: root.pinned-full ? @tr("Up to 7 folders") : @tr("Add folder");
            icon: PanelIcons.add;
            has-icon: !root.pinned-full;
            enabled: !root.pinned-full;
            clicked => { root.add-folder(); }
        }
    }

    RowBody {
        padding-left: 10px;
        padding-right: 10px;
        padding-bottom: 8px;

        if root.pinned.length == 0: EmptyLine {
            text: @tr("No pinned folders");
        }

        if root.pinned.length > 0: PinnedList {
            rows: root.pinned;
            moved(from, to) => { root.pinned-moved(from, to); }
            unpinned(i) => { root.unpinned(i); }
        }
    }

    RowSeparator { }

    SettingRow {
        label: @tr("Recent");
        padding-bottom: 6px;

        TextButton {
            label: @tr("Clear");
            enabled: root.has-history;
            clicked => { root.recent-cleared(); }
        }
    }

    RowBody {
        padding-left: 10px;
        padding-right: 10px;
        padding-bottom: 8px;

        if root.recent.length == 0: EmptyLine {
            text: @tr("No recent folders");
        }

        for row[i] in root.recent: Rectangle {
            height: 30px;
            accessible-role: list-item;
            accessible-label: row.name;

            HorizontalLayout {
                padding-left: 2px;
                padding-right: 2px;
                spacing: 8px;

                FolderLabel {
                    layout-order: Theme.rtl ? 2 : 0;
                    folder: row;
                    horizontal-stretch: 1;
                }

                VerticalLayout {
                    layout-order: Theme.rtl ? 1 : 0;
                    alignment: center;

                    IconButton {
                        icon: Icons.pin;
                        label: @tr("Pin {}", row.name);
                        enabled: root.can-pin;
                        clicked => { root.recent-pinned(i); }
                    }
                }
            }
        }
    }

    RowSeparator { }

    SettingRow {
        label: @tr("Hold on Move");
        description: @tr("How long to rest on Move, Copy to or Convert before its ring opens");

        Stepper {
            text: root.hold;
            label: @tr("Hold on Move");
            can-decrease: root.hold-can-decrease;
            can-increase: root.hold-can-increase;
            decrease => { root.hold-stepped(-1); }
            increase => { root.hold-stepped(1); }
        }
    }
}

export component PocketPage inherits VerticalLayout {
    // The Pocket shortcut as symbols, and why the last one recorded was
    // refused (empty when it was not).
    in property <string> shortcut;
    in-out property <string> shortcut-error;
    in-out property <bool> recording;
    in property <bool> remove-after-drop;
    in property <bool> keep-copies;
    // What the Pocket view opens on: 0 its kinds, 1 the list.
    in property <int> pocket-view;
    callback recording-started();
    callback recording-cancelled();
    callback remove-after-drop-toggled(bool);
    callback keep-copies-toggled(bool);
    callback pocket-view-chosen(int);

    SettingRow {
        label: @tr("Shortcut");
        description: @tr("Opens the island on the Pocket");

        ShortcutField {
            width: 150px;
            text: root.shortcut;
            label: @tr("Pocket shortcut");
            recording <=> root.recording;
            started => {
                root.shortcut-error = "";
                root.recording-started();
            }
            cancelled => { root.recording-cancelled(); }
        }
    }

    if root.shortcut-error != "": RowError {
        text: root.shortcut-error;
    }

    RowSeparator { }

    SettingRow {
        label: @tr("Remove after drag-out");
        description: @tr("An item leaves the Pocket once you drop it somewhere");

        Switch {
            label: @tr("Remove after drag-out");
            on: root.remove-after-drop;
            toggled(on) => { root.remove-after-drop-toggled(on); }
        }
    }

    RowSeparator { }

    SettingRow {
        label: @tr("Keep a copy");
        description: @tr("Vento keeps its own copy of each file, not only a link to it");

        Switch {
            label: @tr("Keep a copy");
            on: root.keep-copies;
            toggled(on) => { root.keep-copies-toggled(on); }
        }
    }

    RowSeparator { }

    SettingRow {
        label: @tr("When the Pocket opens, show");
        description: @tr("Its items by kind, or as a list; the bar under it switches between the two");

        MenuField {
            width: 130px;
            label: @tr("When the Pocket opens, show");
            items: [@tr("By kind"), @tr("List")];
            current: root.pocket-view;
            chosen(i) => { root.pocket-view-chosen(i); }
        }
    }
}

// The island: which one the screen shows and, for the virtual island, its
// place and Glass. Where the virtual island can't be chosen, a line says so.
export component IslandPage inherits VerticalLayout {
    // Whether the virtual island can be chosen on the island's screen (it
    // has no notch, and the platform can place it), and whether it is.
    in property <bool> offered;
    in property <bool> virtual;
    // What the other island is called there: where it sits today.
    in property <string> classic-label;
    // Where the virtual island sits: 0 Left, 1 Centre, 2 Right, -1 a free
    // spot between them. Left is always the physical left.
    in property <int> place;
    // Whether each screen keeps its own place.
    in property <bool> each-screen;
    // How it looks while resting: 0 Island, 1 Circle.
    in property <int> shape;
    // How solid it is while resting, in percent (100 = solid).
    in property <int> glass;
    // The shimmer style (an index of `ShimmerStyle::ALL`, 0 Off), how often
    // it plays (of `ShimmerEvery::ALL`), whether it waits for items in the
    // Pocket and whether Reduce motion is followed.
    in property <int> shimmer;
    in property <int> shimmer-every;
    in property <bool> shimmer-needs-items;
    in property <bool> follow-reduce;
    // Whether motion is reduced (Reduce motion is followed and the system
    // asks for it; the previews stay still), and whether the shape chosen
    // is the circle (the previews draw it).
    in property <bool> reduce-motion;
    in property <bool> circle;
    // 0 the virtual island, 1 the other one.
    callback mode-chosen(int);
    callback shape-chosen(int);
    callback place-chosen(int);
    callback each-screen-toggled(bool);
    callback glass-changed(int);
    callback shimmer-chosen(int);
    callback shimmer-every-chosen(int);
    callback shimmer-needs-items-toggled(bool);
    callback follow-reduce-toggled(bool);

    if root.offered: VerticalLayout {
        SettingRow {
            label: @tr("Island");
            description: @tr("Where the Pocket, Clipboard and Screenshots live on this screen");

            MenuField {
                width: 190px;
                label: @tr("Island");
                items: [@tr("Virtual island"), root.classic-label];
                current: root.virtual ? 0 : 1;
                chosen(i) => { root.mode-chosen(i); }
            }
        }

        if root.virtual: VerticalLayout {
            RowSeparator { }

            SettingRow {
                label: @tr("Shape");
                description: @tr("How the island looks while resting");
            }

            RowBody {
                ShapePicker {
                    current: root.shape;
                    chosen(i) => { root.shape-chosen(i); }
                }
            }

            RowSeparator { }

            SettingRow {
                label: @tr("Place");
                description: @tr("Along the top edge, or drag the open island's top bar");

                // The control puts its first item at the start of the line,
                // so in right-to-left the items run Right to Left and each
                // button still sits on the side it names.
                Segmented {
                    width: 210px;
                    items: Theme.rtl
                        ? [@tr("Right"), @tr("Centre"), @tr("Left")]
                        : [@tr("Left"), @tr("Centre"), @tr("Right")];
                    current: root.place < 0 ? -1 : (Theme.rtl ? 2 - root.place : root.place);
                    chosen(i) => { root.place-chosen(Theme.rtl ? 2 - i : i); }
                }
            }

            RowSeparator { }

            SettingRow {
                label: @tr("A place for each screen");
                description: @tr("The island remembers where it sits on every screen");

                Switch {
                    label: @tr("A place for each screen");
                    on: root.each-screen;
                    toggled(on) => { root.each-screen-toggled(on); }
                }
            }

            RowSeparator { }

            SettingRow {
                label: @tr("Glass");
                description: @tr("How solid the island is while resting");
                padding-bottom: 6px;

                Text {
                    min-width: 40px;
                    text: @tr("{}%", root.glass);
                    font-size: 13px;
                    color: Theme.text;
                    horizontal-alignment: Theme.rtl ? left : right;
                    vertical-alignment: center;
                }
            }

            RowBody {
                HorizontalLayout {
                    spacing: 6px;

                    VerticalLayout {
                        layout-order: Theme.rtl ? 4 : 0;
                        alignment: center;
                        horizontal-stretch: 1;

                        // The bounds and step of the settings' Glass, and
                        // its presets below (`GLASS_*` in vento-core).
                        Slider {
                            minimum: 10;
                            maximum: 100;
                            step: 5;
                            value: root.glass;
                            label: @tr("Glass");
                            changed(v) => { root.glass-changed(round(v)); }
                        }
                    }

                    // The presets, from the most see-through.
                    Chip {
                        layout-order: Theme.rtl ? 3 : 0;
                        width: 64px;
                        label: @tr("Ghost");
                        chosen: root.glass == 25;
                        clicked => { root.glass-changed(25); }
                    }

                    Chip {
                        layout-order: Theme.rtl ? 2 : 0;
                        width: 64px;
                        label: @tr("Glass");
                        chosen: root.glass == 55;
                        clicked => { root.glass-changed(55); }
                    }

                    Chip {
                        layout-order: Theme.rtl ? 1 : 0;
                        width: 64px;
                        label: @tr("Solid");
                        chosen: root.glass == 100;
                        clicked => { root.glass-changed(100); }
                    }
                }
            }

            RowSeparator { }

            SettingRow {
                label: @tr("Shimmer");
                description: @tr("A small moment of light while the island rests");
            }

            RowBody {
                ShimmerPicker {
                    current: root.shimmer;
                    circle: root.circle;
                    reduce-motion: root.reduce-motion;
                    chosen(i) => { root.shimmer-chosen(i); }
                }
            }

            if root.shimmer != 0: VerticalLayout {
                RowSeparator { }

                SettingRow {
                    label: @tr("How often");

                    Segmented {
                        width: 210px;
                        items: [@tr("Rarely"), @tr("Sometimes"), @tr("Often")];
                        current: root.shimmer-every;
                        chosen(i) => { root.shimmer-every-chosen(i); }
                    }
                }

                RowSeparator { }

                SettingRow {
                    label: @tr("Only while the Pocket holds items");

                    Switch {
                        label: @tr("Only while the Pocket holds items");
                        on: root.shimmer-needs-items;
                        toggled(on) => { root.shimmer-needs-items-toggled(on); }
                    }
                }
            }

            RowSeparator { }

            SettingRow {
                label: @tr("Follow Reduce motion");
                description: @tr("No shimmer, no shake, plain fades when the system asks for less motion");

                Switch {
                    label: @tr("Follow Reduce motion");
                    on: root.follow-reduce;
                    toggled(on) => { root.follow-reduce-toggled(on); }
                }
            }
        }
    }

    if !root.offered: SettingRow {
        label: @tr("Virtual island");
        description: @tr("Not available on this screen");
    }
}

export component ClipboardPage inherits VerticalLayout {
    // The history records copies; while it does not, its shortcut is not
    // registered and its field cannot record.
    in property <bool> history;
    // The Clipboard shortcut as symbols, and why the last one recorded was
    // refused (empty when it was not).
    in property <string> shortcut;
    in-out property <string> shortcut-error;
    in-out property <bool> recording;
    callback history-toggled(bool);
    callback recording-started();
    callback recording-cancelled();
    callback history-cleared();

    // "Clear…" was clicked: the row asks to confirm.
    property <bool> confirming;

    SettingRow {
        label: @tr("Clipboard history");
        description: @tr("Remember what you copy");

        Switch {
            label: @tr("Clipboard history");
            on: root.history;
            toggled(on) => { root.history-toggled(on); }
        }
    }

    RowSeparator { }

    SettingRow {
        label: @tr("Shortcut");
        description: @tr("Opens the clipboard history");
        enabled: root.history;

        ShortcutField {
            width: 150px;
            text: root.shortcut;
            label: @tr("Clipboard shortcut");
            enabled: root.history;
            recording <=> root.recording;
            started => {
                root.shortcut-error = "";
                root.recording-started();
            }
            cancelled => { root.recording-cancelled(); }
        }
    }

    if root.shortcut-error != "": RowError {
        text: root.shortcut-error;
    }

    RowSeparator { }

    // Clearing has no Undo, so it asks first, in its own row.
    SettingRow {
        label: @tr("Clear history");
        description: @tr("Pinned copies stay");

        if !root.confirming: RowButton {
            label: @tr("Clear…");
            name: @tr("Clear history");
            clicked => { root.confirming = true; }
        }

        if root.confirming: HorizontalLayout {
            spacing: 6px;

            RowButton {
                layout-order: Theme.rtl ? 2 : 0;
                label: @tr("Cancel");
                clicked => { root.confirming = false; }
            }

            RowButton {
                layout-order: Theme.rtl ? 1 : 0;
                label: @tr("Clear");
                name: @tr("Clear history");
                danger: true;
                clicked => {
                    root.confirming = false;
                    root.history-cleared();
                }
            }
        }
    }
}

export component GeneralPage inherits VerticalLayout {
    // The languages by name, "Automatic" first, and the one in use.
    in property <[string]> language-names;
    in property <int> language;
    // 0 System, 1 Light, 2 Dark.
    in property <int> appearance;
    // The themes by name, and the one in use.
    in property <[string]> theme-names;
    in property <int> theme;
    // 0 Control, 1 Option, 2 Shift, 3 Command, called by `trigger-names`:
    // the Mac's names on a Mac, the platform's elsewhere.
    in property <[string]> trigger-names;
    in property <int> trigger;
    // A shake during a file drag opens the wheel too.
    in property <bool> shake-to-open;
    in property <[string]> terminals;
    in property <int> terminal;
