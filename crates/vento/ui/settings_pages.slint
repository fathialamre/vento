// The Settings window's pages, one per feature: the controls each page
// shows and the callbacks they ask for changes through. The window
// (`settings_window.slint`) lays them out and passes the settings in.

import { LineText, Theme } from "theme.slint";
import { Icons } from "wheel.slint";
import {
    PanelIcons, Separator, Switch, Segmented, MenuField, TextButton, IconButton, Stepper,
    ShortcutField, ReorderRow, DragGrip, WrapText, Group, GroupHeading, SettingRow, RowButton,
} from "controls.slint";

// One action in the Wheel page's list, shown on the wheel or not.
export struct ActionRow { icon: image, label: string, shown: bool }

// One folder in the Move page: its Finder icon (when `has-icon`), its name,
// where it is (its parent folder, the home folder as ~) and whether it is
// missing on disk.
export struct FolderRow { icon: image, has-icon: bool, name: string, place: string, missing: bool }

// Why the settings file was not loaded.
export component Notice inherits Rectangle {
    in property <string> text;

    border-radius: 8px;
    background: Theme.surface;

    HorizontalLayout {
        padding: 8px;
        spacing: 8px;

        VerticalLayout {
            layout-order: Theme.rtl ? 2 : 0;
            alignment: start;

            Image {
                source: Icons.missing;
                width: 14px;
                height: 14px;
                colorize: Theme.danger;
            }
        }

        Text {
            layout-order: Theme.rtl ? 1 : 0;
            horizontal-alignment: Theme.rtl ? right : left;
            text: root.text;
            font-size: 12px;
            color: Theme.text;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }
    }
}

// How to use a page's feature, below its settings: a header that opens and
// closes it, and while open the steps, numbered. It shows `open` as given
// and asks for the other state when clicked; the window keeps it.
export component HowTo inherits Rectangle {
    in property <[string]> steps;
    in property <bool> open;
    callback toggled(bool);

    border-radius: 10px;
    background: Theme.card;

    VerticalLayout {
        padding: 12px;
        spacing: 8px;

        header := Rectangle {
            height: 18px;
            accessible-role: button;
            accessible-label: @tr("How to use");
            accessible-expandable: true;
            accessible-expanded: root.open;
            accessible-action-default => { root.toggled(!root.open); }
            accessible-action-expand => { root.toggled(!root.open); }

            HorizontalLayout {
                spacing: 8px;

                VerticalLayout {
                    layout-order: Theme.rtl ? 3 : 0;
                    alignment: center;

                    Image {
                        source: Icons.info;
                        width: 14px;
                        height: 14px;
                        colorize: Theme.accent;
                    }
                }

                Text {
                    layout-order: Theme.rtl ? 2 : 0;
                    horizontal-alignment: Theme.rtl ? right : left;
                    text: @tr("How to use");
                    font-size: 13px;
                    font-weight: 600;
                    color: Theme.text;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                // Points down while open, else to where the line reads on.
                VerticalLayout {
                    layout-order: Theme.rtl ? 1 : 0;
                    alignment: center;

                    Image {
                        source: root.open ? PanelIcons.open-down : Theme.rtl ? Icons.back : Icons.back-rtl;
                        width: 14px;
                        height: 14px;
                        colorize: Theme.muted;
                    }
                }
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.toggled(!root.open); }
            }
        }

        if root.open: VerticalLayout {
            spacing: 6px;

            for step[i] in root.steps: HorizontalLayout {
                spacing: 8px;

                VerticalLayout {
                    layout-order: Theme.rtl ? 2 : 0;
                    alignment: start;

                    Rectangle {
                        width: 18px;
                        height: 18px;
                        border-radius: self.height / 2;
                        background: Theme.accent-soft;

                        Text {
                            text: i + 1;
                            font-size: 11px;
                            font-weight: 600;
                            color: Theme.accent;
                        }
                    }
                }

                WrapText {
                    layout-order: Theme.rtl ? 1 : 0;
                    text: step;
                    font-size: 12px;
                    color: Theme.text;
                    horizontal-stretch: 1;
                }
            }
        }
    }
}

// The wheel's actions, one row each: a grip to drag the row into a new
// place, the action's icon and name, and a switch to show or hide it.
// While a row is dragged it follows the pointer and the rows it passes
// make room; it drops at the row nearest to where it was let go. The shown
// rows come first and a row stays among its own kind (switching it on or
// off moves it between them).
component ActionList inherits Rectangle {
    in property <[ActionRow]> rows;
    // How many of the rows are shown on the wheel (they come first).
    in property <int> shown-count;
    callback toggled(int, bool);
    callback moved(int, int);

    property <length> row-h: 34px;
    // The row being dragged (-1 for none), how far it has moved, the first
    // and last place it can go, and the place it would drop at now.
    property <int> drag-from: -1;
    property <length> drag-offset;
    property <int> drag-lo: self.drag-from < self.shown-count ? 0 : self.shown-count;
    property <int> drag-hi: self.drag-from < self.shown-count
        ? self.shown-count - 1
        : self.rows.length - 1;
    property <int> drag-to: self.drag-from < 0
        ? -1
        : clamp(self.drag-from + round(self.drag-offset / self.row-h), self.drag-lo, self.drag-hi);

    height: self.rows.length * self.row-h;

    for row[i] in root.rows: ReorderRow {
        index: i;
        drag-from: root.drag-from;
        drag-to: root.drag-to;
        drag-offset: root.drag-offset;
        row-h: root.row-h;
        width: root.width;
        accessible-role: list-item;
        accessible-label: row.label;

        HorizontalLayout {
            padding-left: Theme.rtl ? 6px : 2px;
            padding-right: Theme.rtl ? 2px : 6px;
            spacing: 8px;

            DragGrip {
                layout-order: Theme.rtl ? 4 : 0;
                index: i;
                row-h: root.row-h;
                lo: root.drag-lo;
                hi: root.drag-hi;
                drop-to: root.drag-to;
                drag-from <=> root.drag-from;
                drag-offset <=> root.drag-offset;
                moved(from, to) => { root.moved(from, to); }
            }

            VerticalLayout {
                layout-order: Theme.rtl ? 3 : 0;
                alignment: center;

                Image {
                    source: row.icon;
                    width: 16px;
                    height: 16px;
                    colorize: row.shown ? Theme.text : Theme.muted;
                }
            }

            Text {
                layout-order: Theme.rtl ? 2 : 0;
                horizontal-alignment: Theme.rtl ? right : left;
                text: row.label;
                font-size: 13px;
                color: row.shown ? Theme.text : Theme.muted;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            VerticalLayout {
                layout-order: Theme.rtl ? 1 : 0;
                alignment: center;

                Switch {
                    on: row.shown;
                    label: row.label;
                    toggled(on) => { root.toggled(i, on); }
                }
            }
        }
    }
}

export component WheelPage inherits VerticalLayout {
    // 0 Honeycomb, 1 Petals.
    in property <int> wheel-layout;
    in property <[ActionRow]> actions;
    in property <int> shown-actions;
    callback layout-chosen(int);
    callback action-toggled(int, bool);
    callback action-moved(int, int);

    spacing: 8px;

    Group {
        SettingRow {
            label: @tr("Layout");
            description: @tr("How the actions sit around the pointer");

            Segmented {
                width: 180px;
                items: [@tr("Honeycomb"), @tr("Petals")];
                current: root.wheel-layout;
                chosen(i) => { root.layout-chosen(i); }
            }
        }
    }

    GroupHeading {
        text: @tr("Actions");

        Text {
            text: @tr("Drag to reorder");
            font-size: 11px;
            color: Theme.muted;
            vertical-alignment: center;
        }
    }

    Group {
        VerticalLayout {
            padding-top: 4px;
            padding-bottom: 4px;

            ActionList {
                rows: root.actions;
                shown-count: root.shown-actions;
                toggled(i, on) => { root.action-toggled(i, on); }
                moved(from, to) => { root.action-moved(from, to); }
            }
        }
    }
}

// A folder's icon and name, with where it is after them in a dimmer
// colour; dimmed as a whole when the folder is missing.
component FolderLabel inherits HorizontalLayout {
    in property <FolderRow> folder;

    spacing: 8px;

    VerticalLayout {
        layout-order: Theme.rtl ? 3 : 0;
        alignment: center;

        if root.folder.has-icon: Image {
            source: root.folder.icon;
            width: 16px;
            height: 16px;
            opacity: root.folder.missing ? 0.4 : 1;
        }
        if !root.folder.has-icon: Image {
            source: PanelIcons.folder;
            width: 16px;
            height: 16px;
            colorize: Theme.muted;
            opacity: root.folder.missing ? 0.4 : 1;
        }
    }

    // The name keeps to its own width, up to half the narrowest page (the
    // window's least width leaves the page 340 px); where it is takes the
    // rest.
    LineText {
        layout-order: Theme.rtl ? 2 : 0;
        horizontal-alignment: Theme.rtl ? right : left;
        text: root.folder.name;
        font-size: 13px;
        color: root.folder.missing ? Theme.muted : Theme.text;
        vertical-alignment: center;
        horizontal-stretch: 0;
        max-width: 170px;
    }

    LineText {
        layout-order: Theme.rtl ? 1 : 0;
        horizontal-alignment: Theme.rtl ? right : left;
        text: root.folder.missing ? @tr("Missing") : root.folder.place;
        font-size: 11px;
        color: Theme.muted;
        vertical-alignment: center;
        horizontal-stretch: 1;
    }
}

// The pinned folders, in ring order: a grip to drag a row into a new
// place, the folder, and a button to unpin it.
component PinnedList inherits Rectangle {
    in property <[FolderRow]> rows;
    callback moved(int, int);
    callback unpinned(int);

    property <length> row-h: 34px;
    // The row being dragged (-1 for none), how far it has moved, and the
    // place it would drop at now.
    property <int> drag-from: -1;
    property <length> drag-offset;
    property <int> drag-to: self.drag-from < 0
        ? -1
        : clamp(self.drag-from + round(self.drag-offset / self.row-h), 0, self.rows.length - 1);

    height: self.rows.length * self.row-h;

    for row[i] in root.rows: ReorderRow {
        index: i;
        drag-from: root.drag-from;
        drag-to: root.drag-to;
        drag-offset: root.drag-offset;
        row-h: root.row-h;
        width: root.width;
        accessible-role: list-item;
        accessible-label: row.name;

        HorizontalLayout {
            padding-left: 2px;
            padding-right: 2px;
            spacing: 8px;

            DragGrip {
                layout-order: Theme.rtl ? 3 : 0;
                index: i;
                row-h: root.row-h;
                lo: 0;
                hi: root.rows.length - 1;
                drop-to: root.drag-to;
                drag-from <=> root.drag-from;
                drag-offset <=> root.drag-offset;
                moved(from, to) => { root.moved(from, to); }
            }

            FolderLabel {
                layout-order: Theme.rtl ? 2 : 0;
                folder: row;
                horizontal-stretch: 1;
            }

            VerticalLayout {
                layout-order: Theme.rtl ? 1 : 0;
                alignment: center;

                IconButton {
                    icon: Icons.remove;
                    label: @tr("Unpin {}", row.name);
                    clicked => { root.unpinned(i); }
                }
            }
        }
    }
}

// What a list with no rows shows instead.
component EmptyLine inherits Text {
    horizontal-alignment: Theme.rtl ? right : left;
    height: 30px;
    font-size: 12px;
    color: Theme.muted;
    vertical-alignment: center;
}

export component MovePage inherits VerticalLayout {
    in property <[FolderRow]> pinned;
    in property <bool> pinned-full;
    in property <[FolderRow]> recent;
    // The recent history holds folders, shown or not.
    in property <bool> has-history;
    in property <bool> can-pin;
    in property <string> hold;
    in property <bool> hold-can-decrease;
    in property <bool> hold-can-increase;
    callback add-folder();
    callback pinned-moved(int, int);
    callback unpinned(int);
    callback recent-pinned(int);
    callback recent-cleared();
    callback hold-stepped(int);

    spacing: 8px;

    GroupHeading {
        text: @tr("Pinned");

        TextButton {
            label: root.pinned-full ? @tr("Up to 7 folders") : @tr("Add folder");
            icon: PanelIcons.add;
            has-icon: !root.pinned-full;
            enabled: !root.pinned-full;
            clicked => { root.add-folder(); }
        }
    }

    Group {
        VerticalLayout {
            padding-top: 4px;
            padding-bottom: 4px;

            if root.pinned.length == 0: EmptyLine {
                text: @tr("No pinned folders");
            }

            if root.pinned.length > 0: PinnedList {
                rows: root.pinned;
                moved(from, to) => { root.pinned-moved(from, to); }
                unpinned(i) => { root.unpinned(i); }
            }
        }
    }

    GroupHeading {
        text: @tr("Recent");

        TextButton {
            label: @tr("Clear");
            enabled: root.has-history;
            clicked => { root.recent-cleared(); }
        }
    }

    Group {
        VerticalLayout {
            padding-top: 4px;
            padding-bottom: 4px;

            if root.recent.length == 0: EmptyLine {
                text: @tr("No recent folders");
            }

            for row[i] in root.recent: Rectangle {
                height: 30px;
                accessible-role: list-item;
                accessible-label: row.name;

                HorizontalLayout {
                    padding-left: 2px;
                    padding-right: 2px;
                    spacing: 8px;

                    FolderLabel {
                        layout-order: Theme.rtl ? 2 : 0;
                        folder: row;
                        horizontal-stretch: 1;
                    }

                    VerticalLayout {
                        layout-order: Theme.rtl ? 1 : 0;
                        alignment: center;

                        IconButton {
                            icon: Icons.pin;
                            label: @tr("Pin {}", row.name);
                            enabled: root.can-pin;
                            clicked => { root.recent-pinned(i); }
                        }
                    }
                }
            }
        }
    }

    Group {
        SettingRow {
            label: @tr("Hold on Move");
            description: @tr("How long to rest on Move, Copy to or Convert before its ring opens");

            Stepper {
                text: root.hold;
                label: @tr("Hold on Move");
                can-decrease: root.hold-can-decrease;
                can-increase: root.hold-can-increase;
                decrease => { root.hold-stepped(-1); }
                increase => { root.hold-stepped(1); }
            }
        }
    }
}

export component PocketPage inherits VerticalLayout {
    // The Pocket shortcut as symbols, and why the last one recorded was
    // refused (empty when it was not).
    in property <string> shortcut;
    in-out property <string> shortcut-error;
    in-out property <bool> recording;
    in property <bool> remove-after-drop;
    in property <bool> keep-copies;
    // 0 List, 1 Scroll, 2 Stacks.
    in property <int> pocket-layout;
    callback recording-started();
    callback recording-cancelled();
    callback remove-after-drop-toggled(bool);
    callback keep-copies-toggled(bool);
    callback pocket-layout-chosen(int);

    spacing: 8px;

    Group {
        SettingRow {
            label: @tr("Shortcut");
            description: @tr("Opens the island on the Pocket");

            ShortcutField {
                width: 150px;
                text: root.shortcut;
                label: @tr("Pocket shortcut");
                recording <=> root.recording;
                started => {
                    root.shortcut-error = "";
                    root.recording-started();
                }
                cancelled => { root.recording-cancelled(); }
            }
        }
    }

    if root.shortcut-error != "": Text {
        horizontal-alignment: Theme.rtl ? right : left;
        text: root.shortcut-error;
        font-size: 12px;
        color: Theme.danger;
        wrap: word-wrap;
    }

    Group {
        SettingRow {
            label: @tr("Remove after drag-out");
            description: @tr("An item leaves the Pocket once you drop it somewhere");

            Switch {
                label: @tr("Remove after drag-out");
                on: root.remove-after-drop;
                toggled(on) => { root.remove-after-drop-toggled(on); }
            }
        }

        Separator { }

        SettingRow {
            label: @tr("Keep a copy");
            description: @tr("Vento keeps its own copy of each file, not only a link to it");

            Switch {
                label: @tr("Keep a copy");
                on: root.keep-copies;
                toggled(on) => { root.keep-copies-toggled(on); }
            }
        }
    }

    Group {
        SettingRow {
            label: @tr("When it holds more than 8 items");

            MenuField {
                width: 130px;
                label: @tr("When it holds more than 8 items");
                items: [@tr("List"), @tr("Scroll"), @tr("Stacks")];
                current: root.pocket-layout;
                chosen(i) => { root.pocket-layout-chosen(i); }
            }
        }
    }
}

export component ClipboardPage inherits VerticalLayout {
    // The history records copies; while it does not, its shortcut is not
    // registered and its field cannot record.
    in property <bool> history;
    // The Clipboard shortcut as symbols, and why the last one recorded was
    // refused (empty when it was not).
    in property <string> shortcut;
    in-out property <string> shortcut-error;
    in-out property <bool> recording;
    callback history-toggled(bool);
    callback recording-started();
    callback recording-cancelled();
    callback history-cleared();

    // "Clear…" was clicked: the row asks to confirm.
    property <bool> confirming;

    spacing: 8px;

    Group {
        SettingRow {
            label: @tr("Clipboard history");
            description: @tr("Remember what you copy");

            Switch {
                label: @tr("Clipboard history");
                on: root.history;
                toggled(on) => { root.history-toggled(on); }
            }
        }

        Separator { }

        SettingRow {
            label: @tr("Shortcut");
            description: @tr("Opens the clipboard history");
            enabled: root.history;

            ShortcutField {
                width: 150px;
                text: root.shortcut;
                label: @tr("Clipboard shortcut");
                enabled: root.history;
                recording <=> root.recording;
                started => {
                    root.shortcut-error = "";
                    root.recording-started();
                }
                cancelled => { root.recording-cancelled(); }
            }
        }
    }

    if root.shortcut-error != "": Text {
        horizontal-alignment: Theme.rtl ? right : left;
        text: root.shortcut-error;
        font-size: 12px;
        color: Theme.danger;
        wrap: word-wrap;
    }

    // Clearing has no Undo, so it asks first, in its own row.
    Group {
        SettingRow {
            label: @tr("Clear history");
            description: @tr("Pinned copies stay");

            if !root.confirming: RowButton {
                label: @tr("Clear…");
                name: @tr("Clear history");
                clicked => { root.confirming = true; }
            }

            if root.confirming: HorizontalLayout {
                spacing: 6px;

                RowButton {
                    layout-order: Theme.rtl ? 2 : 0;
                    label: @tr("Cancel");
                    clicked => { root.confirming = false; }
                }

                RowButton {
                    layout-order: Theme.rtl ? 1 : 0;
                    label: @tr("Clear");
                    name: @tr("Clear history");
                    danger: true;
                    clicked => {
                        root.confirming = false;
                        root.history-cleared();
                    }
                }
            }
        }
    }
}

export component GeneralPage inherits VerticalLayout {
    // The languages by name, "Automatic" first, and the one in use.
    in property <[string]> language-names;
    in property <int> language;
    // 0 System, 1 Light, 2 Dark.
    in property <int> appearance;
    // The themes by name, and the one in use.
    in property <[string]> theme-names;
    in property <int> theme;
    // 0 Control, 1 Option, 2 Shift, 3 Command, called by `trigger-names`:
    // the Mac's names on a Mac, the platform's elsewhere.
    in property <[string]> trigger-names;
    in property <int> trigger;
    // A shake during a file drag opens the wheel too.
    in property <bool> shake-to-open;
    in property <[string]> terminals;
    in property <int> terminal;
    // 0 Plain, 1 Shell-quoted.
    in property <int> path-format;
    callback language-chosen(int);
    callback appearance-chosen(int);
    callback theme-chosen(int);
    callback trigger-chosen(int);
    callback shake-to-open-toggled(bool);
    callback terminal-chosen(int);
    callback path-format-chosen(int);

    spacing: 8px;

    Group {
        SettingRow {
            label: @tr("Language");

            MenuField {
                width: 210px;
                label: @tr("Language");
                items: root.language-names;
                current: root.language;
                chosen(i) => { root.language-chosen(i); }
            }
        }

        Separator { }

        SettingRow {
            label: @tr("Appearance");

            Segmented {
                width: 210px;
                items: [@tr("System"), @tr("Light"), @tr("Dark")];
                current: root.appearance;
                chosen(i) => { root.appearance-chosen(i); }
            }
        }

        Separator { }

        SettingRow {
            label: @tr("Theme");
            description: @tr("Colours of the Quick panel and this window");

            MenuField {
                width: 210px;
                label: @tr("Theme");
                items: root.theme-names;
                current: root.theme;
                chosen(i) => { root.theme-chosen(i); }
            }
        }
    }

    Group {
        SettingRow {
            label: @tr("Trigger");
            description: @tr("Press it while dragging a file to open the wheel");

            MenuField {
                width: 210px;
                label: @tr("Trigger");
                items: root.trigger-names;
                current: root.trigger;
                chosen(i) => { root.trigger-chosen(i); }
            }
        }

        Separator { }

        SettingRow {
            label: @tr("Shake to open");
            description: @tr("Shake the pointer while dragging to open the wheel");

            Switch {
                label: @tr("Shake to open");
                on: root.shake-to-open;
                toggled(on) => { root.shake-to-open-toggled(on); }
            }
        }
    }

    Group {
        SettingRow {
            label: @tr("Terminal");
            description: @tr("Where the Terminal action opens");

            MenuField {
                width: 210px;
                label: @tr("Terminal");
                items: root.terminals;
                current: root.terminal;
                chosen(i) => { root.terminal-chosen(i); }
            }
        }

        Separator { }

        SettingRow {
            label: @tr("Copy path");
            description: @tr("How Copy path writes the path");

            MenuField {
                width: 210px;
                label: @tr("Copy path");
                items: [@tr("Plain"), @tr("Shell-quoted")];
                current: root.path-format;
                chosen(i) => { root.path-format-chosen(i); }
            }
        }
    }
}

// Shown only where this computer can read text from the screen.
export component CopyFromScreenPage inherits VerticalLayout {
    // The Copy from screen shortcut as symbols, and why the last one
    // recorded was refused (empty when it was not).
    in property <string> shortcut;
    in-out property <string> shortcut-error;
    in-out property <bool> recording;
    callback recording-started();
    callback recording-cancelled();

    spacing: 8px;

    Group {
        SettingRow {
            label: @tr("Shortcut");
            description: @tr("Dims the screen so you can pick the text to copy");

            ShortcutField {
                width: 150px;
                text: root.shortcut;
                label: @tr("Copy from screen shortcut");
                recording <=> root.recording;
                started => {
                    root.shortcut-error = "";
                    root.recording-started();
                }
                cancelled => { root.recording-cancelled(); }
            }
        }
    }

    if root.shortcut-error != "": Text {
        horizontal-alignment: Theme.rtl ? right : left;
        text: root.shortcut-error;
        font-size: 12px;
        color: Theme.danger;
        wrap: word-wrap;
    }
}

// Keep Awake's one option; starting and stopping it is the panel's.
export component KeepAwakePage inherits VerticalLayout {
    in property <bool> screen-off;
    callback screen-off-toggled(bool);

    spacing: 8px;

    Group {
        SettingRow {
            label: @tr("Let the screen turn off");
            description: @tr("Only the computer stays awake; the screen dims and locks as usual");

            Switch {
                label: @tr("Let the screen turn off");
                on: root.screen-off;
                toggled(on) => { root.screen-off-toggled(on); }
            }
        }
    }
}

export component AboutPage inherits VerticalLayout {
    // The running version, "0.2.0".
    in property <string> version;
    callback open-settings-file();
    // Opens the licences, on the web.
    callback open-licenses();

    spacing: 8px;

    VerticalLayout {
        padding-top: 4px;
        padding-bottom: 8px;
        spacing: 4px;

        HorizontalLayout {
            alignment: center;

            Image {
                source: @image-url("../../../brand/svg/app-icon.svg");
                width: 64px;
                height: 64px;
            }
        }

        Text {
            horizontal-alignment: center;
            text: "Vento";
            font-size: 15px;
            font-weight: 600;
            color: Theme.text;
        }

        Text {
            horizontal-alignment: center;
            text: @tr("Version {}", root.version);
            font-size: 12px;
            color: Theme.muted;
        }
    }

    Group {
        SettingRow {
            label: @tr("Settings file");

            RowButton {
                label: @tr("Open");
                name: @tr("Open settings file");
                clicked => { root.open-settings-file(); }
            }
        }

        Separator { }

        SettingRow {
            label: @tr("Licenses");

            RowButton {
                label: @tr("View");
                name: @tr("View licenses");
                clicked => { root.open-licenses(); }
            }
        }
    }

    WrapText {
        text: @tr("GPL-3.0-only. Wheel icons are from Tabler Icons 3.49.0, MIT-licensed.");
        font-size: 11px;
        color: Theme.muted;
    }
}
