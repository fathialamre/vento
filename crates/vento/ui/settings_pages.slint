// The Settings window's pages, one per feature: the controls each page
// shows and the callbacks they ask for changes through. The window
// (`settings_window.slint`) lays them out and passes the settings in.

import { LineText, Theme, ThemeColors } from "theme.slint";
import { Icons } from "wheel.slint";
import {
    PanelIcons, RowSeparator, Switch, Segmented, MenuField, TextButton, IconButton, Stepper,
    ShortcutField, ReorderRow, DragGrip, WrapText, SettingRow, RowBody, RowError, RowButton, Chip,
    Slider,
} from "controls.slint";

// One action in the Wheel page's list, shown on the wheel or not.
export struct ActionRow { icon: image, label: string, shown: bool }

// One folder in the Move page: its Finder icon (when `has-icon`), its name,
// where it is (its parent folder, the home folder as ~) and whether it is
// missing on disk.
export struct FolderRow { icon: image, has-icon: bool, name: string, place: string, missing: bool }

// Why the settings file was not loaded.
export component Notice inherits Rectangle {
    in property <string> text;

    border-radius: 8px;
    background: Theme.surface;

    HorizontalLayout {
        padding: 8px;
        spacing: 8px;

        VerticalLayout {
            layout-order: Theme.rtl ? 2 : 0;
            alignment: start;

            Image {
                source: Icons.missing;
                width: 14px;
                height: 14px;
                colorize: Theme.danger;
            }
        }

        Text {
            layout-order: Theme.rtl ? 1 : 0;
            horizontal-alignment: Theme.rtl ? right : left;
            text: root.text;
            font-size: 12px;
            color: Theme.text;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }
    }
}

// How to use a page's feature, the last row of its panel: a header that
// opens and closes it, and while open the steps, numbered. It shows `open`
// as given and asks for the other state when clicked; the window keeps it.
export component HowTo inherits Rectangle {
    in property <[string]> steps;
    in property <bool> open;
    callback toggled(bool);

    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 14px;
        padding-bottom: 14px;
        spacing: 10px;

        header := Rectangle {
            height: 18px;
            accessible-role: button;
            accessible-label: @tr("How to use");
            accessible-expandable: true;
            accessible-expanded: root.open;
            accessible-action-default => { root.toggled(!root.open); }
            accessible-action-expand => { root.toggled(!root.open); }

            HorizontalLayout {
                spacing: 8px;

                VerticalLayout {
                    layout-order: Theme.rtl ? 3 : 0;
                    alignment: center;

                    Image {
                        source: Icons.info;
                        width: 14px;
                        height: 14px;
                        colorize: Theme.accent;
                    }
                }

                Text {
                    layout-order: Theme.rtl ? 2 : 0;
                    horizontal-alignment: Theme.rtl ? right : left;
                    text: @tr("How to use");
                    font-size: 13px;
                    font-weight: 500;
                    color: Theme.text;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                // Points down while open, else to where the line reads on.
                VerticalLayout {
                    layout-order: Theme.rtl ? 1 : 0;
                    alignment: center;

                    Image {
                        source: root.open ? PanelIcons.open-down : Theme.rtl ? Icons.back : Icons.back-rtl;
                        width: 14px;
                        height: 14px;
                        colorize: Theme.muted;
                    }
                }
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.toggled(!root.open); }
            }
        }

        if root.open: VerticalLayout {
            spacing: 6px;

            for step[i] in root.steps: HorizontalLayout {
                spacing: 8px;

                VerticalLayout {
                    layout-order: Theme.rtl ? 2 : 0;
                    alignment: start;

                    Rectangle {
                        width: 18px;
                        height: 18px;
                        border-radius: self.height / 2;
                        background: Theme.accent-soft;

                        Text {
                            text: i + 1;
                            font-size: 11px;
                            font-weight: 600;
                            color: Theme.accent;
                        }
                    }
                }

                WrapText {
                    layout-order: Theme.rtl ? 1 : 0;
                    text: step;
                    font-size: 12px;
                    color: Theme.text;
                    horizontal-stretch: 1;
                }
            }
        }
    }
}

// A small picture of a window in one look of a theme: its sidebar, and a
// title in the accent over two lines of text.
component LookPicture inherits Rectangle {
    in property <ThemeColors> look;

    // The sidebar's width, and where the text starts and how wide it runs.
    property <length> side: self.width * 0.3;
    property <length> text-x: Theme.rtl ? 6px : self.side + 6px;
    property <length> text-w: self.width - self.side - 12px;

    background: root.look.bg;

    Rectangle {
        x: Theme.rtl ? root.width - root.side : 0px;
        width: root.side;
        background: root.look.card;
    }

    for line[i] in [0.6, 0.85, 0.7]: Rectangle {
        x: Theme.rtl ? root.text-x + root.text-w * (1 - line) : root.text-x;
        y: i == 0 ? 6px : 9px + i * 9px;
        width: root.text-w * line;
        height: i == 0 ? 7px : 5px;
        border-radius: 3px;
        background: i == 0 ? root.look.accent.transparentize(0.4) : root.look.muted.transparentize(0.6);
    }
}

// One look the Appearance setting can take, as a picture with its name
// under it, ringed in the accent while chosen. System shows the light and
// the dark side by side.
component LookTile inherits VerticalLayout {
    in property <string> label;
    in property <bool> chosen;
    // 0 System, 1 Light, 2 Dark, as the setting counts them.
    in property <int> kind;
    callback clicked();

    spacing: 6px;
    accessible-role: radio-button;
    accessible-label: self.label;
    accessible-checkable: true;
    accessible-checked: self.chosen;
    accessible-action-default => { self.clicked(); }

    Rectangle {
        height: 62px;
        border-radius: 10px;
        border-width: 2px;
        border-color: root.chosen ? Theme.accent : touch.has-hover ? Theme.panel-line : transparent;

        Rectangle {
            x: 4px;
            y: 4px;
            width: parent.width - 8px;
            height: parent.height - 8px;
            border-radius: 6px;
            clip: true;

            if root.kind != 0: LookPicture {
                width: parent.width;
                height: parent.height;
                look: Theme.look(Theme.palette, root.kind == 2);
            }

            // The light half first, where the line starts.
            if root.kind == 0: LookPicture {
                x: Theme.rtl ? parent.width / 2 : 0px;
                width: parent.width / 2;
                height: parent.height;
                look: Theme.look(Theme.palette, false);
            }
            if root.kind == 0: LookPicture {
                x: Theme.rtl ? 0px : parent.width / 2;
                width: parent.width / 2;
                height: parent.height;
                look: Theme.look(Theme.palette, true);
            }

            // Its edge, over the picture.
            Rectangle {
                border-radius: 6px;
                border-width: 1px;
                border-color: #8080802e;
            }
        }

        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.clicked(); }
        }
    }

    Text {
        horizontal-alignment: center;
        text: root.label;
        font-size: 12px;
        font-weight: root.chosen ? 500 : 400;
        color: root.chosen ? Theme.text : Theme.muted;
    }
}

// The Appearance setting's three looks, side by side.
component LookPicker inherits HorizontalLayout {
    // 0 System, 1 Light, 2 Dark.
    in property <int> current;
    callback chosen(int);

    spacing: 10px;
    accessible-role: radio-group;
    accessible-label: @tr("Appearance");

    LookTile {
        layout-order: Theme.rtl ? 3 : 0;
        kind: 1;
        label: @tr("Light");
        chosen: root.current == 1;
        clicked => { root.chosen(1); }
    }

    LookTile {
        layout-order: Theme.rtl ? 2 : 0;
        kind: 2;
        label: @tr("Dark");
        chosen: root.current == 2;
        clicked => { root.chosen(2); }
    }

    LookTile {
        layout-order: Theme.rtl ? 1 : 0;
        kind: 0;
        label: @tr("System");
        chosen: root.current == 0;
        clicked => { root.chosen(0); }
    }
}

// The themes, each a dot in its accent over its name, the chosen one
// ringed in the accent: one row where the page is wide enough, else rows
// of four.
component ThemePicker inherits Rectangle {
    in property <[string]> names;
    in property <int> current;
    callback chosen(int);

    property <length> gap: 4px;
    property <int> columns: (self.width - 6 * self.gap) / 7 >= 60px ? 7 : 4;
    property <length> cell-w: (self.width - (self.columns - 1) * self.gap) / self.columns;
    property <length> cell-h: 50px;

    height: ceil(self.names.length / self.columns) * (self.cell-h + self.gap) - self.gap;
    accessible-role: radio-group;
    accessible-label: @tr("Theme");

    for name[i] in root.names: Rectangle {
        property <bool> on: i == root.current;
        property <int> column: mod(i, root.columns);

        x: (Theme.rtl ? root.columns - 1 - self.column : self.column) * (root.cell-w + root.gap);
        y: floor(i / root.columns) * (root.cell-h + root.gap);
        width: root.cell-w;
        height: root.cell-h;
        border-radius: 8px;
        border-width: self.on ? 1.5px : 0px;
        border-color: Theme.accent;
        background: !self.on && touch.has-hover ? Theme.field : transparent;
        accessible-role: radio-button;
        accessible-label: name;
        accessible-checkable: true;
        accessible-checked: self.on;
        accessible-action-default => { root.chosen(i); }

        Rectangle {
            y: 8px;
            width: 16px;
            height: 16px;
            border-radius: 8px;
            background: Theme.look(i, Theme.dark).accent;
        }

        LineText {
            x: 2px;
            y: 30px;
            width: parent.width - 4px;
            horizontal-alignment: center;
            text: name;
            font-size: 11px;
            font-weight: parent.on ? 500 : 400;
            color: parent.on ? Theme.text : Theme.muted;
        }

        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.chosen(i); }
        }
    }
}

// The wheel's actions, one row each: a grip to drag the row into a new
// place, the action's icon and name, and a switch to show or hide it.
// While a row is dragged it follows the pointer and the rows it passes
// make room; it drops at the row nearest to where it was let go. The shown
// rows come first and a row stays among its own kind (switching it on or
// off moves it between them).
component ActionList inherits Rectangle {
    in property <[ActionRow]> rows;
    // How many of the rows are shown on the wheel (they come first).
    in property <int> shown-count;
    callback toggled(int, bool);
    callback moved(int, int);

    property <length> row-h: 34px;
    // The row being dragged (-1 for none), how far it has moved, the first
    // and last place it can go, and the place it would drop at now.
    property <int> drag-from: -1;
    property <length> drag-offset;
    property <int> drag-lo: self.drag-from < self.shown-count ? 0 : self.shown-count;
    property <int> drag-hi: self.drag-from < self.shown-count
        ? self.shown-count - 1
        : self.rows.length - 1;
    property <int> drag-to: self.drag-from < 0
        ? -1
        : clamp(self.drag-from + round(self.drag-offset / self.row-h), self.drag-lo, self.drag-hi);

    height: self.rows.length * self.row-h;

    for row[i] in root.rows: ReorderRow {
        index: i;
        drag-from: root.drag-from;
        drag-to: root.drag-to;
        drag-offset: root.drag-offset;
        row-h: root.row-h;
        width: root.width;
        accessible-role: list-item;
        accessible-label: row.label;

        HorizontalLayout {
            padding-left: Theme.rtl ? 6px : 2px;
            padding-right: Theme.rtl ? 2px : 6px;
            spacing: 8px;

            DragGrip {
                layout-order: Theme.rtl ? 4 : 0;
                index: i;
                row-h: root.row-h;
                lo: root.drag-lo;
                hi: root.drag-hi;
                drop-to: root.drag-to;
                drag-from <=> root.drag-from;
                drag-offset <=> root.drag-offset;
                moved(from, to) => { root.moved(from, to); }
            }

            VerticalLayout {
                layout-order: Theme.rtl ? 3 : 0;
                alignment: center;

                Image {
                    source: row.icon;
                    width: 16px;
                    height: 16px;
                    colorize: row.shown ? Theme.text : Theme.muted;
                }
            }

            Text {
                layout-order: Theme.rtl ? 2 : 0;
                horizontal-alignment: Theme.rtl ? right : left;
                text: row.label;
                font-size: 13px;
                color: row.shown ? Theme.text : Theme.muted;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            VerticalLayout {
                layout-order: Theme.rtl ? 1 : 0;
                alignment: center;

                Switch {
                    on: row.shown;
                    label: row.label;
                    toggled(on) => { root.toggled(i, on); }
                }
            }
        }
    }
}

export component WheelPage inherits VerticalLayout {
    // 0 Honeycomb, 1 Petals.
    in property <int> wheel-layout;
    in property <[ActionRow]> actions;
    in property <int> shown-actions;
    callback layout-chosen(int);
    callback action-toggled(int, bool);
    callback action-moved(int, int);

    SettingRow {
        label: @tr("Layout");
        description: @tr("How the actions sit around the pointer");

        Segmented {
            width: 180px;
            items: [@tr("Honeycomb"), @tr("Petals")];
            current: root.wheel-layout;
            chosen(i) => { root.layout-chosen(i); }
        }
    }

    RowSeparator { }

    SettingRow {
        label: @tr("Actions");
        description: @tr("Drag to reorder");
        padding-bottom: 6px;
    }

    RowBody {
        padding-left: 10px;
        padding-right: 10px;
        padding-bottom: 6px;

        ActionList {
            rows: root.actions;
            shown-count: root.shown-actions;
            toggled(i, on) => { root.action-toggled(i, on); }
            moved(from, to) => { root.action-moved(from, to); }
        }
    }
}

// A folder's icon and name, with where it is after them in a dimmer
// colour; dimmed as a whole when the folder is missing.
component FolderLabel inherits HorizontalLayout {
    in property <FolderRow> folder;

    spacing: 8px;

    VerticalLayout {
        layout-order: Theme.rtl ? 3 : 0;
        alignment: center;

        if root.folder.has-icon: Image {
            source: root.folder.icon;
            width: 16px;
            height: 16px;
            opacity: root.folder.missing ? 0.4 : 1;
        }
        if !root.folder.has-icon: Image {
            source: PanelIcons.folder;
            width: 16px;
            height: 16px;
            colorize: Theme.muted;
            opacity: root.folder.missing ? 0.4 : 1;
        }
    }

    // The name keeps to its own width, up to half the narrowest page (the
    // window's least width leaves the page 340 px); where it is takes the
    // rest.
    LineText {
        layout-order: Theme.rtl ? 2 : 0;
        horizontal-alignment: Theme.rtl ? right : left;
        text: root.folder.name;
        font-size: 13px;
        color: root.folder.missing ? Theme.muted : Theme.text;
        vertical-alignment: center;
        horizontal-stretch: 0;
        max-width: 170px;
    }

    LineText {
        layout-order: Theme.rtl ? 1 : 0;
        horizontal-alignment: Theme.rtl ? right : left;
        text: root.folder.missing ? @tr("Missing") : root.folder.place;
        font-size: 11px;
        color: Theme.muted;
        vertical-alignment: center;
        horizontal-stretch: 1;
    }
}

// The pinned folders, in ring order: a grip to drag a row into a new
// place, the folder, and a button to unpin it.
component PinnedList inherits Rectangle {
    in property <[FolderRow]> rows;
    callback moved(int, int);
    callback unpinned(int);

    property <length> row-h: 34px;
    // The row being dragged (-1 for none), how far it has moved, and the
    // place it would drop at now.
    property <int> drag-from: -1;
    property <length> drag-offset;
    property <int> drag-to: self.drag-from < 0
        ? -1
        : clamp(self.drag-from + round(self.drag-offset / self.row-h), 0, self.rows.length - 1);

    height: self.rows.length * self.row-h;

    for row[i] in root.rows: ReorderRow {
        index: i;
        drag-from: root.drag-from;
        drag-to: root.drag-to;
        drag-offset: root.drag-offset;
        row-h: root.row-h;
        width: root.width;
        accessible-role: list-item;
        accessible-label: row.name;

        HorizontalLayout {
            padding-left: 2px;
            padding-right: 2px;
            spacing: 8px;

            DragGrip {
                layout-order: Theme.rtl ? 3 : 0;
                index: i;
                row-h: root.row-h;
                lo: 0;
                hi: root.rows.length - 1;
                drop-to: root.drag-to;
                drag-from <=> root.drag-from;
                drag-offset <=> root.drag-offset;
                moved(from, to) => { root.moved(from, to); }
            }

            FolderLabel {
                layout-order: Theme.rtl ? 2 : 0;
                folder: row;
                horizontal-stretch: 1;
            }

            VerticalLayout {
                layout-order: Theme.rtl ? 1 : 0;
                alignment: center;

                IconButton {
                    icon: Icons.remove;
                    label: @tr("Unpin {}", row.name);
                    clicked => { root.unpinned(i); }
                }
            }
        }
    }
}

// What a list with no rows shows instead.
component EmptyLine inherits Text {
    horizontal-alignment: Theme.rtl ? right : left;
    height: 30px;
    font-size: 12px;
    color: Theme.muted;
    vertical-alignment: center;
}

export component MovePage inherits VerticalLayout {
    in property <[FolderRow]> pinned;
    in property <bool> pinned-full;
    in property <[FolderRow]> recent;
    // The recent history holds folders, shown or not.
    in property <bool> has-history;
    in property <bool> can-pin;
    in property <string> hold;
    in property <bool> hold-can-decrease;
    in property <bool> hold-can-increase;
    callback add-folder();
    callback pinned-moved(int, int);
    callback unpinned(int);
    callback recent-pinned(int);
    callback recent-cleared();
    callback hold-stepped(int);

    SettingRow {
        label: @tr("Pinned");
        padding-bottom: 6px;

        TextButton {
            label: root.pinned-full ? @tr("Up to 7 folders") : @tr("Add folder");
            icon: PanelIcons.add;
            has-icon: !root.pinned-full;
            enabled: !root.pinned-full;
            clicked => { root.add-folder(); }
        }
    }

    RowBody {
        padding-left: 10px;
        padding-right: 10px;
        padding-bottom: 8px;

        if root.pinned.length == 0: EmptyLine {
            text: @tr("No pinned folders");
        }

        if root.pinned.length > 0: PinnedList {
            rows: root.pinned;
            moved(from, to) => { root.pinned-moved(from, to); }
            unpinned(i) => { root.unpinned(i); }
        }
    }

    RowSeparator { }

    SettingRow {
        label: @tr("Recent");
        padding-bottom: 6px;

        TextButton {
            label: @tr("Clear");
            enabled: root.has-history;
            clicked => { root.recent-cleared(); }
        }
    }

    RowBody {
        padding-left: 10px;
        padding-right: 10px;
        padding-bottom: 8px;

        if root.recent.length == 0: EmptyLine {
            text: @tr("No recent folders");
        }

        for row[i] in root.recent: Rectangle {
            height: 30px;
            accessible-role: list-item;
            accessible-label: row.name;

            HorizontalLayout {
                padding-left: 2px;
                padding-right: 2px;
                spacing: 8px;

                FolderLabel {
                    layout-order: Theme.rtl ? 2 : 0;
                    folder: row;
                    horizontal-stretch: 1;
                }

                VerticalLayout {
                    layout-order: Theme.rtl ? 1 : 0;
                    alignment: center;

                    IconButton {
                        icon: Icons.pin;
                        label: @tr("Pin {}", row.name);
                        enabled: root.can-pin;
                        clicked => { root.recent-pinned(i); }
                    }
                }
            }
        }
    }

    RowSeparator { }

    SettingRow {
        label: @tr("Hold on Move");
        description: @tr("How long to rest on Move, Copy to or Convert before its ring opens");

        Stepper {
            text: root.hold;
            label: @tr("Hold on Move");
            can-decrease: root.hold-can-decrease;
            can-increase: root.hold-can-increase;
            decrease => { root.hold-stepped(-1); }
            increase => { root.hold-stepped(1); }
        }
    }
}

export component PocketPage inherits VerticalLayout {
    // The Pocket shortcut as symbols, and why the last one recorded was
    // refused (empty when it was not).
    in property <string> shortcut;
    in-out property <string> shortcut-error;
    in-out property <bool> recording;
    in property <bool> remove-after-drop;
    in property <bool> keep-copies;
    // What the Pocket view opens on: 0 its kinds, 1 the list.
    in property <int> pocket-view;
    // Whether the virtual island can be chosen on the island's screen (it
    // has no notch, and the platform can place it), and whether it is.
    in property <bool> island-offered;
    in property <bool> island-virtual;
    // What the other island is called there: where it sits today.
    in property <string> classic-label;
    // Where the virtual island sits: 0 Left, 1 Centre, 2 Right.
    in property <int> island-place;
    // How solid it is while resting, in percent (100 = solid).
    in property <int> island-glass;
    callback recording-started();
    callback recording-cancelled();
    callback remove-after-drop-toggled(bool);
    callback keep-copies-toggled(bool);
    callback pocket-view-chosen(int);
    // 0 the virtual island, 1 the other one.
    callback island-mode-chosen(int);
    callback island-place-chosen(int);
    callback island-glass-changed(int);

    if root.island-offered: VerticalLayout {
        SettingRow {
            label: @tr("Island");
            description: @tr("Where the Pocket, Clipboard and Screenshots live on this screen");

            MenuField {
                width: 190px;
                label: @tr("Island");
                items: [@tr("Virtual island"), root.classic-label];
                current: root.island-virtual ? 0 : 1;
                chosen(i) => { root.island-mode-chosen(i); }
            }
        }

        if root.island-virtual: VerticalLayout {
            RowSeparator { }

            SettingRow {
                label: @tr("Place");
                description: @tr("Along the top edge; the corners stay free");

                Segmented {
                    width: 210px;
                    items: [@tr("Left"), @tr("Centre"), @tr("Right")];
                    current: root.island-place;
                    chosen(i) => { root.island-place-chosen(i); }
                }
            }

            RowSeparator { }

            SettingRow {
                label: @tr("Glass");
                description: @tr("How solid the island is while resting");
                padding-bottom: 6px;

                Text {
                    min-width: 40px;
                    text: @tr("{}%", root.island-glass);
                    font-size: 13px;
                    color: Theme.text;
                    horizontal-alignment: Theme.rtl ? left : right;
                    vertical-alignment: center;
                }
            }

            RowBody {
                HorizontalLayout {
                    spacing: 6px;

                    VerticalLayout {
                        layout-order: Theme.rtl ? 4 : 0;
                        alignment: center;
                        horizontal-stretch: 1;

                        // The bounds and step of the settings' Glass, and
                        // its presets below (`GLASS_*` in vento-core).
                        Slider {
                            minimum: 10;
                            maximum: 100;
                            step: 5;
                            value: root.island-glass;
                            label: @tr("Glass");
                            changed(v) => { root.island-glass-changed(round(v)); }
                        }
                    }

                    // The presets, from the most see-through.
                    Chip {
                        layout-order: Theme.rtl ? 3 : 0;
                        width: 64px;
                        label: @tr("Ghost");
                        chosen: root.island-glass == 25;
                        clicked => { root.island-glass-changed(25); }
                    }

                    Chip {
                        layout-order: Theme.rtl ? 2 : 0;
                        width: 64px;
                        label: @tr("Glass");
                        chosen: root.island-glass == 55;
                        clicked => { root.island-glass-changed(55); }
                    }

                    Chip {
                        layout-order: Theme.rtl ? 1 : 0;
                        width: 64px;
                        label: @tr("Solid");
                        chosen: root.island-glass == 100;
                        clicked => { root.island-glass-changed(100); }
                    }
                }
            }
        }

        RowSeparator { }
    }

    SettingRow {
        label: @tr("Shortcut");
        description: @tr("Opens the island on the Pocket");

        ShortcutField {
            width: 150px;
            text: root.shortcut;
            label: @tr("Pocket shortcut");
            recording <=> root.recording;
            started => {
                root.shortcut-error = "";
                root.recording-started();
            }
            cancelled => { root.recording-cancelled(); }
        }
    }

    if root.shortcut-error != "": RowError {
        text: root.shortcut-error;
    }

    RowSeparator { }

    SettingRow {
        label: @tr("Remove after drag-out");
        description: @tr("An item leaves the Pocket once you drop it somewhere");

        Switch {
            label: @tr("Remove after drag-out");
            on: root.remove-after-drop;
            toggled(on) => { root.remove-after-drop-toggled(on); }
        }
    }

    RowSeparator { }

    SettingRow {
        label: @tr("Keep a copy");
        description: @tr("Vento keeps its own copy of each file, not only a link to it");

        Switch {
            label: @tr("Keep a copy");
            on: root.keep-copies;
            toggled(on) => { root.keep-copies-toggled(on); }
        }
    }

    RowSeparator { }

    SettingRow {
        label: @tr("When the Pocket opens, show");
        description: @tr("Its items by kind, or as a list; the bar under it switches between the two");

        MenuField {
            width: 130px;
            label: @tr("When the Pocket opens, show");
            items: [@tr("By kind"), @tr("List")];
            current: root.pocket-view;
            chosen(i) => { root.pocket-view-chosen(i); }
        }
    }
}

export component ClipboardPage inherits VerticalLayout {
    // The history records copies; while it does not, its shortcut is not
    // registered and its field cannot record.
    in property <bool> history;
    // The Clipboard shortcut as symbols, and why the last one recorded was
    // refused (empty when it was not).
    in property <string> shortcut;
    in-out property <string> shortcut-error;
    in-out property <bool> recording;
    callback history-toggled(bool);
    callback recording-started();
    callback recording-cancelled();
    callback history-cleared();

    // "Clear…" was clicked: the row asks to confirm.
    property <bool> confirming;

    SettingRow {
        label: @tr("Clipboard history");
        description: @tr("Remember what you copy");

        Switch {
            label: @tr("Clipboard history");
            on: root.history;
            toggled(on) => { root.history-toggled(on); }
        }
    }

    RowSeparator { }

    SettingRow {
        label: @tr("Shortcut");
        description: @tr("Opens the clipboard history");
        enabled: root.history;

        ShortcutField {
            width: 150px;
            text: root.shortcut;
            label: @tr("Clipboard shortcut");
            enabled: root.history;
            recording <=> root.recording;
            started => {
                root.shortcut-error = "";
                root.recording-started();
            }
            cancelled => { root.recording-cancelled(); }
        }
    }

    if root.shortcut-error != "": RowError {
        text: root.shortcut-error;
    }

    RowSeparator { }

    // Clearing has no Undo, so it asks first, in its own row.
    SettingRow {
        label: @tr("Clear history");
        description: @tr("Pinned copies stay");

        if !root.confirming: RowButton {
            label: @tr("Clear…");
            name: @tr("Clear history");
            clicked => { root.confirming = true; }
        }

        if root.confirming: HorizontalLayout {
            spacing: 6px;

            RowButton {
                layout-order: Theme.rtl ? 2 : 0;
                label: @tr("Cancel");
                clicked => { root.confirming = false; }
            }

            RowButton {
                layout-order: Theme.rtl ? 1 : 0;
                label: @tr("Clear");
                name: @tr("Clear history");
                danger: true;
                clicked => {
                    root.confirming = false;
                    root.history-cleared();
                }
            }
        }
    }
}

export component GeneralPage inherits VerticalLayout {
    // The languages by name, "Automatic" first, and the one in use.
    in property <[string]> language-names;
    in property <int> language;
    // 0 System, 1 Light, 2 Dark.
    in property <int> appearance;
    // The themes by name, and the one in use.
    in property <[string]> theme-names;
    in property <int> theme;
    // 0 Control, 1 Option, 2 Shift, 3 Command, called by `trigger-names`:
    // the Mac's names on a Mac, the platform's elsewhere.
    in property <[string]> trigger-names;
    in property <int> trigger;
    // A shake during a file drag opens the wheel too.
    in property <bool> shake-to-open;
    in property <[string]> terminals;
    in property <int> terminal;
    // 0 Plain, 1 Shell-quoted.
    in property <int> path-format;
    callback language-chosen(int);
    callback appearance-chosen(int);
    callback theme-chosen(int);
    callback trigger-chosen(int);
    callback shake-to-open-toggled(bool);
    callback terminal-chosen(int);
    callback path-format-chosen(int);

    SettingRow {
        label: @tr("Appearance");
        description: @tr("Light, dark, or as your system is set");
        padding-bottom: 10px;
    }

    RowBody {
        LookPicker {
            current: root.appearance;
            chosen(i) => { root.appearance-chosen(i); }
        }
    }

    RowSeparator { }

    SettingRow {
        label: @tr("Theme");
        description: @tr("Colours of the Quick panel and this window");
        padding-bottom: 10px;
    }

    RowBody {
        ThemePicker {
            names: root.theme-names;
            current: root.theme;
            chosen(i) => { root.theme-chosen(i); }
        }
    }

    RowSeparator { }

    SettingRow {
        label: @tr("Language");

        MenuField {
            width: 210px;
            label: @tr("Language");
            items: root.language-names;
            current: root.language;
            chosen(i) => { root.language-chosen(i); }
        }
    }

    RowSeparator { }

    SettingRow {
        label: @tr("Trigger");
        description: @tr("Press it while dragging a file to open the wheel");

        MenuField {
            width: 190px;
            label: @tr("Trigger");
            items: root.trigger-names;
            current: root.trigger;
            chosen(i) => { root.trigger-chosen(i); }
        }
    }

    RowSeparator { }

    SettingRow {
        label: @tr("Shake to open");
        description: @tr("Shake the pointer while dragging to open the wheel");

        Switch {
            label: @tr("Shake to open");
            on: root.shake-to-open;
            toggled(on) => { root.shake-to-open-toggled(on); }
        }
    }

    RowSeparator { }

    SettingRow {
        label: @tr("Terminal");
        description: @tr("Where the Terminal action opens");

        MenuField {
            width: 190px;
            label: @tr("Terminal");
            items: root.terminals;
            current: root.terminal;
            chosen(i) => { root.terminal-chosen(i); }
        }
    }

    RowSeparator { }

    SettingRow {
        label: @tr("Copy path");
        description: @tr("How Copy path writes the path");

        MenuField {
            width: 190px;
            label: @tr("Copy path");
            items: [@tr("Plain"), @tr("Shell-quoted")];
            current: root.path-format;
            chosen(i) => { root.path-format-chosen(i); }
        }
    }
}

// Shown only where this computer can read text from the screen.
export component CopyFromScreenPage inherits VerticalLayout {
    // The Copy from screen shortcut as symbols, and why the last one
    // recorded was refused (empty when it was not).
    in property <string> shortcut;
    in-out property <string> shortcut-error;
    in-out property <bool> recording;
    callback recording-started();
    callback recording-cancelled();

    SettingRow {
        label: @tr("Shortcut");
        description: @tr("Dims the screen so you can pick the text to copy");

        ShortcutField {
            width: 150px;
            text: root.shortcut;
            label: @tr("Copy from screen shortcut");
            recording <=> root.recording;
            started => {
                root.shortcut-error = "";
                root.recording-started();
            }
            cancelled => { root.recording-cancelled(); }
        }
    }

    if root.shortcut-error != "": RowError {
        text: root.shortcut-error;
    }
}

// The screenshots in the island: whether they show, the card for a new one,
// and the folder they come from.
export component ScreenshotsPage inherits VerticalLayout {
    in property <bool> on;
    // A card shows when a screenshot is saved, and for how long ("4 s").
    in property <bool> card-on;
    in property <string> card-secs;
    in property <bool> card-can-decrease;
    in property <bool> card-can-increase;
    // The folder vento watches, the file manager's name for the button
    // that shows it, and whether the system refuses to let vento read it.
    in property <string> folder;
    in property <string> reveal-label;
    in property <bool> denied;
    // On a Mac: the note about the floating thumbnail, and the button that
    // opens Privacy & Security.
    in property <bool> macos;
    callback toggled(bool);
    callback card-toggled(bool);
    callback card-stepped(int);
    callback show-folder();
    callback open-privacy();

    SettingRow {
        label: @tr("Show screenshots in the island");

        Switch {
            label: @tr("Show screenshots in the island");
            on: root.on;
            toggled(on) => { root.toggled(on); }
        }
    }

    RowSeparator { }

    SettingRow {
        label: @tr("Show a card when a screenshot is saved");
        enabled: root.on;

        Switch {
            label: @tr("Show a card when a screenshot is saved");
            on: root.card-on;
            enabled: root.on;
            toggled(on) => { root.card-toggled(on); }
        }
    }

    RowSeparator { }

    SettingRow {
        label: @tr("Card stays for");
        enabled: root.on && root.card-on;

        Stepper {
            text: root.card-secs;
            label: @tr("Card stays for");
            can-decrease: root.on && root.card-on && root.card-can-decrease;
            can-increase: root.on && root.card-on && root.card-can-increase;
            decrease => { root.card-stepped(-1); }
            increase => { root.card-stepped(1); }
        }
    }

    RowSeparator { }

    SettingRow {
        label: @tr("Folder");
        padding-bottom: 4px;

        RowButton {
            label: root.reveal-label;
            clicked => { root.show-folder(); }
        }
    }

    RowBody {
        LineText {
            horizontal-alignment: Theme.rtl ? right : left;
            vertical-alignment: center;
            text: root.folder;
            font-size: 12px;
            color: Theme.muted;
        }
    }

    if root.on && root.denied: RowError {
        text: @tr("Vento can't read this folder.");
    }

    if root.on && root.denied && root.macos: RowBody {
        HorizontalLayout {
            alignment: Theme.rtl ? end : start;

            RowButton {
                label: @tr("Open Privacy & Security");
                clicked => { root.open-privacy(); }
            }
        }
    }

    if root.macos: RowSeparator { }

    if root.macos: RowBody {
        padding-top: 12px;

        WrapText {
            text: @tr("macOS saves a screenshot about 5 seconds late while its floating thumbnail is on. To get the card at once, turn off Show Floating Thumbnail in the Screenshot app (⇧⌘5) → Options.");
            font-size: 12px;
            color: Theme.muted;
        }
    }
}

// Keep Awake's options: the panel's times, what the tile starts and the
// screen. Starting and stopping it is the panel's.
export component KeepAwakePage inherits VerticalLayout {
    in property <bool> screen-off;
    // The timed chips, as the panel shows them, and whether there are as
    // many as it holds or the usual ones.
    in property <[string]> times;
    in property <bool> times-full;
    in property <bool> times-usual;
    // The time Add adds and its stepper's limits; whether Add can add it.
    in property <string> new-time;
    in property <bool> new-can-decrease;
    in property <bool> new-can-increase;
    in property <bool> can-add;
    // What the tile can start, until stopped first, and which it starts.
    in property <[string]> start-names;
    in property <int> start-choice;
    callback screen-off-toggled(bool);
    callback time-removed(int);
    callback times-restored();
    callback new-stepped(int);
    callback time-added();
    callback start-chosen(int);

    SettingRow {
        label: @tr("Times in the panel");
        description: @tr("Shown under the Keep Awake tile, with Until stopped and Until…");
        padding-bottom: 6px;

        TextButton {
            label: @tr("Use the usual times");
            enabled: !root.times-usual;
            clicked => { root.times-restored(); }
        }
    }

    RowBody {
        padding-left: 10px;
        padding-right: 10px;
        padding-bottom: 8px;

        if root.times.length == 0: EmptyLine {
            text: @tr("No times");
        }

        for time[i] in root.times: Rectangle {
            height: 30px;
            accessible-role: list-item;
            accessible-label: time;

            HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                spacing: 8px;

                Text {
                    layout-order: Theme.rtl ? 2 : 0;
                    horizontal-alignment: Theme.rtl ? right : left;
                    text: time;
                    font-size: 13px;
                    color: Theme.text;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                VerticalLayout {
                    layout-order: Theme.rtl ? 1 : 0;
                    alignment: center;

                    IconButton {
                        icon: Icons.remove;
                        label: @tr("Remove {}", time);
                        clicked => { root.time-removed(i); }
                    }
                }
            }
        }

        // A new time: its stepper, then Add.
        HorizontalLayout {
            padding-top: 6px;
            padding-left: 6px;
            padding-right: 6px;
            spacing: 8px;
            alignment: Theme.rtl ? end : start;

            Stepper {
                layout-order: Theme.rtl ? 2 : 0;
                text: root.new-time;
                label: @tr("New time");
                can-decrease: root.new-can-decrease;
                can-increase: root.new-can-increase;
                decrease => { root.new-stepped(-1); }
                increase => { root.new-stepped(1); }
            }

            VerticalLayout {
                layout-order: Theme.rtl ? 1 : 0;
                alignment: center;

                TextButton {
                    label: root.times-full ? @tr("Up to 6 times") : @tr("Add");
                    icon: PanelIcons.add;
                    has-icon: !root.times-full;
                    enabled: root.can-add;
                    clicked => { root.time-added(); }
                }
            }
        }
    }

    RowSeparator { }

    SettingRow {
        label: @tr("The tile starts");
        description: @tr("What a click on the Keep Awake tile, or Start Keep Awake in the menu, starts");

        MenuField {
            width: 130px;
            label: @tr("The tile starts");
            items: root.start-names;
            current: root.start-choice;
            chosen(i) => { root.start-chosen(i); }
        }
    }

    RowSeparator { }

    SettingRow {
        label: @tr("Let the screen turn off");
        description: @tr("Only the computer stays awake; the screen dims and locks as usual");

        Switch {
            label: @tr("Let the screen turn off");
            on: root.screen-off;
            toggled(on) => { root.screen-off-toggled(on); }
        }
    }
}

// About's update row. `kind`: 0 up to date, 1 an update is out (Update, and
// a link to what is new), 2 downloading (a bar, and Cancel until the
// download is done), 3 ready (Restart), 4 restarting, 5 failed (red; Try
// again when `can-retry`), 6 the check failed, 7 a check is under way. Kinds
// 0 and 6 offer Check now. Text on the leading side, the button on the
// trailing one.
component UpdateStatusRow inherits HorizontalLayout {
    in property <int> kind;
    in property <string> title;
    in property <string> detail;
    in property <float> progress;
    in property <bool> can-retry;
    callback check-now();
    callback clicked();
    callback cancel-clicked();
    callback notes-clicked();
    callback retry-clicked();

    // Once the download is done there is nothing left to cancel.
    property <bool> cancellable: root.kind == 2 && root.progress < 1.0;

    min-height: 52px;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 12px;
    padding-bottom: 12px;
    spacing: 12px;

    VerticalLayout {
        layout-order: Theme.rtl ? 2 : 0;
        alignment: center;
        spacing: 2px;
        horizontal-stretch: 1;

        WrapText {
            text: root.title;
            font-size: 13px;
            font-weight: 500;
            color: root.kind == 5 || root.kind == 6 ? Theme.danger : Theme.text;
        }

        if root.kind == 1: HorizontalLayout {
            alignment: Theme.rtl ? end : start;

            Rectangle {
                width: link.preferred-width;
                height: link.preferred-height;
                accessible-role: button;
                accessible-label: link.text;
                accessible-action-default => { root.notes-clicked(); }

                link := Text {
                    text: @tr("See what's new");
                    font-size: 12px;
                    color: Theme.accent;
                }

                TouchArea {
                    clicked => { root.notes-clicked(); }
                }
            }
        }

        if root.kind == 2: Rectangle {
            height: 4px;
            border-radius: 2px;
            background: Theme.accent-soft;
            accessible-role: progress-indicator;
            accessible-value: Math.round(root.progress * 100) + "%";

            Rectangle {
                x: Theme.rtl ? parent.width - self.width : 0px;
                width: parent.width * Math.clamp(root.progress, 0, 1);
                height: parent.height;
                border-radius: parent.border-radius;
                background: Theme.accent;
            }
        }

        if root.detail != "": WrapText {
            text: root.detail;
            font-size: 12px;
            color: Theme.muted;
        }
    }

    VerticalLayout {
        layout-order: Theme.rtl ? 1 : 0;
        alignment: center;
        horizontal-stretch: 0;

        if root.kind == 0 || root.kind == 6: RowButton {
            label: @tr("Check now");
            name: @tr("Check for updates now");
            clicked => { root.check-now(); }
        }

        if root.kind == 7: RowButton {
            label: @tr("Checking\u{2026}");
            enabled: false;
        }

        if root.kind == 1: RowButton {
            label: @tr("Update");
            primary: true;
            clicked => { root.clicked(); }
        }

        if root.cancellable: RowButton {
            label: @tr("Cancel");
            clicked => { root.cancel-clicked(); }
        }

        if root.kind == 3: RowButton {
            label: @tr("Restart");
            primary: true;
            clicked => { root.clicked(); }
        }

        if root.kind == 5 && root.can-retry: RowButton {
            label: @tr("Try again");
            clicked => { root.retry-clicked(); }
        }
    }
}

export component AboutPage inherits VerticalLayout {
    // The running version, "0.2.0".
    in property <string> version;
    // Whether this platform updates itself: where it does not, the update
    // row and the automatic check are left out.
    in property <bool> updates-supported;
    // The update row (see `UpdateStatusRow`) and the automatic check.
    in property <int> update-kind;
    in property <string> update-title;
    in property <string> update-detail;
    in property <float> update-progress;
    in property <bool> update-can-retry;
    in property <bool> check-automatically;
    callback check-now();
    callback update-clicked();
    callback update-cancel-clicked();
    callback update-notes-clicked();
    callback update-retry-clicked();
    callback check-automatically-toggled(bool);
    // Opens the What's new window for the running version.
    callback open-whats-new();
    callback open-settings-file();
    // Opens the Welcome setup again.
    callback open-welcome();
    // Opens the licences, on the web.
    callback open-licenses();

    VerticalLayout {
        padding-top: 20px;
        padding-bottom: 16px;
        spacing: 4px;

        HorizontalLayout {
            alignment: center;

            Image {
                source: @image-url("../assets/app-icon.svg");
                width: 64px;
                height: 64px;
            }
        }

        Text {
            horizontal-alignment: center;
            text: "Vento";
            font-size: 15px;
            font-weight: 600;
            color: Theme.text;
        }

        Text {
            horizontal-alignment: center;
            text: @tr("Version {}", root.version);
            font-size: 12px;
            color: Theme.muted;
        }
    }

    RowSeparator { }

    if root.updates-supported: UpdateStatusRow {
        kind: root.update-kind;
        title: root.update-title;
        detail: root.update-detail;
        progress: root.update-progress;
        can-retry: root.update-can-retry;
        check-now => { root.check-now(); }
        clicked => { root.update-clicked(); }
        cancel-clicked => { root.update-cancel-clicked(); }
        notes-clicked => { root.update-notes-clicked(); }
        retry-clicked => { root.update-retry-clicked(); }
    }

    if root.updates-supported: RowSeparator { }

    if root.updates-supported: SettingRow {
        label: @tr("Check for updates automatically");
        description: @tr("Once a day, from GitHub");

        Switch {
            label: @tr("Check for updates automatically");
            on: root.check-automatically;
            toggled(on) => { root.check-automatically-toggled(on); }
        }
    }

    if root.updates-supported: RowSeparator { }

    SettingRow {
        label: @tr("What's new in {}", root.version);

        RowButton {
            label: @tr("View");
            name: @tr("View what's new");
            clicked => { root.open-whats-new(); }
        }
    }

    RowSeparator { }

    SettingRow {
        label: @tr("Settings file");

        RowButton {
            label: @tr("Open");
            name: @tr("Open settings file");
            clicked => { root.open-settings-file(); }
        }
    }

    RowSeparator { }

    SettingRow {
        label: @tr("Set up Vento again");

        RowButton {
            label: @tr("Open");
            name: @tr("Open the Welcome setup");
            clicked => { root.open-welcome(); }
        }
    }

    RowSeparator { }

    SettingRow {
        label: @tr("Licenses");

        RowButton {
            label: @tr("View");
            name: @tr("View licenses");
            clicked => { root.open-licenses(); }
        }
    }

    RowSeparator { }

    RowBody {
        padding-top: 12px;

        WrapText {
            text: @tr("GPL-3.0-only. Wheel icons are from Tabler Icons 3.49.0, MIT-licensed.");
            font-size: 11px;
            color: Theme.muted;
        }
    }
}
