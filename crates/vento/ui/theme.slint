// The windows' colours, dark or light as the Appearance setting says: with
// the system appearance (System), or always light or always dark. Orange is
// the accent in all; the wheel and the Pocket keep their own dark look.
// Under System, where the platform gives the colours of the desktop's own
// menus (GNOME Shell's theme), the panel takes its background, edge and
// text from them, is dark when they are, and makes its other greys as the
// shell does: its text, faint, over its background. Light and Dark use
// Vento's own colours.

import { Palette } from "std-widgets.slint";

export global Theme {
    in property <bool> system-colors: false;
    in property <bool> system-dark;
    in property <color> system-bg;
    in property <color> system-border;
    in property <color> system-text;

    // The Appearance setting: 0 System, 1 Light, 2 Dark.
    in property <int> appearance: 0;

    // Never written, so that System follows a system switch again after
    // Light or Dark.
    out property <bool> dark: root.appearance == 1 ? false : root.appearance == 2 ? true : (root.system-colors ? root.system-dark : Palette.color-scheme == ColorScheme.dark);

    // The desktop's menu colours apply under System alone.
    property <bool> use-system: root.system-colors && root.appearance == 0;

    // The system text at `amount` over the system background, opaque.
    pure function tint(amount: float) -> color {
        root.system-text.mix(root.system-bg, amount)
    }

    out property <color> bg: root.use-system ? root.system-bg : root.dark ? #1f1f22 : #f1f9fa;
    // A field or button at rest, and a flat control under the pointer (the
    // shell's hover).
    out property <color> surface: root.use-system ? root.tint(0.1) : root.dark ? #2b2b2f : #e2eaec;
    // A field or button under the pointer (the shell's pressed).
    out property <color> hover: root.use-system ? root.tint(0.15) : root.selected;
    // A raised card (a Quick panel tile, the Settings sidebar), a shade
    // lighter than `bg` with a hairline edge.
    out property <color> card: root.use-system ? root.tint(0.05) : root.dark ? #2b2b2f : #f6fbfc;
    out property <color> card-border: root.use-system ? root.tint(0.1) : root.dark ? #ffffff14 : #e4e9e9;
    // The chosen sidebar page or chip: the accent, faint.
    out property <color> accent-soft: root.dark ? #ff6a1a33 : #ff6a1a1f;
    // The chosen item of a segmented control, a dropdown's list, a row
    // being dragged: raised above `surface`.
    out property <color> selected: root.use-system ? (root.system-dark ? root.tint(0.2) : root.system-bg) : root.dark ? #3a3a40 : #ffffff;
    out property <color> text: root.use-system ? root.system-text : root.dark ? #f2f2f3 : #1d1d1f;
    out property <color> muted: root.use-system ? root.tint(0.6) : root.dark ? #9a9aa2 : #6e6e73;
    out property <color> separator: root.use-system ? root.tint(root.system-dark ? 0.1 : 0.15) : root.dark ? #ffffff14 : #0000000f;
    // The hairline around the panel and its arrow.
    out property <color> border: root.use-system ? root.system-border : root.dark ? #ffffff1f : #0000001a;
    out property <color> switch-off: root.use-system ? root.tint(0.22) : root.dark ? #4a4a50 : #c9c9ce;
    out property <color> danger: root.dark ? #ff7b72 : #d93a2f;
    out property <color> accent: #ff6a1a;
}
