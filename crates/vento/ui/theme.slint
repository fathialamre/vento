// The windows' colours, dark or light as the Appearance setting says: with
// the system appearance (System), or always light or always dark. The Quick
// panel and the Settings window take the Theme setting's colours and accent;
// the other windows keep Vento's tint and orange, and the wheel and the
// Pocket keep their own dark look.
// Under System, where the platform gives the colours of the desktop's own
// menus (GNOME Shell's theme), the panel takes its background, edge and
// text from them, is dark when they are, and makes its other greys as the
// shell does: its text, faint, over its background. Light and Dark use
// Vento's own colours.

import { Palette } from "std-widgets.slint";

// One theme's colours in one look (light or dark), as the Quick panel and
// the Settings window use them.
struct ThemeColors {
    bg: color,
    // Tiles and the sidebar.
    card: color,
    // A control's track or a field at rest.
    surface: color,
    // The chosen item of a control, raised above `surface`.
    selected: color,
    text: color,
    muted: color,
    // Hairlines and card edges.
    line: color,
    accent: color,
}

export global Theme {
    // Whether a line of text reads right to left on its own, from its first
    // strong letter (Rust answers, for every window): for `LineText`.
    pure callback text-is-rtl(string) -> bool;

    in property <bool> system-colors: false;
    in property <bool> system-dark;
    in property <color> system-bg;
    in property <color> system-border;
    in property <color> system-text;

    // The Appearance setting: 0 System, 1 Light, 2 Dark.
    in property <int> appearance: 0;
    // The Settings window's and the Quick panel's palette: a white (or
    // black) page with neutral greys, like a Mac window, instead of the
    // tint the other windows keep.
    in property <bool> clean: false;
    // The Theme setting, as `ThemeName::ALL` lists it: 0 Vento, 1 GitHub,
    // 2 Catppuccin, 3 Rosé Pine, 4 Tokyo Night, 5 Gruvbox, 6 Nord.
    in property <int> palette: 0;
    // Whether the interface language is written right to left (set by
    // `appearance::apply` from `i18n::current`).
    in property <bool> rtl: false;

    property <[ThemeColors]> lights: [
        { bg: #ffffff, card: #f5f5f7, surface: #f0f0f2, selected: #ffffff, text: #1d1d1f, muted: #6e6e73, line: #e5e5ea, accent: #ff6a1a },
        { bg: #ffffff, card: #f6f8fa, surface: #eef1f4, selected: #ffffff, text: #24292e, muted: #6a737d, line: #e1e4e8, accent: #0366d6 },
        { bg: #eff1f5, card: #e6e9ef, surface: #dce0e8, selected: #ffffff, text: #4c4f69, muted: #6c6f85, line: #ccd0da, accent: #8839ef },
        { bg: #faf4ed, card: #fffaf3, surface: #f2e9e1, selected: #fffaf3, text: #575279, muted: #797593, line: #dfdad9, accent: #907aa9 },
        { bg: #e1e2e7, card: #d5d6db, surface: #c8cbd9, selected: #e9e9ed, text: #3760bf, muted: #6172b0, line: #c4c8da, accent: #2e7de9 },
        { bg: #fbf1c7, card: #f2e5bc, surface: #ebdbb2, selected: #fbf1c7, text: #3c3836, muted: #665c54, line: #d5c4a1, accent: #427b58 },
        { bg: #eceff4, card: #e5e9f0, surface: #d8dee9, selected: #eceff4, text: #2e3440, muted: #4c566a, line: #d8dee9, accent: #5e81ac },
    ];
    property <[ThemeColors]> darks: [
        { bg: #000000, card: #1c1c1e, surface: #1c1c1e, selected: #3a3a3c, text: #f2f2f3, muted: #98989d, line: #2c2c2e, accent: #ff6a1a },
        { bg: #24292e, card: #1f2428, surface: #2f363d, selected: #444d56, text: #e1e4e8, muted: #959da5, line: #1b1f23, accent: #58a6ff },
        { bg: #1e1e2e, card: #181825, surface: #313244, selected: #45475a, text: #cdd6f4, muted: #a6adc8, line: #313244, accent: #cba6f7 },
        { bg: #191724, card: #1f1d2e, surface: #26233a, selected: #403d52, text: #e0def4, muted: #908caa, line: #26233a, accent: #c4a7e7 },
        { bg: #1a1b26, card: #16161e, surface: #292e42, selected: #3b4261, text: #c0caf5, muted: #787c99, line: #292e42, accent: #7aa2f7 },
        { bg: #282828, card: #32302f, surface: #3c3836, selected: #504945, text: #ebdbb2, muted: #a89984, line: #3c3836, accent: #8ec07c },
        { bg: #2e3440, card: #3b4252, surface: #434c5e, selected: #4c566a, text: #eceff4, muted: #9aa5b8, line: #3b4252, accent: #88c0d0 },
    ];

    // Never written, so that System follows a system switch again after
    // Light or Dark.
    out property <bool> dark: root.appearance == 1 ? false : root.appearance == 2 ? true : (root.system-colors ? root.system-dark : Palette.color-scheme == ColorScheme.dark);

    // The desktop's menu colours apply under System with the Vento theme
    // alone: a chosen theme wins over them.
    property <bool> use-system: root.system-colors && root.appearance == 0 && !(root.clean && root.palette != 0);
    property <bool> use-clean: root.clean && !root.use-system;
    property <ThemeColors> pal: root.dark ? root.darks[root.palette] : root.lights[root.palette];

    // The system text at `amount` over the system background, opaque.
    pure function tint(amount: float) -> color {
        root.system-text.mix(root.system-bg, amount)
    }

    out property <color> bg: root.use-system ? root.system-bg : root.use-clean ? root.pal.bg : root.dark ? #1f1f22 : #f1f9fa;
    // A field or button at rest, and a flat control under the pointer (the
    // shell's hover).
    out property <color> surface: root.use-system ? root.tint(0.1) : root.use-clean ? root.pal.surface : root.dark ? #2b2b2f : #e2eaec;
    // A field or button under the pointer (the shell's pressed).
    out property <color> hover: root.use-system ? root.tint(0.15) : root.use-clean ? (root.dark ? root.pal.surface.brighter(0.25) : root.pal.surface.darker(0.04)) : root.selected;
    // A raised card (a Quick panel tile, the Settings sidebar), a shade
    // lighter than `bg` with a hairline edge.
    out property <color> card: root.use-system ? root.tint(0.05) : root.use-clean ? root.pal.card : root.dark ? #2b2b2f : #f6fbfc;
    out property <color> card-border: root.use-system ? root.tint(0.1) : root.use-clean ? root.pal.line : root.dark ? #ffffff14 : #e4e9e9;
    // The chosen sidebar page or chip: the accent, faint.
    out property <color> accent-soft: root.use-clean ? root.accent.transparentize(root.dark ? 0.75 : 0.88) : root.dark ? #ff6a1a33 : #ff6a1a1f;
    // The chosen item of a segmented control, a dropdown's list, a row
    // being dragged: raised above `surface`.
    out property <color> selected: root.use-system ? (root.system-dark ? root.tint(0.2) : root.system-bg) : root.use-clean ? root.pal.selected : root.dark ? #3a3a40 : #ffffff;
    out property <color> text: root.use-system ? root.system-text : root.use-clean ? root.pal.text : root.dark ? #f2f2f3 : #1d1d1f;
    out property <color> muted: root.use-system ? root.tint(0.6) : root.use-clean ? root.pal.muted : root.dark ? #9a9aa2 : #6e6e73;
    out property <color> separator: root.use-system ? root.tint(root.system-dark ? 0.1 : 0.15) : root.use-clean ? root.pal.line : root.dark ? #ffffff14 : #0000000f;
    // The hairline around the panel and its arrow.
    out property <color> border: root.use-system ? root.system-border : root.dark ? #ffffff1f : #0000001a;
    out property <color> switch-off: root.use-system ? root.tint(0.22) : root.dark ? #4a4a50 : #c9c9ce;
    out property <color> danger: root.dark ? #ff7b72 : #d93a2f;
    out property <color> accent: root.use-clean ? root.pal.accent : #ff6a1a;
}

// One line of text that may hold a name in any script, cut where it meets
// its width with an ellipsis. Slint 1.18 elides only a left-to-right line
// well: a line that reads right to left (an Arabic file name, or Arabic
// text) is drawn past its box with no ellipsis, over whatever lies beside
// it. Such a line, when it is too wide, is clipped instead (which keeps its
// start, at the right, in sight) and ends in an ellipsis at the left. Any
// other line is an ordinary eliding Text.
export component LineText {
    in property <string> text;
    in property <length> font-size;
    in property <int> font-weight;
    in property <brush> color;
    in property <TextHorizontalAlignment> horizontal-alignment;
    in property <TextVerticalAlignment> vertical-alignment;
    in property <TextWrap> wrap;

    // The line reads right to left and is wider than its box.
    property <bool> cut: Theme.text-is-rtl(root.text) && whole.preferred-width > root.width;

    // As a Text with `overflow: elide` would ask of a layout.
    min-width: min(whole.preferred-width, dots.preferred-width);
    preferred-width: whole.preferred-width;
    min-height: whole.preferred-height;
    preferred-height: whole.preferred-height;

    // The whole line, measured only.
    whole := Text {
        visible: false;
        accessible-role: none;
        text: root.text;
        font-size: root.font-size;
        font-weight: root.font-weight;
    }

    // Where the line's top lies in the box, by the vertical alignment.
    property <length> line-top: root.vertical-alignment == TextVerticalAlignment.top ? 0px
        : root.vertical-alignment == TextVerticalAlignment.bottom ? root.height - whole.preferred-height
        : (root.height - whole.preferred-height) / 2;

    // A clipped line is clipped to its own box: that box reaches a little
    // above and below the line, so the marks over and under Arabic letters
    // stay whole, and the line stays where it was.
    Text {
        x: root.cut ? dots.preferred-width : 0px;
        y: root.cut ? root.line-top - 4px : 0px;
        width: root.width - self.x;
        height: root.cut ? whole.preferred-height + 8px : root.height;
        text: root.text;
        font-size: root.font-size;
        font-weight: root.font-weight;
        color: root.color;
        horizontal-alignment: root.horizontal-alignment;
        vertical-alignment: root.cut ? TextVerticalAlignment.center : root.vertical-alignment;
        wrap: root.wrap;
        overflow: root.cut ? TextOverflow.clip : TextOverflow.elide;
    }

    dots := Text {
        visible: root.cut;
        accessible-role: none;
        x: 0px;
        height: root.height;
        text: "…";
        font-size: root.font-size;
        font-weight: root.font-weight;
        color: root.color;
        vertical-alignment: root.vertical-alignment;
    }
}
