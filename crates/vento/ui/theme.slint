// The settings panel's colours, dark or light with the system appearance.
// Orange is the accent in both; the wheel and the Pocket keep their own
// dark look.

import { Palette } from "std-widgets.slint";

export global Theme {
    in-out property <bool> dark: Palette.color-scheme == ColorScheme.dark;

    out property <color> bg: root.dark ? #1f1f22 : #f1f9fa;
    out property <color> surface: root.dark ? #2b2b2f : #e2eaec;
    // A raised card on the panel (the tab bar), a shade lighter than `bg`
    // with a hairline edge.
    out property <color> card: root.dark ? #2b2b2f : #f6fbfc;
    out property <color> card-border: root.dark ? #ffffff14 : #e4e9e9;
    // The chosen tab: the accent, faint.
    out property <color> accent-soft: root.dark ? #ff6a1a33 : #ff6a1a1f;
    out property <color> selected: root.dark ? #3a3a40 : #ffffff;
    out property <color> text: root.dark ? #f2f2f3 : #1d1d1f;
    out property <color> muted: root.dark ? #9a9aa2 : #6e6e73;
    out property <color> separator: root.dark ? #ffffff14 : #0000000f;
    // The hairline around the panel and its arrow.
    out property <color> border: root.dark ? #ffffff1f : #0000001a;
    out property <color> switch-off: root.dark ? #4a4a50 : #c9c9ce;
    out property <color> danger: root.dark ? #ff7b72 : #d93a2f;
    out property <color> accent: #ff6a1a;
}
