// Copy from screen's permission window: shown when Screen Recording is not
// granted, it explains why vento needs it and opens System Settings.

import { Theme } from "theme.slint";
import { TextButton } from "controls.slint";

// The default button: the accent, as the password prompt's Extract.
component DefaultButton inherits Rectangle {
    in property <string> label;
    callback clicked();

    height: 28px;
    border-radius: 8px;
    background: touch.pressed ? #e55e15 : (touch.has-hover ? #ff7d38 : Theme.accent);
    accessible-role: button;
    accessible-label: self.label;
    accessible-action-default => { self.clicked(); }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;

        Text {
            text: root.label;
            font-size: 13px;
            font-weight: 600;
            color: white;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Asks for Screen Recording. Takes the keyboard: Return opens System
// Settings and Escape cancels. Its height follows its text; it follows the
// system light or dark appearance through `Theme`.
export component ScreenAccess inherits Window {
    no-frame: true;
    always-on-top: true;
    background: transparent;
    title: "Vento Screen Recording";
    default-font-size: 13px;

    callback open-settings();
    callback cancel();

    // The height the text needs, for placing the window before it shows.
    out property <length> content-height: content.preferred-height;

    // Gives the keys to the window (it is reused).
    public function focus-keys() {
        keys.focus();
    }

    width: 380px;
    height: content.preferred-height;
    forward-focus: keys;

    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cancel();
                return accept;
            }
            if (event.text == Key.Return) {
                root.open-settings();
                return accept;
            }
            return reject;
        }

        Rectangle {
            background: Theme.bg;
            border-radius: 14px;
            border-width: 1px;
            border-color: Theme.border;

            content := VerticalLayout {
                padding: 16px;
                spacing: 8px;

                HorizontalLayout {
                    spacing: 8px;

                    VerticalLayout {
                        alignment: center;

                        Image {
                            source: @image-url("icons/lock.svg");
                            width: 18px;
                            height: 18px;
                            colorize: Theme.accent;
                        }
                    }

                    Text {
                        text: "Copy from screen needs Screen Recording";
                        font-size: 13px;
                        font-weight: 600;
                        color: Theme.text;
                        vertical-alignment: center;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                }

                Text {
                    text: "To read text on your screen, Vento needs Screen Recording. It only looks at the area you select.";
                    font-size: 13px;
                    color: Theme.text;
                    wrap: word-wrap;
                }

                Text {
                    text: "After you switch it on, macOS may ask you to reopen Vento. After each Vento update, switch it on again; if the switch does nothing, remove Vento with the minus button and add it again.";
                    font-size: 12px;
                    color: Theme.muted;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    padding-top: 4px;

                    TextButton {
                        label: "Cancel";
                        height: 28px;
                        width: 64px;
                        clicked => { root.cancel(); }
                    }

                    DefaultButton {
                        label: "Open Settings";
                        clicked => { root.open-settings(); }
                    }
                }
            }
        }
    }
}
