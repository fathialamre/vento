// The Archive action's two windows: a small progress pill that never takes
// the keyboard, and the password prompt, which does.

import { Theme } from "theme.slint";
import { TextButton } from "controls.slint";

// Progress of a long extraction or compression: a frameless, always-on-top
// pill in the toast's style, with the job's title, a thin bar and Cancel.
export component ArchiveProgress inherits Window {
    title: @tr("Vento archive progress");
    no-frame: true;
    always-on-top: true;
    background: transparent;

    // e.g. "Extracting Photos.zip…".
    in property <string> heading;
    // 0 to 1; 0 while the total is not known yet.
    in property <float> fraction;
    callback cancel-clicked();

    width: 300px;
    height: 72px;

    Rectangle {
        background: #1d1d21f2;
        border-radius: 12px;
        border-width: 1px;
        border-color: #ffffff26;

        HorizontalLayout {
            padding-left: Theme.rtl ? 10px : 14px;
            padding-right: Theme.rtl ? 14px : 10px;
            padding-top: 4px;
            padding-bottom: 4px;
            spacing: 10px;

            VerticalLayout {
                layout-order: Theme.rtl ? 2 : 0;
                alignment: center;
                spacing: 8px;
                horizontal-stretch: 1;

                Text {
                    horizontal-alignment: Theme.rtl ? right : left;
                    text: root.heading;
                    color: white;
                    font-size: 13px;
                    overflow: elide;
                }

                // The bar: a faint track with the fraction done in orange.
                Rectangle {
                    height: 4px;
                    border-radius: 2px;
                    background: #ffffff26;
                    accessible-role: progress-indicator;
                    accessible-label: root.heading;
                    accessible-value: round(root.fraction * 100) + "%";

                    // Filled from the start of the line.
                    Rectangle {
                        x: Theme.rtl ? parent.width - self.width : 0px;
                        width: parent.width * clamp(root.fraction, 0, 1);
                        height: parent.height;
                        border-radius: 2px;
                        background: Theme.accent;
                    }
                }
            }

            Rectangle {
                layout-order: Theme.rtl ? 1 : 0;
                width: 60px;

                Rectangle {
                    y: 20px;
                    height: parent.height - 40px;
                    border-radius: 8px;
                    background: cancel-touch.pressed ? #ffffff40 : (cancel-touch.has-hover ? #ffffff33 : #ffffff1f);
                    accessible-role: button;
                    accessible-label: @tr("Cancel");
                    accessible-action-default => { root.cancel-clicked(); }

                    Text {
                        text: @tr("Cancel");
                        color: white;
                        font-size: 13px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                cancel-touch := TouchArea {
                    clicked => { root.cancel-clicked(); }
                }
            }
        }
    }
}

// The one prominent button of the prompt; muted and inert while disabled.
component ExtractButton inherits Rectangle {
    in property <bool> enabled;
    callback clicked();

    height: 28px;
    border-radius: 8px;
    background: self.enabled && touch.pressed ? #e55e15
        : (self.enabled && touch.has-hover ? #ff7d38 : Theme.accent);
    opacity: self.enabled ? 1 : 0.4;
    accessible-role: button;
    accessible-label: @tr("Extract");
    accessible-enabled: self.enabled;
    accessible-action-default => {
        if (self.enabled) {
            self.clicked();
        }
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;

        Text {
            horizontal-alignment: Theme.rtl ? right : left;
            text: @tr("Extract");
            font-size: 13px;
            font-weight: 600;
            color: white;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// Asks for the password of a protected archive. Takes the keyboard: the
// field has focus when it opens, Return extracts (once something is typed)
// and Escape cancels. It follows the system light or dark appearance
// through `Theme`.
export component PasswordPrompt inherits Window {
    no-frame: true;
    always-on-top: true;
    background: transparent;
    title: @tr("Vento archive password");
    default-font-size: 13px;

    // e.g. "\"Photos.zip\" is protected".
    in property <string> heading;
    // The last password was refused: "Wrong password" shows under the field.
    in property <bool> wrong;
    // What is typed; vento clears it after every use.
    in-out property <string> password;
    callback submit();
    callback cancel();

    // Puts the cursor back in the field (the window is reused).
    public function focus-field() {
        input.focus();
    }

    width: 320px;
    height: 150px;
    forward-focus: input;

    keys := FocusScope {
        // The field shows dots, but its copy and cut would still put the
        // password itself on the clipboard: those chords stop here.
        capture-key-pressed(event) => {
            if (input.has-focus && (event.modifiers.control || event.modifiers.meta)
                && (event.text == "c" || event.text == "C" || event.text == "x" || event.text == "X")) {
                return accept;
            }
            return reject;
        }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cancel();
                return accept;
            }
            return reject;
        }

        Rectangle {
            background: Theme.bg;
            border-radius: 14px;
            border-width: 1px;
            border-color: Theme.border;

            VerticalLayout {
                padding: 16px;
                spacing: 8px;

                HorizontalLayout {
                    spacing: 8px;

                    VerticalLayout {
                        layout-order: Theme.rtl ? 2 : 0;
                        alignment: center;

                        Image {
                            source: @image-url("icons/lock.svg");
                            width: 18px;
                            height: 18px;
                            colorize: Theme.accent;
                        }
                    }

                    Text {
                        layout-order: Theme.rtl ? 1 : 0;
                        horizontal-alignment: Theme.rtl ? right : left;
                        text: root.heading;
                        font-size: 13px;
                        font-weight: 600;
                        color: Theme.text;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                }

                // Made of a `TextInput` rather than the std-widgets `LineEdit`,
                // which takes its colours from the system's scheme and would
                // ignore the Appearance setting.
                Rectangle {
                    height: 28px;
                    border-radius: 6px;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: input.has-focus ? Theme.accent : Theme.separator;

                    // A click anywhere on the field, its margins too.
                    TouchArea {
                        mouse-cursor: MouseCursor.text;
                        clicked => { input.focus(); }
                    }

                    // Clips a long password and scrolls it to keep the cursor
                    // in view, as the std-widgets `LineEdit` does.
                    Rectangle {
                        x: 8px;
                        width: parent.width - 16px;
                        clip: true;

                        input := TextInput {
                            property <length> computed-x;

                            x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.computed-x));
                            width: max(parent.width - self.text-cursor-width, self.preferred-width);
                            height: 100%;
                            vertical-alignment: center;
                            horizontal-alignment: Theme.rtl ? right : left;
                            input-type: InputType.password;
                            text <=> root.password;
                            color: Theme.text;
                            font-size: 13px;
                            selection-background-color: Theme.accent-soft;
                            selection-foreground-color: Theme.text;
                            single-line: true;
                            accessible-label: @tr("Password");
                            accessible-placeholder-text: @tr("Password");
                            cursor-position-changed(cursor-position) => {
                                if cursor-position.x + self.computed-x < 0px {
                                    self.computed-x = -cursor-position.x;
                                } else if cursor-position.x + self.computed-x > parent.width - self.text-cursor-width {
                                    self.computed-x = parent.width - cursor-position.x - self.text-cursor-width;
                                }
                            }
                            accepted => {
                                if (root.password != "") {
                                    root.submit();
                                }
                            }
                        }
                    }

                    // The placeholder, over the empty field.
                    Text {
                        x: 8px;
                        width: parent.width - 16px;
                        height: parent.height;
                        visible: root.password == "";
                        horizontal-alignment: Theme.rtl ? right : left;
                        text: @tr("Password");
                        color: Theme.muted;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                }

                // Always takes its line, so the window does not jump.
                Text {
                    horizontal-alignment: Theme.rtl ? right : left;
                    text: root.wrong ? @tr("Wrong password") : "";
                    font-size: 12px;
                    color: Theme.danger;
                    height: 16px;
                    vertical-alignment: center;
                }

                HorizontalLayout {
                    alignment: Theme.rtl ? start : end;
                    spacing: 8px;

                    TextButton {
                        layout-order: Theme.rtl ? 2 : 0;
                        label: @tr("Cancel");
                        height: 28px;
                        width: 64px;
                        clicked => { root.cancel(); }
                    }

                    ExtractButton {
                        layout-order: Theme.rtl ? 1 : 0;
                        enabled: root.password != "";
                        clicked => { root.submit(); }
                    }
                }
            }
        }
    }
}
