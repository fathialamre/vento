// Parts shared by the app's ordinary windows: the toolbar tool, the orange
// and plain buttons, the footer progress bar and the popover pieces (head,
// option rows, choice pair, caption, card). Used by the PDF Pages window and
// the Rename window.

import { LineText, Theme } from "theme.slint";

// A toolbar tool: an icon over a short label, dimmed while it cannot be
// used.
export component IconTool inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    // Names the tool for assistive technology when the label is short.
    in property <string> name: self.label;
    in property <bool> enabled: true;
    // Its popover is open, or what it shows is shown.
    in property <bool> on;
    // It removes something (Delete).
    in property <bool> danger;
    callback clicked();

    min-width: max(46px, tool-label.preferred-width + 14px);
    border-radius: 7px;
    background: self.on ? Theme.accent-soft
        : self.enabled && touch.pressed ? Theme.hover
        : self.enabled && touch.has-hover ? Theme.surface : transparent;
    opacity: self.enabled ? 1 : 0.4;
    accessible-role: button;
    accessible-label: self.name;
    accessible-enabled: self.enabled;
    accessible-action-default => {
        if (self.enabled) {
            self.clicked();
        }
    }

    VerticalLayout {
        alignment: center;
        spacing: 3px;

        HorizontalLayout {
            alignment: center;

            Image {
                width: 18px;
                height: 18px;
                source: root.icon;
                colorize: root.on ? Theme.accent : root.danger ? Theme.danger : Theme.text;
            }
        }

        tool-label := Text {
            text: root.label;
            font-size: 11px;
            color: root.on ? Theme.accent : Theme.text;
            horizontal-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// An orange button: the main thing to do ("Save as new PDF", "Split into
// 3", "Save").
export component PrimaryButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked();

    height: 26px;
    border-radius: 7px;
    background: !self.enabled ? Theme.accent : touch.pressed ? #cc5414 : (touch.has-hover ? #ff8040 : Theme.accent);
    opacity: self.enabled ? 1 : 0.45;
    accessible-role: button;
    accessible-label: self.label;
    accessible-enabled: self.enabled;
    accessible-action-default => {
        if (self.enabled) {
            self.clicked();
        }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;

        Text {
            text: root.label;
            font-size: 12px;
            font-weight: 600;
            color: white;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// A plain button beside an orange one (Cancel, Discard). `danger` words
// it in red; `ghost` leaves it flat until the pointer is over it.
export component PlainButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> danger;
    in property <bool> ghost;
    callback clicked();

    height: 26px;
    border-radius: 7px;
    // The edge keeps it visible on a card of the same colour.
    border-width: self.ghost ? 0px : 1px;
    border-color: Theme.border;
    background: self.enabled && touch.pressed ? Theme.hover
        : self.enabled && touch.has-hover ? Theme.hover
        : self.ghost ? transparent : Theme.surface;
    opacity: self.enabled ? 1 : 0.45;
    accessible-role: button;
    accessible-label: self.label;
    accessible-enabled: self.enabled;
    accessible-action-default => {
        if (self.enabled) {
            self.clicked();
        }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;

        Text {
            text: root.label;
            font-size: 12px;
            color: root.danger ? Theme.danger : Theme.text;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// The footer's progress bar: how far a write is, or, with no measure of it,
// a stripe that runs to show it is busy.
export component JobBar inherits Rectangle {
    in property <float> fraction;
    in property <bool> measured;

    width: 140px;
    height: 6px;
    border-radius: 3px;
    background: Theme.surface;
    clip: true;
    accessible-role: progress-indicator;
    accessible-value: self.measured ? round(self.fraction * 100) : "";

    Rectangle {
        x: root.measured ? 0 : (Math.mod(animation-tick() / 1ms, 1400) / 1400) * (root.width + 50px) - 50px;
        width: root.measured ? root.width * root.fraction : 50px;
        height: root.height;
        border-radius: 3px;
        background: Theme.accent;
    }
}

// The top of a popover: its tool's icon on the accent, its heading and,
// under it, the pages it takes.
export component PopoverHead inherits HorizontalLayout {
    in property <image> icon;
    in property <string> title;
    in property <string> subtitle;

    spacing: 10px;

    VerticalLayout {
        layout-order: Theme.rtl ? 1 : 0;
        alignment: center;

        Rectangle {
            width: 30px;
            height: 30px;
            border-radius: 8px;
            background: Theme.accent-soft;

            Image {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 16px;
                height: 16px;
                source: root.icon;
                colorize: Theme.accent;
            }
        }
    }

    VerticalLayout {
        layout-order: Theme.rtl ? 0 : 1;
        horizontal-stretch: 1;
        alignment: center;
        spacing: 1px;

        LineText {
            text: root.title;
            font-size: 13px;
            font-weight: 600;
            color: Theme.text;
            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        }

        Text {
            text: root.subtitle;
            font-size: 11.5px;
            color: Theme.muted;
            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        }
    }
}

// A choice in a popover: a radio dot, its title and what it makes under
// it, and room at the end for its own controls. Chosen, it takes a faint
// tint of the accent and a light accent edge, so the colour marks the
// choice without filling it.
export component OptionRow inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <bool> on;
    callback chosen();

    min-height: 46px;
    border-radius: 9px;
    border-width: 1px;
    border-color: self.on ? Theme.accent.transparentize(0.5) : Theme.card-border;
    background: self.on ? Theme.accent.transparentize(Theme.dark ? 0.9 : 0.95) : touch.has-hover ? Theme.surface : transparent;
    accessible-role: radio-button;
    accessible-checked: self.on;
    accessible-label: self.title;
    accessible-description: self.detail;
    accessible-action-default => { self.chosen(); }

    touch := TouchArea {
        clicked => { root.chosen(); }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;

        VerticalLayout {
            layout-order: Theme.rtl ? 2 : 0;
            alignment: center;

            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 8px;
                border-width: 1.5px;
                border-color: root.on ? Theme.accent : Theme.switch-off;

                if root.on: Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: Theme.accent;
                }
            }
        }

        VerticalLayout {
            // The middle one stays in the middle.
            layout-order: Theme.rtl ? 1 : 1;
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;

            Text {
                text: root.title;
                font-size: 12.5px;
                font-weight: 500;
                color: Theme.text;
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
            }

            Text {
                text: root.detail;
                font-size: 11.5px;
                color: Theme.muted;
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
            }
        }

        VerticalLayout {
            layout-order: Theme.rtl ? 0 : 2;
            alignment: center;

            @children
        }
    }
}

// Two choices side by side, filling the width, each with a word under it
// ("PNG / Lossless"); the one on is raised.
export component ChoicePair inherits Rectangle {
    in property <string> first;
    in property <string> first-detail;
    in property <string> second;
    in property <string> second-detail;
    in property <bool> second-on;
    callback chosen(bool);

    height: 42px;
    border-radius: 8px;
    background: Theme.surface;

    HorizontalLayout {
        padding: 2px;
        spacing: 2px;

        for second[i] in [false, true]: Rectangle {
            layout-order: Theme.rtl ? 1 - i : i;
            horizontal-stretch: 1;
            border-radius: 6px;
            background: root.second-on == second ? Theme.selected : transparent;
            drop-shadow-blur: root.second-on == second ? 2px : 0px;
            drop-shadow-offset-y: 1px;
            drop-shadow-color: #0000001f;
            accessible-role: button;
            accessible-label: second ? root.second : root.first;
            accessible-description: second ? root.second-detail : root.first-detail;
            accessible-checked: root.second-on == second;
            accessible-action-default => { root.chosen(second); }

            VerticalLayout {
                alignment: center;

                Text {
                    text: second ? root.second : root.first;
                    font-size: 12px;
                    font-weight: root.second-on == second ? 600 : 400;
                    color: Theme.text;
                    horizontal-alignment: center;
                }

                Text {
                    text: second ? root.second-detail : root.first-detail;
                    font-size: 10.5px;
                    color: Theme.muted;
                    horizontal-alignment: center;
                }
            }

            TouchArea {
                clicked => { root.chosen(second); }
            }
        }
    }
}

// A small caption over a popover's control ("Format").
export component FieldLabel inherits Text {
    font-size: 11.5px;
    font-weight: 500;
    color: Theme.muted;
    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
}

// A card over the window: a popover or the closing question. A popover
// points at its tool with an arrow at `arrow-x` along its top edge; a
// negative `arrow-x` draws none.
export component Card inherits Rectangle {
    in property <length> arrow-x: -1px;

    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.dark ? Theme.card : Theme.bg;
    drop-shadow-blur: 28px;
    drop-shadow-offset-y: 12px;
    drop-shadow-color: #00000045;

    // Clicks on the card stay with it.
    TouchArea { }

    // The arrow: the card's edge colour, then its face 1px lower.
    if root.arrow-x >= 0: Image {
        x: root.arrow-x - 7px;
        y: -7px;
        width: 14px;
        height: 7px;
        source: @image-url("icons/popover-arrow.svg");
        colorize: Theme.border;
    }

    if root.arrow-x >= 0: Image {
        x: root.arrow-x - 7px;
        y: -6px;
        width: 14px;
        height: 7px;
        source: @image-url("icons/popover-arrow.svg");
        colorize: root.background;
    }

    @children
}

// A thin upright line between groups of toolbar buttons.
export component ToolGap inherits Rectangle {
    width: 1px;
    height: 16px;
    background: Theme.separator;
}
