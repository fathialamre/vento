// The settings panel: a solid, frameless window that hangs under the
// menu-bar icon from a small arrow pointing at it, with a segmented tab bar, one page per tab and a footer
// with Pause, Quit and Done. It follows the system light or dark appearance
// through `Theme`.

import { Theme } from "theme.slint";
import { Icons } from "wheel.slint";
import {
    PanelIcons, SectionHeading, Separator, Switch, SwitchRow, Segmented, MenuField, LayoutCard,
    TextButton, IconButton, Stepper, ShortcutField, ReorderRow, DragGrip,
} from "controls.slint";

// One action in the Wheel tab's list, shown on the wheel or not.
export struct ActionRow { icon: image, label: string, shown: bool }

// One folder in the Move tab: its Finder icon (when `has-icon`), its name,
// where it is (its parent folder, the home folder as ~) and whether it is
// missing on disk.
export struct FolderRow { icon: image, has-icon: bool, name: string, place: string, missing: bool }

struct TabItem { icon: image, label: string }

// A segmented control: a rounded track with the selected tab raised on a
// pill; each tab is an icon above a short label.
component TabBar inherits Rectangle {
    in property <[TabItem]> tabs;
    in-out property <int> current;

    property <length> pad: 3px;
    property <length> tab-w: (self.width - 2 * self.pad) / max(1, self.tabs.length);
    property <length> tab-h: self.height - 2 * self.pad;

    height: 46px;
    border-radius: 10px;
    background: Theme.surface;

    Rectangle {
        x: root.pad + root.current * root.tab-w;
        y: root.pad;
        width: root.tab-w;
        height: root.tab-h;
        border-radius: 8px;
        background: Theme.selected;
        drop-shadow-blur: 3px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: Theme.dark ? #00000059 : #0000001f;
        animate x { duration: 150ms; easing: ease-out; }
    }

    for item[i] in root.tabs: Rectangle {
        property <bool> on: i == root.current;
        x: root.pad + i * root.tab-w;
        y: root.pad;
        width: root.tab-w;
        height: root.tab-h;
        accessible-role: tab;
        accessible-label: item.label;
        accessible-item-selected: self.on;
        accessible-action-default => { root.current = i; }

        VerticalLayout {
            alignment: center;
            spacing: 3px;

            HorizontalLayout {
                alignment: center;

                Image {
                    source: item.icon;
                    width: 16px;
                    height: 16px;
                    colorize: on ? Theme.text : Theme.muted;
                }
            }

            Text {
                text: item.label;
                font-size: 11px;
                font-weight: on ? 600 : 400;
                color: on ? Theme.text : Theme.muted;
                horizontal-alignment: center;
            }
        }

        TouchArea {
            clicked => { root.current = i; }
        }
    }
}

// A quiet footer item: an icon and a word, highlighted on hover. A
// toggleable item that is on is tinted orange.
component FooterItem inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> toggleable;
    in property <bool> toggled;
    callback clicked();

    property <color> tint: self.toggled ? Theme.accent : (touch.has-hover ? Theme.text : Theme.muted);

    height: 28px;
    border-radius: 6px;
    background: self.toggled
        ? (touch.has-hover ? #ff6a1a38 : #ff6a1a24)
        : (touch.has-hover ? Theme.surface : transparent);
    accessible-role: button;
    accessible-label: self.label;
    accessible-checkable: self.toggleable;
    accessible-checked: self.toggled;
    accessible-action-default => { self.clicked(); }

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 8px;
        spacing: 6px;

        // A fixed-size image sits at the top of a row; centre it on the label.
        VerticalLayout {
            alignment: center;

            Image {
                source: root.icon;
                width: 16px;
                height: 16px;
                colorize: root.tint;
            }
        }

        Text {
            text: root.label;
            font-size: 13px;
            color: root.tint;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// The one prominent button.
component DoneButton inherits Rectangle {
    callback clicked();

    height: 28px;
    border-radius: 8px;
    background: touch.pressed ? #e55e15 : (touch.has-hover ? #ff7d38 : Theme.accent);
    accessible-role: button;
    accessible-label: "Done";
    accessible-action-default => { self.clicked(); }

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;

        Text {
            text: "Done";
            font-size: 13px;
            font-weight: 600;
            color: white;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Why the settings file was not loaded.
component Notice inherits Rectangle {
    in property <string> text;

    border-radius: 8px;
    background: Theme.surface;

    HorizontalLayout {
        padding: 8px;
        spacing: 8px;

        VerticalLayout {
            alignment: start;

            Image {
                source: Icons.missing;
                width: 14px;
                height: 14px;
                colorize: Theme.danger;
            }
        }

        Text {
            text: root.text;
            font-size: 12px;
            color: Theme.text;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }
    }
}

// The wheel's actions, one row each: a grip to drag the row into a new
// place, the action's icon and name, and a switch to show or hide it.
// While a row is dragged it follows the pointer and the rows it passes
// make room; it drops at the row nearest to where it was let go. The shown
// rows come first and a row stays among its own kind (switching it on or
// off moves it between them).
component ActionList inherits Rectangle {
    in property <[ActionRow]> rows;
    // How many of the rows are shown on the wheel (they come first).
    in property <int> shown-count;
    callback toggled(int, bool);
    callback moved(int, int);

    property <length> row-h: 34px;
    // The row being dragged (-1 for none), how far it has moved, the first
    // and last place it can go, and the place it would drop at now.
    property <int> drag-from: -1;
    property <length> drag-offset;
    property <int> drag-lo: self.drag-from < self.shown-count ? 0 : self.shown-count;
    property <int> drag-hi: self.drag-from < self.shown-count
        ? self.shown-count - 1
        : self.rows.length - 1;
    property <int> drag-to: self.drag-from < 0
        ? -1
        : clamp(self.drag-from + round(self.drag-offset / self.row-h), self.drag-lo, self.drag-hi);

    height: self.rows.length * self.row-h;

    for row[i] in root.rows: ReorderRow {
        index: i;
        drag-from: root.drag-from;
        drag-to: root.drag-to;
        drag-offset: root.drag-offset;
        row-h: root.row-h;
        width: root.width;
        accessible-role: list-item;
        accessible-label: row.label;

        HorizontalLayout {
            padding-left: 2px;
            padding-right: 6px;
            spacing: 8px;

            DragGrip {
                index: i;
                row-h: root.row-h;
                lo: root.drag-lo;
                hi: root.drag-hi;
                drop-to: root.drag-to;
                drag-from <=> root.drag-from;
                drag-offset <=> root.drag-offset;
                moved(from, to) => { root.moved(from, to); }
            }

            VerticalLayout {
                alignment: center;

                Image {
                    source: row.icon;
                    width: 16px;
                    height: 16px;
                    colorize: row.shown ? Theme.text : Theme.muted;
                }
            }

            Text {
                text: row.label;
                font-size: 13px;
                color: row.shown ? Theme.text : Theme.muted;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            VerticalLayout {
                alignment: center;

                Switch {
                    on: row.shown;
                    label: row.label;
                    toggled(on) => { root.toggled(i, on); }
                }
            }
        }
    }
}

component WheelTab inherits VerticalLayout {
    // 0 Honeycomb, 1 Petals.
    in property <int> wheel-layout;
    in property <[ActionRow]> actions;
    in property <int> shown-actions;
    callback layout-chosen(int);
    callback action-toggled(int, bool);
    callback action-moved(int, int);

    spacing: 8px;

    SectionHeading {
        text: "Layout";
    }

    HorizontalLayout {
        spacing: 8px;

        LayoutCard {
            preferred-width: 100px;
            horizontal-stretch: 1;
            icon: PanelIcons.wheel;
            label: "Honeycomb";
            chosen: root.wheel-layout == 0;
            clicked => { root.layout-chosen(0); }
        }

        LayoutCard {
            preferred-width: 100px;
            horizontal-stretch: 1;
            icon: PanelIcons.petals;
            label: "Petals";
            chosen: root.wheel-layout == 1;
            clicked => { root.layout-chosen(1); }
        }
    }

    Separator { }

    SectionHeading {
        text: "Actions";
    }

    ActionList {
        rows: root.actions;
        shown-count: root.shown-actions;
        toggled(i, on) => { root.action-toggled(i, on); }
        moved(from, to) => { root.action-moved(from, to); }
    }
}

// A folder's icon and name, with where it is after them in a dimmer
// colour; dimmed as a whole when the folder is missing.
component FolderLabel inherits HorizontalLayout {
    in property <FolderRow> folder;

    spacing: 8px;

    VerticalLayout {
        alignment: center;

        if root.folder.has-icon: Image {
            source: root.folder.icon;
            width: 16px;
            height: 16px;
            opacity: root.folder.missing ? 0.4 : 1;
        }
        if !root.folder.has-icon: Image {
            source: PanelIcons.folder;
            width: 16px;
            height: 16px;
            colorize: Theme.muted;
            opacity: root.folder.missing ? 0.4 : 1;
        }
    }

    // The name keeps to its own width, up to most of the row (the panel is
    // 340 px wide); where it is takes the rest.
    Text {
        text: root.folder.name;
        font-size: 13px;
        color: root.folder.missing ? Theme.muted : Theme.text;
        vertical-alignment: center;
        horizontal-stretch: 0;
        max-width: 170px;
        overflow: elide;
    }

    Text {
        text: root.folder.missing ? "Missing" : root.folder.place;
        font-size: 11px;
        color: Theme.muted;
        vertical-alignment: center;
        horizontal-stretch: 1;
        overflow: elide;
    }
}

// The pinned folders, in ring order: a grip to drag a row into a new
// place, the folder, and a button to unpin it.
component PinnedList inherits Rectangle {
    in property <[FolderRow]> rows;
    callback moved(int, int);
    callback unpinned(int);

    property <length> row-h: 34px;
    // The row being dragged (-1 for none), how far it has moved, and the
    // place it would drop at now.
    property <int> drag-from: -1;
    property <length> drag-offset;
    property <int> drag-to: self.drag-from < 0
        ? -1
        : clamp(self.drag-from + round(self.drag-offset / self.row-h), 0, self.rows.length - 1);

    height: self.rows.length * self.row-h;

    for row[i] in root.rows: ReorderRow {
        index: i;
        drag-from: root.drag-from;
        drag-to: root.drag-to;
        drag-offset: root.drag-offset;
        row-h: root.row-h;
        width: root.width;
        accessible-role: list-item;
        accessible-label: row.name;

        HorizontalLayout {
            padding-left: 2px;
            padding-right: 2px;
            spacing: 8px;

            DragGrip {
                index: i;
                row-h: root.row-h;
                lo: 0;
                hi: root.rows.length - 1;
                drop-to: root.drag-to;
                drag-from <=> root.drag-from;
                drag-offset <=> root.drag-offset;
                moved(from, to) => { root.moved(from, to); }
            }

            FolderLabel {
                folder: row;
                horizontal-stretch: 1;
            }

            VerticalLayout {
                alignment: center;

                IconButton {
                    icon: Icons.remove;
                    label: "Unpin " + row.name;
                    clicked => { root.unpinned(i); }
                }
            }
        }
    }
}

// What a list with no rows shows instead.
component EmptyLine inherits Text {
    height: 30px;
    font-size: 12px;
    color: Theme.muted;
    vertical-alignment: center;
}

component MoveTab inherits VerticalLayout {
    in property <[FolderRow]> pinned;
    in property <bool> pinned-full;
    in property <[FolderRow]> recent;
    // The recent history holds folders, shown or not.
    in property <bool> has-history;
    in property <bool> can-pin;
    in property <string> hold;
    in property <bool> hold-can-decrease;
    in property <bool> hold-can-increase;
    callback add-folder();
    callback pinned-moved(int, int);
    callback unpinned(int);
    callback recent-pinned(int);
    callback recent-cleared();
    callback hold-stepped(int);

    spacing: 8px;

    HorizontalLayout {
        SectionHeading {
            text: "Pinned";
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        TextButton {
            label: root.pinned-full ? "Up to 7 folders" : "Add folder";
            icon: PanelIcons.add;
            has-icon: !root.pinned-full;
            enabled: !root.pinned-full;
            clicked => { root.add-folder(); }
        }
    }

    if root.pinned.length == 0: EmptyLine {
        text: "No pinned folders";
    }

    if root.pinned.length > 0: PinnedList {
        rows: root.pinned;
        moved(from, to) => { root.pinned-moved(from, to); }
        unpinned(i) => { root.unpinned(i); }
    }

    Separator { }

    HorizontalLayout {
        SectionHeading {
            text: "Recent";
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        TextButton {
            label: "Clear";
            enabled: root.has-history;
            clicked => { root.recent-cleared(); }
        }
    }

    if root.recent.length == 0: EmptyLine {
        text: "No recent folders";
    }

    if root.recent.length > 0: VerticalLayout {
        for row[i] in root.recent: Rectangle {
            height: 30px;
            accessible-role: list-item;
            accessible-label: row.name;

            HorizontalLayout {
                padding-left: 2px;
                padding-right: 2px;
                spacing: 8px;

                FolderLabel {
                    folder: row;
                    horizontal-stretch: 1;
                }

                VerticalLayout {
                    alignment: center;

                    IconButton {
                        icon: Icons.pin;
                        label: "Pin " + row.name;
                        enabled: root.can-pin;
                        clicked => { root.recent-pinned(i); }
                    }
                }
            }
        }
    }

    Separator { }

    HorizontalLayout {
        spacing: 8px;

        Text {
            text: "Hold on Move";
            font-size: 13px;
            color: Theme.text;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        Stepper {
            text: root.hold;
            label: "Hold on Move";
            can-decrease: root.hold-can-decrease;
            can-increase: root.hold-can-increase;
            decrease => { root.hold-stepped(-1); }
            increase => { root.hold-stepped(1); }
        }
    }
}

component PocketTab inherits VerticalLayout {
    // The Pocket shortcut as symbols, and why the last one recorded was
    // refused (empty when it was not).
    in property <string> shortcut;
    in-out property <string> shortcut-error;
    in-out property <bool> recording;
    in property <bool> remove-after-drop;
    in property <bool> keep-copies;
    callback recording-started();
    callback recording-cancelled();
    callback remove-after-drop-toggled(bool);
    callback keep-copies-toggled(bool);

    spacing: 8px;

    SectionHeading {
        text: "Shortcut";
    }

    ShortcutField {
        text: root.shortcut;
        label: "Pocket shortcut";
        recording <=> root.recording;
        started => {
            root.shortcut-error = "";
            root.recording-started();
        }
        cancelled => { root.recording-cancelled(); }
    }

    if root.shortcut-error != "": Text {
        text: root.shortcut-error;
        font-size: 12px;
        color: Theme.danger;
        wrap: word-wrap;
    }

    Separator { }

    SwitchRow {
        label: "Remove after drag-out";
        on: root.remove-after-drop;
        toggled(on) => { root.remove-after-drop-toggled(on); }
    }

    SwitchRow {
        label: "Keep a copy";
        on: root.keep-copies;
        toggled(on) => { root.keep-copies-toggled(on); }
    }
}

component GeneralTab inherits VerticalLayout {
    // 0 Control, 1 Option, 2 Shift, 3 Command.
    in property <int> trigger;
    in property <[string]> terminals;
    in property <int> terminal;
    // 0 Plain, 1 Shell-quoted.
    in property <int> path-format;
    callback trigger-chosen(int);
    callback terminal-chosen(int);
    callback path-format-chosen(int);

    spacing: 8px;

    SectionHeading {
        text: "Trigger";
    }

    Segmented {
        items: ["Control", "Option", "Shift", "Command"];
        current: root.trigger;
        chosen(i) => { root.trigger-chosen(i); }
    }

    Separator { }

    SectionHeading {
        text: "Terminal";
    }

    MenuField {
        label: "Terminal";
        items: root.terminals;
        current: root.terminal;
        chosen(i) => { root.terminal-chosen(i); }
    }

    Separator { }

    SectionHeading {
        text: "Copy path";
    }

    Segmented {
        items: ["Plain", "Shell-quoted"];
        current: root.path-format;
        chosen(i) => { root.path-format-chosen(i); }
    }
}

// The panel's shape, drawn as one outline so the arrow and the body share
// a fill and a hairline with no seam: a rounded rectangle below `arrow-h`,
// and on its top edge an arrow 20px wide whose centre is `arrow-x`, its tip
// rounded and its base curving into the edge. The outline runs half a
// pixel inside the element so the whole hairline is drawn.
component PanelOutline inherits Path {
    in property <length> arrow-x;
    in property <length> arrow-h;
    in property <length> radius;

    // In path units, which are logical pixels here (see the viewbox).
    property <float> s: 0.5;
    property <float> w: self.width / 1px - self.s;
    property <float> h: self.height / 1px - self.s;
    property <float> top: self.arrow-h / 1px + self.s;
    property <float> r: self.radius / 1px;
    property <float> ax: self.arrow-x / 1px;
    // Half the arrow's base, how far its base curves into the edge, and
    // where along each side (as a fraction from the tip) the tip's
    // rounding starts.
    property <float> half: 10;
    property <float> blend: 3;
    property <float> round: 0.25;
    // The arrow's height in path units, from the top edge to the tip.
    property <float> rise: self.top - self.s;

    viewbox-x: 0;
    viewbox-y: 0;
    viewbox-width: self.width / 1px;
    viewbox-height: self.height / 1px;
    fill: Theme.bg;
    stroke: Theme.border;
    stroke-width: 1px;

    MoveTo {
        x: root.ax - root.half - root.blend;
        y: root.top;
    }
    // Into the arrow's left side, tangent to the edge and to the side.
    QuadraticTo {
        control-x: root.ax - root.half;
        control-y: root.top;
        x: root.ax - root.half + root.blend;
        y: root.top - root.rise * root.blend / root.half;
    }
    LineTo {
        x: root.ax - root.half * root.round;
        y: root.s + root.rise * root.round;
    }
    // The rounded tip: its apex lies 1.25 below `s`, and the panel code
    // places the window by that (TIP_INSET).
    QuadraticTo {
        control-x: root.ax;
        control-y: root.s;
        x: root.ax + root.half * root.round;
        y: root.s + root.rise * root.round;
    }
    LineTo {
        x: root.ax + root.half - root.blend;
        y: root.top - root.rise * root.blend / root.half;
    }
    QuadraticTo {
        control-x: root.ax + root.half;
        control-y: root.top;
        x: root.ax + root.half + root.blend;
        y: root.top;
    }
    LineTo {
        x: root.w - root.r;
        y: root.top;
    }
    ArcTo {
        x: root.w;
        y: root.top + root.r;
        radius-x: root.r;
        radius-y: root.r;
        sweep: true;
    }
    LineTo {
        x: root.w;
        y: root.h - root.r;
    }
    ArcTo {
        x: root.w - root.r;
        y: root.h;
        radius-x: root.r;
        radius-y: root.r;
        sweep: true;
    }
    LineTo {
        x: root.s + root.r;
        y: root.h;
    }
    ArcTo {
        x: root.s;
        y: root.h - root.r;
        radius-x: root.r;
        radius-y: root.r;
        sweep: true;
    }
    LineTo {
        x: root.s;
        y: root.top + root.r;
    }
    ArcTo {
        x: root.s + root.r;
        y: root.top;
        radius-x: root.r;
        radius-y: root.r;
        sweep: true;
    }
    Close { }
}

export component SettingsPanel inherits Window {
    no-frame: true;
    always-on-top: true;
    background: transparent;
    title: "vento settings";
    default-font-size: 13px;

    // The selected tab: 0 Wheel, 1 Move, 2 Pocket, 3 General.
    in-out property <int> tab;
    // vento is paused: the Pause item shows as on.
    in property <bool> paused;
    // Shown above the page when not empty.
    in property <string> notice;

    // The settings in effect, as the controls show them.
    // 0 Honeycomb, 1 Petals.
    in property <int> wheel-layout;
    // The wheel's actions, the shown ones first, and how many are shown.
    in property <[ActionRow]> actions;
    in property <int> shown-actions;
    // 0 Control, 1 Option, 2 Shift, 3 Command.
    in property <int> trigger;
    // The installed terminals' names, and the one in use.
    in property <[string]> terminals;
    in property <int> terminal;
    // 0 Plain, 1 Shell-quoted.
    in property <int> path-format;
    // The pinned folders in ring order, and whether there is room for more.
    in property <[FolderRow]> pinned;
    in property <bool> pinned-full;
    // The recent folders the ring shows now (pinned ones left out), and
    // whether the history behind them holds any folder.
    in property <[FolderRow]> recent;
    in property <bool> recent-history;
    // The hold delay as shown ("400 ms"), and whether it can go down or up.
    in property <string> hold;
    in property <bool> hold-can-decrease;
    in property <bool> hold-can-increase;
    // The Pocket shortcut as symbols, and why a recorded one was refused.
    in property <string> shortcut;
    in-out property <string> shortcut-error;
    // The shortcut field is waiting for a key combination.
    in-out property <bool> shortcut-recording;
    in property <bool> remove-after-drop;
    in property <bool> keep-copies;

    // A control asks for a change; vento applies and saves it and sets the
    // properties above from the result.
    callback layout-chosen(int);
    callback action-toggled(int, bool);
    // A row of the Wheel tab's list dragged from one place to another.
    callback action-moved(int, int);
    callback trigger-chosen(int);
    callback terminal-chosen(int);
    callback path-format-chosen(int);
    // "Add folder": vento shows the folder picker.
    callback add-folder();
    callback pinned-moved(int, int);
    callback unpinned(int);
    // A recent folder's pin button.
    callback recent-pinned(int);
    callback recent-cleared();
    // The hold delay's − (-1) or + (1).
    callback hold-stepped(int);
    callback remove-after-drop-toggled(bool);
    callback keep-copies-toggled(bool);
    // The shortcut field started recording, and the recording ended (each
    // way it can end goes through `stop-recording`).
    callback shortcut-recording-started();
    callback shortcut-recording-stopped();

    callback pause-clicked();
    callback quit-clicked();
    // Done or Esc.
    callback close-requested();

    // Where the arrow on the top edge points: its centre, from the left
    // edge. vento sets it so the arrow points at the menu-bar icon.
    in property <length> arrow-x: self.width / 2;

    // The arrow's height above the body, and the body's corner radius (the
    // panel code relies on both, and on the arrow's width and blend).
    property <length> arrow-h: 10px;
    property <length> radius: 16px;

    // The height the window takes: the arrow above the height the panel's
    // content asks for.
    out property <length> window-height: self.arrow-h + layout.preferred-height;

    width: 340px;
    height: self.window-height;
    forward-focus: keys;

    // Ends a shortcut recording without a change and gives the keyboard
    // back to the panel, so Esc closes it again.
    public function stop-recording() {
        root.shortcut-recording = false;
        keys.focus();
        root.shortcut-recording-stopped();
    }

    // Leaving the Pocket tab removes the field that was recording.
    changed tab => {
        if (root.shortcut-recording) {
            root.stop-recording();
        }
    }

    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close-requested();
                return accept;
            }
            return reject;
        }

        PanelOutline {
            width: parent.width;
            height: parent.height;
            arrow-x: root.arrow-x;
            arrow-h: root.arrow-h;
            radius: root.radius;
        }

        Rectangle {
            y: root.arrow-h;
            height: parent.height - root.arrow-h;

            layout := VerticalLayout {
                padding: 12px;
                spacing: 12px;

                TabBar {
                    current <=> root.tab;
                    tabs: [
                        { icon: PanelIcons.wheel, label: "Wheel" },
                        { icon: Icons.move, label: "Move" },
                        { icon: Icons.pocket, label: "Pocket" },
                        { icon: PanelIcons.general, label: "General" },
                    ];
                }

                if root.notice != "": Notice {
                    text: root.notice;
                }

                VerticalLayout {
                    min-height: 120px;

                    if root.tab == 0: WheelTab {
                        wheel-layout: root.wheel-layout;
                        actions: root.actions;
                        shown-actions: root.shown-actions;
                        layout-chosen(i) => { root.layout-chosen(i); }
                        action-toggled(i, on) => { root.action-toggled(i, on); }
                        action-moved(from, to) => { root.action-moved(from, to); }
                    }
                    if root.tab == 1: MoveTab {
                        pinned: root.pinned;
                        pinned-full: root.pinned-full;
                        recent: root.recent;
                        has-history: root.recent-history;
                        can-pin: !root.pinned-full;
                        hold: root.hold;
                        hold-can-decrease: root.hold-can-decrease;
                        hold-can-increase: root.hold-can-increase;
                        add-folder => { root.add-folder(); }
                        pinned-moved(from, to) => { root.pinned-moved(from, to); }
                        unpinned(i) => { root.unpinned(i); }
                        recent-pinned(i) => { root.recent-pinned(i); }
                        recent-cleared => { root.recent-cleared(); }
                        hold-stepped(step) => { root.hold-stepped(step); }
                    }
                    if root.tab == 2: PocketTab {
                        shortcut: root.shortcut;
                        shortcut-error <=> root.shortcut-error;
                        recording <=> root.shortcut-recording;
                        remove-after-drop: root.remove-after-drop;
                        keep-copies: root.keep-copies;
                        recording-started => { root.shortcut-recording-started(); }
                        recording-cancelled => { root.stop-recording(); }
                        remove-after-drop-toggled(on) => { root.remove-after-drop-toggled(on); }
                        keep-copies-toggled(on) => { root.keep-copies-toggled(on); }
                    }
                    if root.tab == 3: GeneralTab {
                        trigger: root.trigger;
                        terminals: root.terminals;
                        terminal: root.terminal;
                        path-format: root.path-format;
                        trigger-chosen(i) => { root.trigger-chosen(i); }
                        terminal-chosen(i) => { root.terminal-chosen(i); }
                        path-format-chosen(i) => { root.path-format-chosen(i); }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Theme.separator;
                }

                HorizontalLayout {
                    spacing: 4px;

                    FooterItem {
                        icon: root.paused ? PanelIcons.resume : PanelIcons.pause;
                        label: "Pause";
                        toggleable: true;
                        toggled: root.paused;
                        clicked => { root.pause-clicked(); }
                    }

                    FooterItem {
                        icon: PanelIcons.quit;
                        label: "Quit";
                        clicked => { root.quit-clicked(); }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    DoneButton {
                        clicked => { root.close-requested(); }
                    }
                }
            }
        }
    }
}
