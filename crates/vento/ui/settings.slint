// The menu-bar panel: a solid, frameless window that hangs under the
// menu-bar icon from a small arrow pointing at it, with Keep Awake and a
// footer with Pause, Settings…, Quit and Done. It follows the Appearance
// setting through `Theme`. The settings themselves are in the Settings
// window (`settings_window.slint`).

import { Theme } from "theme.slint";
import { Notice } from "settings_pages.slint";
import {
    PanelIcons, SectionHeading, Separator, Switch, TextButton, Stepper, Chip,
} from "controls.slint";

// A quiet footer item: an icon and a word, highlighted on hover. A
// toggleable item that is on is tinted orange.
component FooterItem inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> toggleable;
    in property <bool> toggled;
    callback clicked();

    property <color> tint: self.toggled ? Theme.accent : (touch.has-hover ? Theme.text : Theme.muted);

    height: 28px;
    border-radius: 6px;
    background: self.toggled
        ? (touch.has-hover ? #ff6a1a38 : #ff6a1a24)
        : (touch.has-hover ? Theme.surface : transparent);
    accessible-role: button;
    accessible-label: self.label;
    accessible-checkable: self.toggleable;
    accessible-checked: self.toggled;
    accessible-action-default => { self.clicked(); }

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 8px;
        spacing: 6px;

        // A fixed-size image sits at the top of a row; centre it on the label.
        VerticalLayout {
            alignment: center;

            Image {
                source: root.icon;
                width: 16px;
                height: 16px;
                colorize: root.tint;
            }
        }

        Text {
            text: root.label;
            font-size: 13px;
            color: root.tint;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// The one prominent button.
component DoneButton inherits Rectangle {
    callback clicked();

    height: 28px;
    border-radius: 8px;
    background: touch.pressed ? #e55e15 : (touch.has-hover ? #ff7d38 : Theme.accent);
    accessible-role: button;
    accessible-label: "Done";
    accessible-action-default => { self.clicked(); }

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;

        Text {
            text: "Done";
            font-size: 13px;
            font-weight: 600;
            color: white;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Keep Awake: a card with what is held now and the switch, a row of
// times and the two open-ended choices. Its option is in the Settings
// window.
component KeepAwakeTab inherits VerticalLayout {
    // The status line, and whether anything is held.
    in property <string> status;
    in property <bool> on;
    // The running chip: 0 to 5 the timed ones, 6 until stopped, 7 until a
    // time; -1 none.
    in property <int> chip;
    // The time the Until popup shows, set by vento as the panel opens.
    in-out property <int> until-hour;
    in-out property <int> until-minute;
    // The switch: on starts "until stopped", off stops what runs.
    callback switched(bool);
    // A chip other than "Until a time…", or that one while it runs.
    callback chip-clicked(int);
    // The Until popup's Start.
    callback until-started(int, int);

    property <[string]> times: ["15 min", "30 min", "1 h", "2 h", "4 h", "8 h"];

    function two-digits(n: int) -> string {
        return (n < 10 ? "0" : "") + n;
    }

    spacing: 8px;

    Rectangle {
        background: Theme.card;
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.card-border;

        HorizontalLayout {
            padding: 10px;
            spacing: 10px;

            VerticalLayout {
                alignment: center;

                Rectangle {
                    width: 34px;
                    height: 34px;
                    border-radius: self.height / 2;
                    background: root.on ? Theme.accent-soft : Theme.surface;

                    Image {
                        source: PanelIcons.awake;
                        width: 20px;
                        height: 20px;
                        colorize: root.on ? Theme.accent : Theme.muted;
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;

                Text {
                    text: root.on ? "Awake" : "Not keeping awake";
                    font-size: 13px;
                    font-weight: 600;
                    color: Theme.text;
                }

                Text {
                    text: root.status;
                    font-size: 12px;
                    color: Theme.muted;
                    wrap: word-wrap;
                }
            }

            VerticalLayout {
                alignment: center;

                Switch {
                    on: root.on;
                    label: "Keep Awake";
                    toggled(on) => { root.switched(on); }
                }
            }
        }
    }

    SectionHeading {
        text: "Stay awake for";
    }

    HorizontalLayout {
        spacing: 4px;

        for time[i] in root.times: Chip {
            horizontal-stretch: 1;
            label: time;
            chosen: root.chip == i;
            clicked => { root.chip-clicked(i); }
        }
    }

    Rectangle {
        height: 28px;

        HorizontalLayout {
            spacing: 4px;

            Chip {
                horizontal-stretch: 1;
                label: "Until I stop it";
                chosen: root.chip == 6;
                clicked => { root.chip-clicked(6); }
            }

            Chip {
                horizontal-stretch: 1;
                label: "Until a time…";
                chosen: root.chip == 7;
                clicked => {
                    if (root.chip == 7) {
                        root.chip-clicked(7);
                    } else {
                        until-popup.show();
                    }
                }
            }
        }

        // Under "Until a time…", at the right edge.
        until-popup := PopupWindow {
            x: parent.width - self.width;
            y: parent.height + 4px;
            width: 252px;
            height: 112px;
            close-policy: PopupClosePolicy.close-on-click-outside;

            Rectangle {
                background: Theme.selected;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.separator;
                drop-shadow-blur: 8px;
                drop-shadow-offset-y: 2px;
                drop-shadow-color: #00000040;

                VerticalLayout {
                    padding: 10px;
                    spacing: 8px;

                    Text {
                        text: "Stay awake until";
                        font-size: 12px;
                        color: Theme.muted;
                    }

                    HorizontalLayout {
                        alignment: center;
                        spacing: 4px;

                        Stepper {
                            text: root.two-digits(root.until-hour);
                            label: "Hour";
                            can-decrease: true;
                            can-increase: true;
                            decrease => { root.until-hour = Math.mod(root.until-hour + 23, 24); }
                            increase => { root.until-hour = Math.mod(root.until-hour + 1, 24); }
                        }

                        Text {
                            text: ":";
                            font-size: 13px;
                            color: Theme.text;
                            vertical-alignment: center;
                        }

                        Stepper {
                            text: root.two-digits(root.until-minute);
                            label: "Minute";
                            can-decrease: true;
                            can-increase: true;
                            decrease => { root.until-minute = Math.mod(root.until-minute + 55, 60); }
                            increase => { root.until-minute = Math.mod(root.until-minute + 5, 60); }
                        }
                    }

                    HorizontalLayout {
                        alignment: end;

                        TextButton {
                            label: "Start";
                            clicked => {
                                root.until-started(root.until-hour, root.until-minute);
                                until-popup.close();
                            }
                        }
                    }
                }
            }
        }
    }
}

// The panel's shape, drawn as one outline so the arrow and the body share
// a fill and a hairline with no seam: a rounded rectangle below `arrow-h`,
// and on its top edge an arrow 20px wide whose centre is `arrow-x`, its tip
// rounded and its base curving into the edge. The outline runs half a
// pixel inside the element so the whole hairline is drawn.
component PanelOutline inherits Path {
    in property <length> arrow-x;
    in property <length> arrow-h;
    in property <length> radius;

    // In path units, which are logical pixels here (see the viewbox).
    property <float> s: 0.5;
    property <float> w: self.width / 1px - self.s;
    property <float> h: self.height / 1px - self.s;
    property <float> top: self.arrow-h / 1px + self.s;
    property <float> r: self.radius / 1px;
    property <float> ax: self.arrow-x / 1px;
    // Half the arrow's base, how far its base curves into the edge, and
    // where along each side (as a fraction from the tip) the tip's
    // rounding starts.
    property <float> half: 10;
    property <float> blend: 3;
    property <float> round: 0.25;
    // The arrow's height in path units, from the top edge to the tip.
    property <float> rise: self.top - self.s;

    viewbox-x: 0;
    viewbox-y: 0;
    viewbox-width: self.width / 1px;
    viewbox-height: self.height / 1px;
    fill: Theme.bg;
    stroke: Theme.border;
    stroke-width: 1px;

    MoveTo {
        x: root.ax - root.half - root.blend;
        y: root.top;
    }
    // Into the arrow's left side, tangent to the edge and to the side.
    QuadraticTo {
        control-x: root.ax - root.half;
        control-y: root.top;
        x: root.ax - root.half + root.blend;
        y: root.top - root.rise * root.blend / root.half;
    }
    LineTo {
        x: root.ax - root.half * root.round;
        y: root.s + root.rise * root.round;
    }
    // The rounded tip: its apex lies 1.25 below `s`, and the panel code
    // places the window by that (TIP_INSET).
    QuadraticTo {
        control-x: root.ax;
        control-y: root.s;
        x: root.ax + root.half * root.round;
        y: root.s + root.rise * root.round;
    }
    LineTo {
        x: root.ax + root.half - root.blend;
        y: root.top - root.rise * root.blend / root.half;
    }
    QuadraticTo {
        control-x: root.ax + root.half;
        control-y: root.top;
        x: root.ax + root.half + root.blend;
        y: root.top;
    }
    LineTo {
        x: root.w - root.r;
        y: root.top;
    }
    ArcTo {
        x: root.w;
        y: root.top + root.r;
        radius-x: root.r;
        radius-y: root.r;
        sweep: true;
    }
    LineTo {
        x: root.w;
        y: root.h - root.r;
    }
    ArcTo {
        x: root.w - root.r;
        y: root.h;
        radius-x: root.r;
        radius-y: root.r;
        sweep: true;
    }
    LineTo {
        x: root.s + root.r;
        y: root.h;
    }
    ArcTo {
        x: root.s;
        y: root.h - root.r;
        radius-x: root.r;
        radius-y: root.r;
        sweep: true;
    }
    LineTo {
        x: root.s;
        y: root.top + root.r;
    }
    ArcTo {
        x: root.s + root.r;
        y: root.top;
        radius-x: root.r;
        radius-y: root.r;
        sweep: true;
    }
    Close { }
}

export component SettingsPanel inherits Window {
    no-frame: true;
    always-on-top: true;
    background: transparent;
    title: "Vento settings";
    default-font-size: 13px;

    // vento is paused: the Pause item shows as on.
    in property <bool> paused;
    // Shown above Keep Awake when not empty.
    in property <string> notice;
    // Whether Copy from screen is available: the footer offers Copy text.
    in property <bool> screen-text-supported;

    // Keep Awake: the status line, whether anything is held, the running
    // chip (see KeepAwakeTab), and the time the Until… popup opens at.
    in property <string> awake-status;
    in property <bool> awake-on;
    in property <int> awake-chip: -1;
    in-out property <int> awake-until-hour;
    in-out property <int> awake-until-minute;
    callback awake-switched(bool);
    callback awake-chip-clicked(int);
    callback awake-until-started(int, int);

    callback pause-clicked();
    // Opens the Settings window.
    callback settings-clicked();
    callback quit-clicked();
    // Starts Copy from screen; shown where it is supported.
    callback copy-from-screen-clicked();
    // Done or Esc.
    callback close-requested();

    // Where the arrow on the top edge points: its centre, from the left
    // edge. vento sets it so the arrow points at the menu-bar icon.
    in property <length> arrow-x: self.width / 2;

    // Off while the panel is hidden; turned on right after it shows, so the
    // panel fades in and drops into place instead of popping up.
    in property <bool> revealed: true;
    property <float> reveal: self.revealed ? 1 : 0;
    animate reveal { duration: self.revealed ? 160ms : 0ms; easing: ease-out; }

    // The arrow's height above the body, and the body's corner radius (the
    // panel code relies on both, and on the arrow's width and blend).
    property <length> arrow-h: 10px;
    property <length> radius: 16px;

    // The height the window takes: the arrow above the height the panel's
    // content asks for.
    out property <length> window-height: self.arrow-h + layout.preferred-height;

    width: 340px;
    height: self.window-height;
    forward-focus: keys;

    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close-requested();
                return accept;
            }
            return reject;
        }

        PanelOutline {
            y: (root.reveal - 1) * 6px;
            opacity: root.reveal;
            width: parent.width;
            height: parent.height;
            arrow-x: root.arrow-x;
            arrow-h: root.arrow-h;
            radius: root.radius;
        }

        Rectangle {
            y: root.arrow-h + (root.reveal - 1) * 6px;
            opacity: root.reveal;
            height: parent.height - root.arrow-h;

            layout := VerticalLayout {
                padding: 12px;
                spacing: 12px;

                if root.notice != "": Notice {
                    text: root.notice;
                }

                KeepAwakeTab {
                    status: root.awake-status;
                    on: root.awake-on;
                    chip: root.awake-chip;
                    until-hour <=> root.awake-until-hour;
                    until-minute <=> root.awake-until-minute;
                    switched(on) => { root.awake-switched(on); }
                    chip-clicked(i) => { root.awake-chip-clicked(i); }
                    until-started(hour, minute) => { root.awake-until-started(hour, minute); }
                }

                Rectangle {
                    height: 1px;
                    background: Theme.separator;
                }

                // Close together: with Copy text they take the whole width.
                HorizontalLayout {
                    FooterItem {
                        icon: root.paused ? PanelIcons.resume : PanelIcons.pause;
                        label: "Pause";
                        toggleable: true;
                        toggled: root.paused;
                        clicked => { root.pause-clicked(); }
                    }

                    FooterItem {
                        icon: PanelIcons.general;
                        label: "Settings…";
                        clicked => { root.settings-clicked(); }
                    }

                    if root.screen-text-supported: FooterItem {
                        icon: PanelIcons.scan-text;
                        label: "Copy text";
                        clicked => { root.copy-from-screen-clicked(); }
                    }

                    FooterItem {
                        icon: PanelIcons.quit;
                        label: "Quit";
                        clicked => { root.quit-clicked(); }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }
                }

                // A row of its own: the footer items leave no room for it.
                HorizontalLayout {
                    alignment: end;

                    DoneButton {
                        clicked => { root.close-requested(); }
                    }
                }
            }
        }
    }
}
