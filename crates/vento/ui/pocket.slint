// The Pocket island: a black, frameless window at the top centre of the
// screen. The window always has the expanded size; the collapsed wings (or
// the pill on screens without a notch) are drawn inside it, and everything
// outside the drawn shape is transparent. In a right-to-left language
// everything inside the island is mirrored (the island itself stays where
// it is on the screen); its colours stay its own, whatever the theme.

import { Theme } from "theme.slint";
import { Icons } from "wheel.slint";

export struct PocketCell { name: string, icon: image, missing: bool, selected: bool }

// One entry of the clipboard history. `kind`: 0 text, 1 files, 2 link,
// 3 image; `thumb` is an image's thumbnail, empty when it can't be shown.
export struct ClipRow { id: int, kind: int, label: string, age: string, missing: bool, thumb: image, pinned: bool }

// One item of the Pocket list, by item id; `icon` is the one its cell shows.
export struct PocketRow { id: int, name: string, icon: image, missing: bool, selected: bool }

// One filter chip of the Pocket list: "All" or a kind's name, and how many
// items it lists.
export struct PocketChip { label: string, count: int }

// One stack of a full Pocket under the Stacks layout: its kind (by place in
// the app's fixed kind order), the kind's name and icon, and how many items
// it holds.
export struct PocketStack { kind: int, label: string, icon: image, count: int }

// A rounded rectangle outlined in dashes (Slint draws only solid borders):
// solid quarter arcs at the corners, dashes along the straight edges.
component DashedBox inherits Rectangle {
    in property <color> stroke;
    in property <length> thickness: 2px;
    in property <length> radius: 12px;
    property <length> dash: 6px;
    property <length> gap: 5px;
    property <length> step: self.dash + self.gap;
    property <length> run-w: self.width - 2 * self.radius;
    property <length> run-h: self.height - 2 * self.radius;
    property <int> nx: max(0, floor((self.run-w + self.gap) / self.step));
    property <int> ny: max(0, floor((self.run-h + self.gap) / self.step));
    // Dashes centred on each edge.
    property <length> ox: self.radius + (self.run-w - self.nx * self.step + self.gap) / 2;
    property <length> oy: self.radius + (self.run-h - self.ny * self.step + self.gap) / 2;

    border-radius: self.radius;

    for i in root.nx: Rectangle {
        x: root.ox + i * root.step;
        y: 0px;
        width: root.dash;
        height: root.thickness;
        background: root.stroke;
    }

    for i in root.nx: Rectangle {
        x: root.ox + i * root.step;
        y: root.height - root.thickness;
        width: root.dash;
        height: root.thickness;
        background: root.stroke;
    }

    for i in root.ny: Rectangle {
        x: 0px;
        y: root.oy + i * root.step;
        width: root.thickness;
        height: root.dash;
        background: root.stroke;
    }

    for i in root.ny: Rectangle {
        x: root.width - root.thickness;
        y: root.oy + i * root.step;
        width: root.thickness;
        height: root.dash;
        background: root.stroke;
    }

    for corner in [{ x: 0, y: 0 }, { x: 1, y: 0 }, { x: 0, y: 1 }, { x: 1, y: 1 }]: Rectangle {
        x: corner.x * (root.width - root.radius);
        y: corner.y * (root.height - root.radius);
        width: root.radius;
        height: root.radius;
        clip: true;

        Rectangle {
            x: -corner.x * root.radius;
            y: -corner.y * root.radius;
            width: 2 * root.radius;
            height: 2 * root.radius;
            border-radius: root.radius;
            border-width: root.thickness;
            border-color: root.stroke;
        }
    }

    @children
}

// Undo after a removal or a clear, with the time left (`left`, 1 to 0) as
// a ring and `secs` below it; `compact`, a smaller ring at the end with
// `secs` before it.
component UndoRing inherits Rectangle {
    in property <float> left;
    in property <int> secs;
    in property <bool> compact;
    callback clicked();

    property <color> item-fill: #1d1d21;
    property <color> accent: #ff6a1a;
    property <length> ring-d: root.compact ? 28px : 46px;
    property <length> stroke: root.compact ? 2px : 2.5px;

    height: root.compact ? root.ring-d : 68px;

    ring := Rectangle {
        x: !root.compact ? (parent.width - self.width) / 2 : (Theme.rtl ? 0px : parent.width - self.width);
        y: 0px;
        width: root.ring-d;
        height: root.ring-d;
        border-radius: root.ring-d / 2;
        background: undo-touch.has-hover ? root.item-fill : transparent;
        border-width: root.stroke;
        border-color: #ffffff22;

        property <float> left: min(max(root.left, 0.001), 0.999);
        property <angle> sweep: 360deg * self.left;
        // The arc's centre and radius in points: along the middle of the
        // border.
        property <float> c: root.ring-d / 2px;
        property <float> r: self.c - root.stroke / 2px;

        Path {
            width: root.ring-d;
            height: root.ring-d;
            viewbox-width: root.ring-d / 1px;
            viewbox-height: root.ring-d / 1px;
            stroke: root.accent;
            stroke-width: root.stroke;

            MoveTo {
                x: ring.c;
                y: ring.c - ring.r;
            }

            ArcTo {
                x: ring.c + ring.r * Math.sin(ring.sweep);
                y: ring.c - ring.r * Math.cos(ring.sweep);
                radius-x: ring.r;
                radius-y: ring.r;
                large-arc: ring.left > 0.5;
                sweep: true;
            }
        }

        Image {
            source: Theme.rtl ? Icons.undo-rtl : Icons.undo;
            colorize: root.accent;
            width: root.compact ? 14px : 22px;
            height: self.width;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }

    Text {
        x: root.compact && Theme.rtl ? ring.width + 5px : 0px;
        y: root.compact ? 0px : 50px;
        width: root.compact ? parent.width - ring.width - 5px : parent.width;
        height: root.compact ? root.ring-d : 16px;
        text: @tr("Undo {}s", root.secs);
        color: undo-touch.has-hover ? white : #ffffffb0;
        font-size: 11px;
        horizontal-alignment: !root.compact ? center : (Theme.rtl ? TextHorizontalAlignment.left : right);
        vertical-alignment: center;
    }

    undo-touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// One button of the bottom switch: an icon and a count, filled with the
// accent while its view is shown. `label` names it for VoiceOver only.
component SwitchButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <int> count;
    in property <bool> current;
    callback clicked();

    property <color> item-fill: #1d1d21;
    property <color> accent: #ff6a1a;

    height: 28px;
    border-radius: 14px;
    background: root.current ? root.accent : touch.has-hover ? #2c2c32 : root.item-fill;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => {
        root.clicked();
    }

    HorizontalLayout {
        padding-left: 11px;
        padding-right: 11px;
        spacing: 6px;

        VerticalLayout {
            layout-order: Theme.rtl ? 2 : 0;
            alignment: center;

            Image {
                source: root.icon;
                colorize: root.current ? white : #ffffffa8;
                width: 14px;
                height: 14px;
            }
        }

        Text {
            layout-order: Theme.rtl ? 1 : 0;
            horizontal-alignment: Theme.rtl ? right : left;
            text: root.count;
            color: root.current ? #ffffffb8 : #ffffff70;
            font-size: 12px;
            font-weight: 500;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// A scrollbar for a list that overflows (its Flickable's `content-h` and
// `offset`, as tall as the bar): the thumb shows how much is in view and
// where, and can be dragged.
component ListScrollbar inherits Rectangle {
    in property <length> content-h;
    in-out property <length> offset;

    property <length> overflow: root.content-h - root.height;
    property <length> thumb-h: max(24px, root.height * root.height / root.content-h);
    property <length> travel: root.height - root.thumb-h;
    property <length> drag-from;

    width: 4px;

    Rectangle {
        y: root.overflow > 0 ? -root.offset / root.overflow * root.travel : 0;
        width: parent.width;
        height: root.thumb-h;
        border-radius: 2px;
        background: thumb.pressed || thumb.has-hover ? #ffffff73 : #ffffff38;

        thumb := TouchArea {
            // A little wider than the thumb, so it is easy to grab.
            x: -4px;
            width: parent.width + 8px;
            pointer-event(e) => {
                if e.kind == PointerEventKind.down {
                    root.drag-from = -root.offset;
                }
            }
            moved => {
                if self.pressed && root.travel > 0 {
                    root.offset = -max(0px, min(root.overflow,
                        root.drag-from + (self.mouse-y - self.pressed-y) * root.overflow / root.travel));
                }
            }
        }
    }
}

// The same bar lying under a strip that scrolls sideways (its Flickable's
// `content-w` and `offset`, as wide as the bar). The offset is only read:
// a drag reports where it wants the strip with `scrolled`, so the strip's
// own position keeps no binding and its Flickable keeps it in bounds as
// items come and go.
component StripScrollbar inherits Rectangle {
    in property <length> content-w;
    in property <length> offset;
    callback scrolled(length);

    property <length> overflow: root.content-w - root.width;
    property <length> thumb-w: max(24px, root.width * root.width / root.content-w);
    property <length> travel: root.width - root.thumb-w;
    property <length> drag-from;

    height: 4px;

    Rectangle {
        x: root.overflow > 0 ? -root.offset / root.overflow * root.travel : 0;
        width: root.thumb-w;
        height: parent.height;
        border-radius: 2px;
        background: thumb.pressed || thumb.has-hover ? #ffffff73 : #ffffff38;

        thumb := TouchArea {
            // A little taller than the thumb, so it is easy to grab.
            y: -4px;
            height: parent.height + 8px;
            pointer-event(e) => {
                if e.kind == PointerEventKind.down {
                    root.drag-from = -root.offset;
                }
            }
            moved => {
                if self.pressed && root.travel > 0 {
                    root.scrolled(-max(0px, min(root.overflow,
                        root.drag-from + (self.mouse-x - self.pressed-x) * root.overflow / root.travel)));
                }
            }
        }
    }
}

// One filter of the Clipboard view: an icon and how many rows it lists,
// filled with the accent while it is chosen. `label` names it for VoiceOver
// only.
component FilterButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <int> count;
    in property <bool> current;
    callback clicked();

    height: 24px;
    border-radius: 12px;
    background: root.current ? #ff6a1a : touch.has-hover ? #2c2c32 : #1d1d21;
    accessible-role: button;
    accessible-label: @tr("{} {n}" | "{} {n}" % root.count, root.label);
    accessible-action-default => {
        root.clicked();
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 5px;

        VerticalLayout {
            layout-order: Theme.rtl ? 2 : 0;
            alignment: center;

            Image {
                source: root.icon;
                colorize: root.current ? white : #ffffffa8;
                width: 12px;
                height: 12px;
            }
        }

        Text {
            layout-order: Theme.rtl ? 1 : 0;
            horizontal-alignment: Theme.rtl ? right : left;
            text: root.count;
            color: root.current ? white : #ffffff80;
            font-size: 11px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// A Flickable that scrolls sideways, its content laid out from the start of
// the line within `span`: from the left, or from the right in a
// right-to-left language. It opens at the content's start (`start-x`), and
// `to-start` goes back there. In a right-to-left language content that
// grows grows at the left of `span`, so the view moves with it and what is
// in view stays still, as it does when content grows at the right of a
// left-to-right row. The view is a plain value, not a binding: the
// Flickable itself writes it when a trackpad scrolls it.
component SideFlickable inherits Flickable {
    // The width the content is laid out in: the Flickable's, or the
    // content's when it is wider.
    out property <length> span: max(self.width, self.content-width);
    // The view at the content's start.
    out property <length> start-x: Theme.rtl ? min(0px, self.width - self.content-width) : 0px;
    // `span` as the view last followed it.
    property <length> seen-span;
    property <bool> rtl: Theme.rtl;

    public function to-start() {
        self.seen-span = self.span;
        self.content-x = self.start-x;
    }

    init => {
        self.to-start();
    }
    changed rtl => {
        self.to-start();
    }
    changed span => {
        if (self.rtl) {
            self.content-x = max(self.width - self.content-width,
                min(0px, self.content-x - (self.span - self.seen-span)));
        }
        self.seen-span = self.span;
    }
}

// A row of chips (its children), scrolling sideways when they don't fit, by
// trackpad or by a mouse wheel's vertical scroll. The chips start at the
// start of the line: in a right-to-left language at the right, scrolled to
// the right end, and give each a `layout-order` that reverses them.
component ChipRow inherits Rectangle {
    flick := SideFlickable {
        width: root.width;
        height: root.height;
        interactive: false;
        content-width: chips-layout.preferred-width;

        TouchArea {
            width: flick.span;
            height: flick.height;
            scroll-event(e) => {
                if e.delta-x == 0 && e.delta-y != 0 && flick.content-width > flick.width {
                    flick.content-x = max(flick.width - flick.content-width, min(0px, flick.content-x + (Theme.rtl ? -e.delta-y : e.delta-y)));
                    return accept;
                }
                return reject;
            }

            chips-layout := HorizontalLayout {
                alignment: Theme.rtl ? end : start;
                spacing: 4px;

                @children
            }
        }
    }
}

// A round Clear button with a trash can, `width` across.
component ClearButton inherits Rectangle {
    in property <length> icon-size: 14px;
    callback clicked();

    height: self.width;
    border-radius: self.width / 2;
    background: touch.has-hover ? #2c2c32 : #1d1d21;
    accessible-role: button;
    accessible-label: @tr("Clear");
    accessible-action-default => {
        root.clicked();
    }

    Image {
        source: Icons.trash;
        colorize: touch.has-hover ? #ff7b72 : #ffffffa0;
        width: root.icon-size;
        height: self.width;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// The Clipboard view: the filters in a row on top, and under them the
// history as a list, pinned entries first, then newest on top. Clear (or
// Undo) is in the bottom bar under it.
component ClipList inherits Rectangle {
    // The rows the chosen filter lists.
    in property <[ClipRow]> rows;
    // The chosen filter (0 All, 1 Pinned, 2 Text, 3 Links, 4 Images,
    // 5 Files) and how many rows each lists; the first is the whole history.
    in property <int> filter;
    in property <[int]> counts;
    // All by entry id.
    callback pressed(int);
    callback pocket(int);
    callback pin(int, bool);
    callback remove(int);
    callback filter-chosen(int);

    property <color> item-fill: #1d1d21;
    property <color> accent: #ff6a1a;
    property <length> pad: 14px;
    property <length> row-h: 36px;
    property <length> head-h: 24px;
    // The filters' names, in the order of `counts`, for VoiceOver.
    property <[string]> filter-names: [@tr("All"), @tr("Pinned"), @tr("Text"), @tr("Links"), @tr("Images"), @tr("Files")];

    ChipRow {
        x: root.pad;
        y: 8px;
        width: parent.width - 2 * root.pad;
        height: root.head-h;

        for f[i] in [Icons.clipboard, Icons.pin, Icons.text, Icons.copy-path, Icons.photo, Icons.file]: FilterButton {
            layout-order: Theme.rtl ? -i : 0;
            icon: f;
            label: root.filter-names[i];
            count: root.counts[i];
            current: root.filter == i;
            clicked => {
                root.filter-chosen(i);
            }
        }
    }

    list := Flickable {
        x: root.pad;
        y: 8px + root.head-h + 6px;
        width: parent.width - 2 * root.pad;
        height: parent.height - self.y - 8px;
        // Presses belong to the rows; the list scrolls by wheel only.
        interactive: false;
        content-height: root.rows.length * root.row-h;

        for row[i] in root.rows: Rectangle {
            y: i * root.row-h;
            height: root.row-h;
            width: list.width;
            border-radius: 10px;
            background: touch.has-hover && !row.missing ? root.item-fill : transparent;

            touch := TouchArea {
                // A missing entry has nothing to put back.
                clicked => {
                    if !row.missing {
                        root.pressed(row.id);
                    }
                }

                Rectangle {
                    opacity: row.missing ? 0.4 : 1.0;

                    Rectangle {
                        x: Theme.rtl ? parent.width - self.width - 4px : 4px;
                        y: (parent.height - self.height) / 2;
                        width: 28px;
                        height: 28px;
                        border-radius: 7px;
                        background: touch.has-hover && !row.missing ? #2c2c32 : root.item-fill;
                        clip: true;

                        // An image's thumbnail, once it could be loaded.
                        if row.kind == 3 && row.thumb.width > 0: Image {
                            source: row.thumb;
                            width: parent.width;
                            height: parent.height;
                            image-fit: cover;
                        }

                        if row.kind != 3 || row.thumb.width == 0: Image {
                            source: row.kind == 0 ? Icons.text : row.kind == 1 ? Icons.file : row.kind == 2 ? Icons.copy-path : Icons.photo;
                            colorize: #ffffffc0;
                            width: 16px;
                            height: 16px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    Text {
                        // Room left at the end for the age (and pin), or the buttons.
                        property <length> end-room: touch.has-hover ? actions.width + 12px : row.pinned ? 70px : 50px;
                        x: Theme.rtl ? self.end-room : 42px;
                        width: parent.width - 42px - self.end-room;
                        horizontal-alignment: Theme.rtl ? right : left;
                        text: row.label;
                        color: #e6e6e6;
                        font-size: 13px;
                        overflow: elide;
                        wrap: no-wrap;
                        vertical-alignment: center;
                    }

                    if !touch.has-hover: Text {
                        x: Theme.rtl ? 8px : parent.width - self.width - 8px;
                        width: 36px;
                        text: row.age;
                        color: #ffffff70;
                        font-size: 11px;
                        horizontal-alignment: Theme.rtl ? left : right;
                        vertical-alignment: center;
                    }

                    // Pinned: a pin beside the age. On hover the pin button
                    // takes its place.
                    if !touch.has-hover && row.pinned: Image {
                        source: Icons.pin;
                        colorize: root.accent;
                        width: 13px;
                        height: 13px;
                        x: Theme.rtl ? 8px + 36px + 6px : parent.width - 8px - 36px - 6px - self.width;
                        y: (parent.height - self.height) / 2;
                    }
                }

                // Children of the row's TouchArea, so hovering them keeps the
                // row hovered, and they take the press before it does.
                actions := Rectangle {
                    x: Theme.rtl ? 6px : parent.width - self.width - 6px;
                    y: (parent.height - self.height) / 2;
                    width: row.missing ? 54px : 84px;
                    height: 24px;
                    visible: touch.has-hover;

                    // Pins the entry (kept until removed by hand) or unpins
                    // it; filled with the accent while pinned.
                    Rectangle {
                        x: Theme.rtl ? parent.width - self.width : 0px;
                        width: 24px;
                        height: 24px;
                        border-radius: 12px;
                        background: row.pinned
                            ? (pin-touch.has-hover ? #ff8a45 : root.accent)
                            : (pin-touch.has-hover ? #55555c : #3a3a40);

                        Image {
                            source: Icons.pin;
                            colorize: white;
                            width: 12px;
                            height: 12px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }

                        pin-touch := TouchArea {
                            clicked => {
                                root.pin(row.id, !row.pinned);
                            }
                        }
                    }

                    // Adds the entry to the Pocket.
                    if !row.missing: Rectangle {
                        x: Theme.rtl ? parent.width - self.width - 30px : 30px;
                        width: 24px;
                        height: 24px;
                        border-radius: 12px;
                        background: pocket-touch.has-hover ? #55555c : #3a3a40;
                        accessible-role: button;
                        accessible-label: @tr("Add to Pocket");

                        Image {
                            source: Icons.pocket;
                            colorize: white;
                            width: 12px;
                            height: 12px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }

                        pocket-touch := TouchArea {
                            clicked => {
                                root.pocket(row.id);
                            }
                        }
                    }

                    Rectangle {
                        x: Theme.rtl ? 0px : parent.width - self.width;
                        width: 24px;
                        height: 24px;
                        border-radius: 12px;
                        background: remove-touch.has-hover ? #55555c : #3a3a40;

                        Image {
                            source: Icons.remove;
                            colorize: white;
                            width: 10px;
                            height: 10px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }

                        remove-touch := TouchArea {
                            clicked => {
                                root.remove(row.id);
                            }
                        }
                    }
                }
            }
        }
    }

    // A scrollbar in the gap beside the list, once the rows overflow it.
    if list.content-height > list.height: ListScrollbar {
        x: Theme.rtl ? list.x - 3px - self.width : list.x + list.width + 3px;
        y: list.y;
        height: list.height;
        content-h: list.content-height;
        offset <=> list.content-y;
    }

    if root.rows.length == 0: Text {
        x: list.x;
        y: list.y;
        width: list.width;
        height: list.height;
        text: root.filter == 0
            ? @tr("Copy something and it shows up here")
            : root.filter == 1 ? @tr("Pin a copy to keep it here") : @tr("Nothing of this kind yet");
        color: #ffffff66;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// The Pocket's column beside its items: "Drag all" with the item count and
// Clear below it, or, after a removal or a clear, Undo with the time left.
// `compact`, the same side by side and smaller, at the end of the bottom
// bar.
component PocketSide inherits Rectangle {
    in property <bool> compact;
    in property <int> count;
    in property <bool> undo-active;
    in property <float> undo-left;
    in property <int> undo-secs;
    // `all-moved` offsets are measured from the press point.
    callback all-pressed();
    callback all-moved(length, length);
    callback all-released();
    callback clear();
    callback undo();

    property <color> accent: #ff6a1a;
    property <length> clear-d: root.compact ? 28px : 30px;

    width: root.compact ? 80px : 52px;
    height: root.compact ? 28px : 80px;

    if root.count > 0 && !root.undo-active: Rectangle {
        Rectangle {
            x: !root.compact ? (parent.width - self.width) / 2
                : (Theme.rtl ? root.clear-d + 6px : parent.width - root.clear-d - 6px - self.width);
            y: 0px;
            width: root.compact ? 28px : 42px;
            height: self.width;
            border-radius: self.width / 2;
            background: all-touch.pressed ? #e55a10 : root.accent;

            Image {
                source: Icons.grab;
                colorize: white;
                width: root.compact ? 14px : 20px;
                height: self.width;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            Rectangle {
                width: root.count > 99 ? self.height + 10px : root.count > 9 ? self.height + 6px : self.height;
                height: root.compact ? 14px : 18px;
                // The count, on the button's top corner at the end.
                x: Theme.rtl ? -(root.compact ? 3px : 4px) : parent.width - self.width + (root.compact ? 3px : 4px);
                y: root.compact ? -3px : -4px;
                border-radius: self.height / 2;
                background: white;

                Text {
                    text: root.count > 99 ? "99+" : root.count;
                    color: black;
                    font-size: root.compact ? 9px : 11px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            all-touch := TouchArea {
                pointer-event(e) => {
                    if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                        root.all-pressed();
                    } else if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left)
                        || e.kind == PointerEventKind.cancel {
                        root.all-released();
                    }
                }
                moved => {
                    if self.pressed {
                        root.all-moved(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
                    }
                }
            }
        }

        ClearButton {
            x: !root.compact ? (parent.width - self.width) / 2 : (Theme.rtl ? 0px : parent.width - self.width);
            y: root.compact ? 0px : 50px;
            width: root.clear-d;
            icon-size: root.compact ? 14px : 16px;
            clicked => {
                root.clear();
            }
        }
    }

    if root.undo-active: UndoRing {
        y: root.compact ? 0px : 6px;
        width: parent.width;
        compact: root.compact;
        left: root.undo-left;
        secs: root.undo-secs;
        clicked => {
            root.undo();
        }
    }
}

// One filter chip of the Pocket list: "All" or a kind's name, and how many
// items it lists, filled with the accent while it is chosen.
component KindChip inherits Rectangle {
    in property <string> label;
    in property <int> count;
    in property <bool> current;
    callback clicked();

    height: 24px;
    border-radius: 12px;
    background: root.current ? #ff6a1a : touch.has-hover ? #2c2c32 : #1d1d21;
    accessible-role: button;
    accessible-label: @tr("{} {n}" | "{} {n}" % root.count, root.label);
    accessible-action-default => {
        root.clicked();
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 5px;

        Text {
            layout-order: Theme.rtl ? 2 : 0;
            horizontal-alignment: Theme.rtl ? right : left;
            text: root.label;
            color: root.current ? white : #ffffffc0;
            font-size: 11px;
            font-weight: 600;
            vertical-alignment: center;
        }

        Text {
            layout-order: Theme.rtl ? 1 : 0;
            horizontal-alignment: Theme.rtl ? right : left;
            text: root.count;
            color: root.current ? #ffffffc0 : #ffffff70;
            font-size: 11px;
            font-weight: 500;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// The Pocket list: every item the Pocket holds, one row each in Pocket
// order, with a back control and the filter chips above it and the Pocket's
// column ("Drag all" and Clear, or Undo) beside it unless the bottom bar
// holds those (`side` off).
component PocketList inherits Rectangle {
    in property <bool> side: true;
    // The rows the chosen chip lists.
    in property <[PocketRow]> rows;
    // "All", then one chip per kind present; `filter` is the chosen one.
    in property <[PocketChip]> chips;
    in property <int> filter;
    // Every item, for the column's "Drag all".
    in property <int> count;
    in property <bool> undo-active;
    in property <float> undo-left;
    in property <int> undo-secs;
    // Rows by item id; `moved` offsets are measured from the press point.
    callback pressed(int);
    callback moved(int, length, length);
    callback released(int);
    callback remove(int);
    callback filter-chosen(int);
    callback back();
    callback all-pressed();
    callback all-moved(length, length);
    callback all-released();
    callback clear();
    callback undo();

    property <color> item-fill: #1d1d21;
    property <color> accent: #ff6a1a;
    property <length> pad: 14px;
    property <length> side-w: 52px;
    property <length> row-h: 36px;
    property <length> head-h: 24px;

    // Back to the cells.
    back-button := Rectangle {
        x: Theme.rtl ? list.x + list.width - self.width : root.pad;
        y: 8px;
        width: 74px;
        height: root.head-h;
        border-radius: 12px;
        background: back-touch.has-hover ? #2c2c32 : root.item-fill;
        accessible-role: button;
        accessible-label: @tr("Back to Pocket");
        accessible-action-default => {
            root.back();
        }

        Image {
            source: Theme.rtl ? Icons.back-rtl : Icons.back;
            colorize: back-touch.has-hover ? white : #ffffffc0;
            width: 14px;
            height: 14px;
            x: Theme.rtl ? parent.width - self.width - 7px : 7px;
            y: (parent.height - self.height) / 2;
        }

        Text {
            x: Theme.rtl ? 8px : 23px;
            width: parent.width - 23px - 8px;
            horizontal-alignment: Theme.rtl ? right : left;
            text: @tr("Pocket");
            color: back-touch.has-hover ? white : #ffffffc0;
            font-size: 11px;
            font-weight: 600;
            vertical-alignment: center;
        }

        back-touch := TouchArea {
            clicked => {
                root.back();
            }
        }
    }

    // The chips, scrolling sideways when they don't fit.
    ChipRow {
        x: Theme.rtl ? list.x : back-button.x + back-button.width + 6px;
        y: 8px;
        width: list.width - back-button.width - 6px;
        height: root.head-h;

        for chip[i] in root.chips: KindChip {
            layout-order: Theme.rtl ? -i : 0;
            label: chip.label;
            count: chip.count;
            current: root.filter == i;
            clicked => {
                root.filter-chosen(i);
            }
        }
    }

    list := Flickable {
        x: Theme.rtl ? parent.width - root.pad - self.width : root.pad;
        y: 8px + root.head-h + 6px;
        width: parent.width - 2 * root.pad - (root.side ? root.side-w + 10px : 0px);
        height: parent.height - self.y - 8px;
        // Presses belong to the rows; the list scrolls by wheel only.
        interactive: false;
        content-height: root.rows.length * root.row-h;

        for row[i] in root.rows: Rectangle {
            y: i * root.row-h;
            height: root.row-h;
            width: list.width;
            border-radius: 10px;
            background: row.selected ? #ff6a1a2e : touch.has-hover ? root.item-fill : transparent;
            border-width: row.selected ? 1.5px : 0px;
            border-color: root.accent;

            touch := TouchArea {
                // As a cell's: a press drags the item (or the selection it is
                // part of) out, a click selects it.
                pointer-event(e) => {
                    if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                        root.pressed(row.id);
                    } else if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left)
                        || e.kind == PointerEventKind.cancel {
                        root.released(row.id);
                    }
                }
                moved => {
                    if self.pressed {
                        root.moved(row.id, self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
                    }
                }

                Rectangle {
                    opacity: row.missing ? 0.4 : 1.0;

                    if !row.missing: Image {
                        source: row.icon;
                        x: Theme.rtl ? parent.width - self.width - 6px : 6px;
                        y: (parent.height - self.height) / 2;
                        width: 24px;
                        height: 24px;
                    }

                    if row.missing: Image {
                        source: row.icon;
                        colorize: white;
                        x: Theme.rtl ? parent.width - self.width - 6px : 6px;
                        y: (parent.height - self.height) / 2;
                        width: 24px;
                        height: 24px;
                    }

                    Text {
                        // Room left at the end, for the x on hover.
                        property <length> end-room: touch.has-hover ? 40px : 12px;
                        x: Theme.rtl ? self.end-room : 40px;
                        width: parent.width - 40px - self.end-room;
                        horizontal-alignment: Theme.rtl ? right : left;
                        text: row.name;
                        color: #e6e6e6;
                        font-size: 13px;
                        overflow: elide;
                        wrap: no-wrap;
                        vertical-alignment: center;
                    }
                }

                if row.missing: Image {
                    source: Icons.missing;
                    colorize: #ffcc33;
                    x: Theme.rtl ? parent.width - self.width - 20px : 20px;
                    y: parent.height / 2;
                    width: 12px;
                    height: 12px;
                }

                // A child of the row's TouchArea, so hovering it keeps the
                // row hovered, and it takes the press before the row does.
                if touch.has-hover: Rectangle {
                    x: Theme.rtl ? 6px : parent.width - self.width - 6px;
                    y: (parent.height - self.height) / 2;
                    width: 24px;
                    height: 24px;
                    border-radius: 12px;
                    background: remove-touch.has-hover ? #55555c : #3a3a40;
                    accessible-role: button;
                    accessible-label: @tr("Remove");
                    accessible-action-default => {
                        root.remove(row.id);
                    }

                    Image {
                        source: Icons.remove;
                        colorize: white;
                        width: 10px;
                        height: 10px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }

                    remove-touch := TouchArea {
                        clicked => {
                            root.remove(row.id);
                        }
                    }
                }
            }
        }
    }

    // A scrollbar in the gap beside the list, once the rows overflow it.
    if list.content-height > list.height: ListScrollbar {
        x: Theme.rtl ? list.x - 3px - self.width : list.x + list.width + 3px;
        y: list.y;
        height: list.height;
        content-h: list.content-height;
        offset <=> list.content-y;
    }

    // "Drag all" and Clear at the foot of the column.
    if root.side: PocketSide {
        x: Theme.rtl ? root.pad : parent.width - root.pad - root.side-w;
        y: parent.height - self.height - 8px;
        count: root.count;
        undo-active: root.undo-active;
        undo-left: root.undo-left;
        undo-secs: root.undo-secs;
        all-pressed => {
            root.all-pressed();
        }
        all-moved(dx, dy) => {
            root.all-moved(dx, dy);
        }
        all-released => {
            root.all-released();
        }
        clear => {
            root.clear();
        }
        undo => {
            root.undo();
        }
    }
}

export component PocketIsland inherits Window {
    no-frame: true;
    always-on-top: true;
    background: transparent;

    in property <bool> expanded;
    // The island's screen has a notch: collapsed, it grows wings beside it.
    in property <bool> notch-style;
    in property <length> notch-w;
    // Height of the menu bar (or the notch, if taller).
    in property <length> top-h;
    // The pointer rests on the collapsed island where it sits in a top bar
    // (GNOME): it lights up as the bar's own buttons do.
    in property <bool> bar-hover;
    // At most eight, but every item under the Scroll layout, and none while
    // `stacks` stand in for them; `count` is the total, so the rest show as
    // "All N" (opening the Pocket list) under the List layout.
    in property <[PocketCell]> cells;
    in property <int> count;
    // Under the Stacks layout, a full Pocket's stacks, one per kind present;
    // empty otherwise.
    in property <[PocketStack]> stacks;
    // How a Pocket of more than eight items is laid out: 0 List, 1 Scroll,
    // 2 Stacks.
    in property <int> layout;
    // A drag hovers over the island.
    in property <bool> hint;
    // The expanded width: wide enough for the cells shown (set by the app).
    in property <length> panel-w: 420px;
    // Undo is offered for a removal or a clear; `undo-left` is the share
    // of its time still left (1 to 0), `undo-secs` the seconds.
    in property <bool> undo-active;
    in property <float> undo-left;
    in property <int> undo-secs;
    // What the offered Undo puts back: 0 Pocket items, 1 history entries.
    // Each view shows the ring only for its own; collapsed, both read "Undo".
    in property <int> undo-kind;
    // What a clear took, shown faded while its Undo is offered.
    in property <[PocketCell]> ghosts;
    // The view shown expanded: 0 the Pocket, 1 the Clipboard, 2 the Pocket
    // list.
    in property <int> view;
    // The clipboard history is on: the bar switching views is drawn under
    // either one.
    in property <bool> show-switch;
    // The history, newest first, and how many entries it holds.
    in property <[ClipRow]> clip-rows;
    in property <int> clip-count;
    // The Clipboard view's filter (0 All, 1 Pinned, 2 Text, 3 Links,
    // 4 Images, 5 Files) and how many entries each lists.
    in property <int> clip-filter;
    in property <[int]> clip-filter-counts: [0, 0, 0, 0, 0, 0];
    // The Pocket list's rows, its chips ("All", then each kind present) and
    // the chosen chip.
    in property <[PocketRow]> list-rows;
    in property <[PocketChip]> list-chips;
    in property <int> list-filter;
    // Height of what is drawn below the menu bar (set by the app).
    in property <length> panel-h: 112px;
    // Collapsed with an empty Pocket but some history: the wings show the
    // clipboard icon and no count.
    in property <bool> clip-wing;

    // `moved` offsets are measured from the press point.
    callback item-pressed(int);
    callback item-moved(int, length, length);
    callback item-released(int);
    // A press on cell `index` at this window-local point, with the left
    // button or not: true if it opens the cell's menu (a right press, or a
    // Control-click), which the press then does nothing else for.
    callback item-context(int, length, length, bool) -> bool;
    callback all-pressed();
    callback all-moved(length, length);
    callback all-released();
    callback remove(int);
    callback clear();
    callback undo();
    // A switch button: the view to show.
    callback view-chosen(int);
    // The Clipboard view, by entry id: a row clicked, its Pocket and x
    // buttons; and its Clear.
    callback clip-pressed(int);
    callback clip-pocket(int);
    // Entry id, and whether it is to be pinned (or unpinned).
    callback clip-pin(int, bool);
    callback clip-remove(int);
    callback clip-clear();
    callback clip-filter-chosen(int);
    // "All N": shows the Pocket list.
    callback list-open();
    // The Pocket list, by item id: a row pressed, moved (from the press
    // point) and released, its x; a chip chosen (0 All, then the kinds in
    // the order shown); and its back control.
    callback list-pressed(int);
    callback list-moved(int, length, length);
    callback list-released(int);
    callback list-remove(int);
    callback list-filter-chosen(int);
    callback list-back();
    // A stack, by its kind: pressed, moved (from the press point) and
    // released, as a cell is; a click opens the Pocket list on its kind.
    callback stack-pressed(int);
    callback stack-moved(int, length, length);
    callback stack-released(int);

    width: root.panel-w;
    height: root.top-h + root.panel-h;

    property <color> item-fill: #1d1d21;
    property <color> accent: #ff6a1a;
    property <length> wing: 44px;
    property <length> cell-step: 68px;
    property <length> pad: 14px;
    property <length> side-w: 52px;
    // Room the Pocket's rows leave at the right for its column, which the
    // bottom bar holds instead while it shows.
    property <length> side-room: root.show-switch ? 0px : root.side-w + 10px;

    property <length> collapsed-w: root.notch-style ? root.notch-w + 2 * root.wing : 120px;
    property <length> collapsed-h: root.notch-style ? root.top-h : 28px;
    property <length> collapsed-y: root.notch-style ? 0px : root.top-h + 4px;
    property <length> pill-r: root.notch-style ? 0px : 14px;
    property <bool> pocket-undo: root.undo-active && root.undo-kind == 0;
    property <bool> clip-undo: root.undo-active && root.undo-kind == 1;

    island := Rectangle {
        width: root.expanded ? root.width : root.collapsed-w;
        height: root.expanded ? root.height : root.collapsed-h;
        x: (root.width - self.width) / 2;
        y: root.expanded ? 0px : root.collapsed-y;
        animate width, height, y { duration: 160ms; easing: ease-out; }

        background: root.bar-hover && !root.expanded ? #2b2b2b : #000000;
        animate background { duration: 120ms; }
        clip: true;
        border-top-left-radius: root.expanded ? 0px : root.pill-r;
        border-top-right-radius: root.expanded ? 0px : root.pill-r;
        border-bottom-left-radius: root.expanded ? 18px : (root.notch-style ? 10px : 14px);
        border-bottom-right-radius: self.border-bottom-left-radius;

        // Collapsed: the stack icon on the left, the item count on the right
        // (the other way round in a right-to-left language);
        // with an empty Pocket but some history, the clipboard icon alone;
        // while Undo is offered, an undo arrow and "Undo", and a click undoes.
        if !root.expanded: Rectangle {
            if root.undo-active: TouchArea {
                clicked => {
                    root.undo();
                }
            }

            Image {
                property <length> ltr-x: root.notch-style ? (root.wing - self.width) / 2
                    : root.clip-wing && !root.undo-active ? (parent.width - self.width) / 2 : 12px;
                source: !root.undo-active ? (root.clip-wing ? Icons.clipboard : Icons.pocket)
                    : (Theme.rtl ? Icons.undo-rtl : Icons.undo);
                colorize: root.undo-active ? root.accent : white;
                width: 16px;
                height: 16px;
                x: Theme.rtl ? parent.width - self.width - self.ltr-x : self.ltr-x;
                y: (parent.height - self.height) / 2;
            }

            if root.undo-active || !root.clip-wing: Text {
                text: root.undo-active ? @tr("Undo") : root.count;
                color: root.undo-active ? root.accent : white;
                font-size: root.undo-active ? 11px : 13px;
                font-weight: 600;
                width: root.notch-style ? root.wing : 40px;
                x: Theme.rtl ? (root.notch-style ? 0px : 4px) : parent.width - self.width - (root.notch-style ? 0px : 4px);
                height: parent.height;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Expanded: fixed in window coordinates while the island grows around it.
        if root.expanded: Rectangle {
            x: (parent.width - root.width) / 2;
            y: root.top-h - parent.y;
            width: root.width;
            height: root.panel-h;

            // The Pocket view.
            if root.view == 0: Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: 112px;

                row := SideFlickable {
                    // Under Scroll, a full Pocket's strip of every item (or of
                    // a clear's faded items while its Undo is offered, as long
                    // as nothing new came in: those are shown only in an empty
                    // Pocket).
                    property <bool> strip: root.layout == 1 && (root.count == 0 ? root.ghosts.length : root.count) > 8;
                    // The strip starts at the first item whenever the Pocket
                    // fills up or drops to eight or fewer (a clear included),
                    // or the layout changes. A collapse starts the row afresh
                    // anyway.
                    property <bool> full-scroll: root.layout == 1 && root.count > 8;


                    x: Theme.rtl ? root.pad + root.side-room : root.pad;
                    y: 16px;
                    width: parent.width - 2 * root.pad - root.side-room;
                    height: 80px;
                    // Pointer drags belong to the cells; the row scrolls by wheel only.
                    interactive: false;
                    content-width: root.stacks.length > 0 ? root.stacks.length * root.cell-step
                        : max(root.cells.length, root.count == 0 ? root.ghosts.length : 0) * root.cell-step
                        + (root.count > root.cells.length && root.layout == 0 ? 48px : 0px);

                    changed full-scroll => {
                        self.to-start();
                    }

                    // Behind the cells, so it gets the wheel events they let
                    // through: the strip also scrolls with a mouse wheel's
                    // vertical scroll (a trackpad's sideways swipe already
                    // scrolls it).
                    if row.strip: TouchArea {
                        width: max(row.width, row.content-width);
                        height: row.height;
                        scroll-event(e) => {
                            if e.delta-x == 0 && e.delta-y != 0 && row.content-width > row.width {
                                row.content-x = max(row.width - row.content-width, min(0px, row.content-x + (Theme.rtl ? -e.delta-y : e.delta-y)));
                                return accept;
                            }
                            return reject;
                        }
                    }

                    // A clear's items, faded, until its Undo is gone.
                    if root.count == 0: Rectangle {
                        opacity: 0.35;

                        for ghost[i] in root.ghosts: Rectangle {
                            x: Theme.rtl ? row.span - i * root.cell-step - self.width : i * root.cell-step;
                            width: 64px;
                            height: 80px;
                            border-radius: 12px;
                            background: root.item-fill;

                            Image {
                                source: ghost.icon;
                                x: 12px;
                                y: 8px;
                                width: 40px;
                                height: 40px;
                            }

                            Text {
                                text: ghost.name;
                                x: 4px;
                                y: 54px;
                                width: 56px;
                                height: 18px;
                                color: white;
                                font-size: 11px;
                                overflow: elide;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    for cell[i] in root.cells: Rectangle {
                        x: Theme.rtl ? row.span - i * root.cell-step - self.width : i * root.cell-step;
                        width: 64px;
                        height: 80px;
                        border-radius: 12px;
                        background: root.item-fill;
                        border-width: cell.selected ? 2px : 0px;
                        border-color: root.accent;

                        Rectangle {
                            opacity: cell.missing ? 0.4 : 1.0;

                            if !cell.missing: Image {
                                source: cell.icon;
                                x: 12px;
                                y: 8px;
                                width: 40px;
                                height: 40px;
                            }

                            if cell.missing: Image {
                                source: cell.icon;
                                colorize: white;
                                x: 12px;
                                y: 8px;
                                width: 40px;
                                height: 40px;
                            }

                            Text {
                                text: cell.name;
                                x: 4px;
                                y: 54px;
                                width: 56px;
                                height: 18px;
                                color: white;
                                font-size: 11px;
                                overflow: elide;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        if cell.missing: Image {
                            source: Icons.missing;
                            colorize: #ffcc33;
                            x: Theme.rtl ? parent.width - self.width - 40px : 40px;
                            y: 32px;
                            width: 16px;
                            height: 16px;
                        }

                        touch := TouchArea {
                            pointer-event(e) => {
                                // A menu press is never a drag, a selection or a hover change.
                                if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                                    if !root.item-context(i, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, true) {
                                        root.item-pressed(i);
                                    }
                                } else if e.kind == PointerEventKind.down && e.button == PointerEventButton.right
                                    && !self.pressed {
                                    root.item-context(i, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, false);
                                } else if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left)
                                    || e.kind == PointerEventKind.cancel {
                                    root.item-released(i);
                                }
                            }
                            moved => {
                                if self.pressed {
                                    root.item-moved(i, self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
                                }
                            }

                            // A child of the cell's TouchArea, so hovering it keeps the cell hovered.
                            if touch.has-hover: Rectangle {
                                x: Theme.rtl ? 2px : parent.width - self.width - 2px;
                                y: 2px;
                                width: 18px;
                                height: 18px;
                                border-radius: 9px;
                                background: remove-touch.has-hover ? #55555c : #3a3a40;

                                Image {
                                    source: Icons.remove;
                                    colorize: white;
                                    width: 10px;
                                    height: 10px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }

                                remove-touch := TouchArea {
                                    // This press opened the menu (a Control-click): no removal.
                                    property <bool> menu-press;

                                    clicked => {
                                        if !self.menu-press {
                                            root.remove(i);
                                        }
                                    }
                                    // The x takes the press before its cell does.
                                    pointer-event(e) => {
                                        if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                                            self.menu-press = root.item-context(i, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, true);
                                        } else if e.kind == PointerEventKind.down && e.button == PointerEventButton.right
                                            && !self.pressed {
                                            root.item-context(i, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, false);
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // The Stacks layout: one stack per kind, a pile of
                    // cards with the kind's icon, name and count.
                    for stack[i] in root.stacks: Rectangle {
                        x: Theme.rtl ? row.span - i * root.cell-step - self.width : i * root.cell-step;
                        width: 64px;
                        height: 80px;
                        accessible-role: button;
                        accessible-label: @tr("{} {n}" | "{} {n}" % stack.count, stack.label);
                        accessible-action-default => {
                            root.stack-pressed(stack.kind);
                            root.stack-released(stack.kind);
                        }

                        // The cards beneath, peeking out above.
                        Rectangle {
                            x: 10px;
                            y: 0px;
                            width: 44px;
                            height: 20px;
                            border-radius: 8px;
                            background: #2a2a30;
                        }

                        Rectangle {
                            x: 5px;
                            y: 3px;
                            width: 54px;
                            height: 20px;
                            border-radius: 10px;
                            background: #232328;
                        }

                        Rectangle {
                            y: 7px;
                            height: 73px;
                            border-radius: 12px;
                            background: stack-touch.has-hover ? #2c2c32 : root.item-fill;
                            animate background { duration: 120ms; }

                            Image {
                                source: stack.icon;
                                colorize: stack-touch.has-hover ? white : #ffffffd0;
                                x: (parent.width - self.width) / 2;
                                y: 12px;
                                width: 28px;
                                height: 28px;
                            }

                            Text {
                                text: stack.label;
                                x: 4px;
                                y: 47px;
                                width: 56px;
                                height: 18px;
                                color: white;
                                font-size: 11px;
                                overflow: elide;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        // How many items the stack holds.
                        Rectangle {
                            x: Theme.rtl ? 2px : parent.width - self.width - 2px;
                            y: 9px;
                            width: max(18px, badge-text.preferred-width + 10px);
                            height: 18px;
                            border-radius: 9px;
                            background: root.accent;

                            badge-text := Text {
                                text: stack.count;
                                color: white;
                                font-size: 10px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        stack-touch := TouchArea {
                            // As a cell's: a press drags the stack's items
                            // out, a click opens the Pocket list on its kind.
                            pointer-event(e) => {
                                if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                                    root.stack-pressed(stack.kind);
                                } else if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left)
                                    || e.kind == PointerEventKind.cancel {
                                    root.stack-released(stack.kind);
                                }
                            }
                            moved => {
                                if self.pressed {
                                    root.stack-moved(stack.kind, self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
                                }
                            }
                        }
                    }

                    // The List layout: "All N" opens the list of every item.
                    if root.count > root.cells.length && root.layout == 0: Rectangle {
                        x: Theme.rtl ? row.span - root.cells.length * root.cell-step - self.width : root.cells.length * root.cell-step;
                        width: 44px;
                        height: 80px;
                        border-radius: 12px;
                        background: list-touch.has-hover ? #2c2c32 : root.item-fill;
                        accessible-role: button;
                        accessible-label: @tr("All {n}" | "All {n}" % root.count);
                        accessible-action-default => {
                            root.list-open();
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 1px;

                            Text {
                                text: @tr("All");
                                color: list-touch.has-hover ? white : #ffffff90;
                                font-size: 11px;
                                font-weight: 600;
                                horizontal-alignment: center;
                            }

                            Text {
                                text: root.count;
                                color: list-touch.has-hover ? white : #ffffffb0;
                                font-size: 13px;
                                font-weight: 600;
                                horizontal-alignment: center;
                            }
                        }

                        list-touch := TouchArea {
                            clicked => {
                                root.list-open();
                            }
                        }
                    }
                }

                // The strip's edges fade into the island where more items
                // lie beyond them.
                if row.strip: Rectangle {
                    x: row.x;
                    y: row.y;
                    width: 24px;
                    height: row.height;
                    background: @linear-gradient(90deg, #000000 0%, #00000000 100%);
                    opacity: row.content-x < 0 ? 1 : 0;
                    animate opacity { duration: 120ms; }
                }

                if row.strip: Rectangle {
                    x: row.x + row.width - self.width;
                    y: row.y;
                    width: 24px;
                    height: row.height;
                    background: @linear-gradient(90deg, #00000000 0%, #000000 100%);
                    opacity: row.content-x > row.width - row.content-width ? 1 : 0;
                    animate opacity { duration: 120ms; }
                }

                // Under the strip: how much of it is in view, and where.
                if row.strip && !root.hint: StripScrollbar {
                    x: row.x;
                    y: row.y + row.height + 5px;
                    width: row.width;
                    content-w: row.content-width;
                    offset: row.content-x;
                    scrolled(x) => {
                        row.content-x = x;
                    }
                }

                if !root.show-switch: PocketSide {
                    x: Theme.rtl ? root.pad : parent.width - root.pad - root.side-w;
                    y: 16px;
                    count: root.count;
                    undo-active: root.pocket-undo;
                    undo-left: root.undo-left;
                    undo-secs: root.undo-secs;
                    all-pressed => {
                        root.all-pressed();
                    }
                    all-moved(dx, dy) => {
                        root.all-moved(dx, dy);
                    }
                    all-released => {
                        root.all-released();
                    }
                    clear => {
                        root.clear();
                    }
                    undo => {
                        root.undo();
                    }
                }

                // Empty, or a drag hovers: say what a drop does.
                if root.hint || (root.count == 0 && !root.pocket-undo): DashedBox {
                    x: 8px;
                    y: 6px;
                    width: parent.width - 16px;
                    height: parent.height - 14px;
                    stroke: root.hint ? root.accent : #ffffff40;
                    thickness: root.hint ? 2px : 1.5px;
                    background: root.count > 0 || root.pocket-undo ? #000000d8 : transparent;

                    Image {
                        source: Icons.drop;
                        colorize: root.hint ? root.accent : #ffffff66;
                        width: 26px;
                        height: 26px;
                        x: (parent.width - self.width) / 2;
                        y: parent.height / 2 - self.height - 2px;
                    }

                    Text {
                        y: parent.height / 2 + 4px;
                        height: 18px;
                        text: @tr("Drop to add");
                        color: root.hint ? root.accent : #ffffff66;
                        font-size: 13px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            // The Clipboard view.
            if root.view == 1: ClipList {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: 232px;
                rows: root.clip-rows;
                filter: root.clip-filter;
                counts: root.clip-filter-counts;
                pressed(id) => {
                    root.clip-pressed(id);
                }
                pocket(id) => {
                    root.clip-pocket(id);
                }
                pin(id, on) => {
                    root.clip-pin(id, on);
                }
                filter-chosen(i) => {
                    root.clip-filter-chosen(i);
                }
                remove(id) => {
                    root.clip-remove(id);
                }
            }

            // The Pocket list.
            if root.view == 2: PocketList {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: 232px;
                side: !root.show-switch;
                rows: root.list-rows;
                chips: root.list-chips;
                filter: root.list-filter;
                count: root.count;
                undo-active: root.pocket-undo;
                undo-left: root.undo-left;
                undo-secs: root.undo-secs;
                pressed(id) => {
                    root.list-pressed(id);
                }
                moved(id, dx, dy) => {
                    root.list-moved(id, dx, dy);
                }
                released(id) => {
                    root.list-released(id);
                }
                remove(id) => {
                    root.list-remove(id);
                }
                filter-chosen(i) => {
                    root.list-filter-chosen(i);
                }
                back => {
                    root.list-back();
                }
                all-pressed => {
                    root.all-pressed();
                }
                all-moved(dx, dy) => {
                    root.all-moved(dx, dy);
                }
                all-released => {
                    root.all-released();
                }
                clear => {
                    root.clear();
                }
                undo => {
                    root.undo();
                }
            }

            // Under either view: the two buttons switching between them, and
            // at the end, the shown view's controls: the Pocket's column
            // ("Drag all" and Clear, or Undo), or the Clipboard's Clear (or
            // Undo).
            if root.show-switch: Rectangle {
                x: 0px;
                y: parent.height - self.height;
                width: parent.width;
                height: 40px;

                Rectangle {
                    x: root.pad;
                    y: 0px;
                    width: parent.width - 2 * root.pad;
                    height: 1px;
                    background: #ffffff14;
                }

                HorizontalLayout {
                    alignment: Theme.rtl ? end : start;
                    spacing: 6px;
                    padding-left: Theme.rtl ? 0px : root.pad;
                    padding-right: Theme.rtl ? root.pad : 0px;
                    padding-top: 4px;
                    padding-bottom: 8px;

                    SwitchButton {
                        layout-order: Theme.rtl ? 2 : 0;
                        icon: Icons.clipboard;
                        label: @tr("Clipboard");
                        count: root.clip-count;
                        current: root.view == 1;
                        clicked => {
                            root.view-chosen(1);
                        }
                    }

                    SwitchButton {
                        layout-order: Theme.rtl ? 1 : 0;
                        icon: Icons.pocket;
                        label: @tr("Pocket");
                        count: root.count;
                        // The Pocket list is part of the Pocket.
                        current: root.view != 1;
                        clicked => {
                            root.view-chosen(0);
                        }
                    }
                }

                if root.view != 1: PocketSide {
                    x: Theme.rtl ? root.pad : parent.width - root.pad - self.width;
                    y: 4px;
                    compact: true;
                    count: root.count;
                    undo-active: root.pocket-undo;
                    undo-left: root.undo-left;
                    undo-secs: root.undo-secs;
                    all-pressed => {
                        root.all-pressed();
                    }
                    all-moved(dx, dy) => {
                        root.all-moved(dx, dy);
                    }
                    all-released => {
                        root.all-released();
                    }
                    clear => {
                        root.clear();
                    }
                    undo => {
                        root.undo();
                    }
                }

                // Clear empties everything but pinned entries, whatever the
                // filter.
                if root.view == 1 && root.clip-filter-counts[0] > root.clip-filter-counts[1] && !root.clip-undo: ClearButton {
                    x: Theme.rtl ? root.pad : parent.width - root.pad - self.width;
                    y: 4px;
                    width: 28px;
                    clicked => {
                        root.clip-clear();
                    }
                }

                if root.view == 1 && root.clip-undo: UndoRing {
                    x: Theme.rtl ? root.pad : parent.width - root.pad - self.width;
                    y: 4px;
                    width: 80px;
                    compact: true;
                    left: root.undo-left;
                    secs: root.undo-secs;
                    clicked => {
                        root.undo();
                    }
                }
            }
        }
    }
}
