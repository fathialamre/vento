// The What's new window: what changed in Vento, feature by feature, after an
// update (and from About, or before an update as a preview). An ordinary
// titled window of a fixed size: a sidebar of the features that changed,
// under New, Improved and Everywhere, beside the overview of the version or
// the page of the feature chosen, and Done under them. It follows the
// Appearance and Theme settings through `Theme` and mirrors in a
// right-to-left language (the sidebar on the right), as the Settings window
// does.

import { LineText, Theme } from "theme.slint";
import { Icons } from "wheel.slint";
import { WrapText } from "controls.slint";
import { CenteredText, WelcomeButton } from "welcome.slint";

// A row of the sidebar: one feature that changed. `section` is the heading
// it sits under: 0 New, 1 Improved, 2 Everywhere (the rows come sorted by
// it). `unread` until the user opens it; `has-settings` when its page has
// Open Settings.
export struct WhatsNewItem { icon: image, label: string, section: int, unread: bool, has-settings: bool }
// One change on a feature's page: 0 new, 1 improved, 2 fixed (the rows come
// sorted by it), what changed, and where to find it in Settings (empty for
// none).
export struct WhatsNewChange { kind: int, text: string, path: string }

// The sidebar's first row: the version, and the one it came from.
component VersionRow inherits Rectangle {
    in property <string> title;
    in property <string> from-text;
    in property <bool> chosen;
    callback clicked();

    height: 44px;
    border-radius: 7px;
    background: self.chosen ? Theme.sidebar-chosen : (touch.has-hover ? Theme.text.transparentize(0.95) : transparent);
    accessible-role: tab;
    accessible-label: self.title;
    accessible-item-selected: self.chosen;
    accessible-action-default => { self.clicked(); }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;

        VerticalLayout {
            layout-order: Theme.rtl ? 2 : 0;
            alignment: center;

            Image {
                source: @image-url("../assets/app-icon.svg");
                width: 26px;
                height: 26px;
            }
        }

        VerticalLayout {
            layout-order: Theme.rtl ? 1 : 1;
            alignment: center;
            spacing: 1px;
            horizontal-stretch: 1;

            LineText {
                horizontal-alignment: Theme.rtl ? right : left;
                text: root.title;
                font-size: 13px;
                font-weight: 600;
                color: root.chosen ? Theme.accent : Theme.text;
            }

            if root.from-text != "": LineText {
                horizontal-alignment: Theme.rtl ? right : left;
                text: root.from-text;
                font-size: 11px;
                color: Theme.muted;
            }
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// A feature's row in the sidebar: its icon and name, and the accent dot
// until it is opened. Drawn chosen as the Settings window's sidebar rows
// are.
component FeatureRow inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> unread;
    in property <bool> chosen;
    callback clicked();

    height: 30px;
    border-radius: 7px;
    background: self.chosen ? Theme.sidebar-chosen : (touch.has-hover ? Theme.text.transparentize(0.95) : transparent);
    accessible-role: tab;
    accessible-label: self.label;
    accessible-item-selected: self.chosen;
    accessible-action-default => { self.clicked(); }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;

        VerticalLayout {
            layout-order: Theme.rtl ? 2 : 0;
            alignment: center;

            Image {
                source: root.icon;
                width: 16px;
                height: 16px;
                colorize: Theme.accent;
            }
        }

        LineText {
            layout-order: Theme.rtl ? 1 : 1;
            horizontal-stretch: 1;
            horizontal-alignment: Theme.rtl ? right : left;
            vertical-alignment: center;
            text: root.label;
            font-size: 13px;
            color: root.chosen ? Theme.accent : Theme.text;
        }

        VerticalLayout {
            layout-order: Theme.rtl ? 0 : 2;
            alignment: center;

            Rectangle {
                width: 7px;
                height: 7px;
                border-radius: 3.5px;
                background: root.unread ? Theme.accent : transparent;
            }
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// A small heading over a group: a section of the sidebar, the changes of
// one kind on a feature's page.
component GroupHeading inherits Text {
    horizontal-alignment: Theme.rtl ? right : left;
    font-size: 11px;
    font-weight: 700;
    color: Theme.muted;
}

// The card that asks for Screen Recording again, over the overview, with the
// button that shows how.
component NoticeCard inherits Rectangle {
    in property <string> text;
    callback clicked();

    border-radius: 8px;
    background: Theme.surface;

    HorizontalLayout {
        padding: 10px;
        spacing: 8px;

        VerticalLayout {
            layout-order: Theme.rtl ? 2 : 0;
            alignment: start;

            Image {
                source: Icons.missing;
                width: 14px;
                height: 14px;
                colorize: Theme.danger;
            }
        }

        VerticalLayout {
            layout-order: Theme.rtl ? 1 : 1;
            horizontal-stretch: 1;
            spacing: 8px;

            WrapText {
                text: root.text;
                font-size: 12px;
                color: Theme.text;
            }

            HorizontalLayout {
                alignment: Theme.rtl ? end : start;

                WelcomeButton {
                    label: @tr("Open Screen Recording settings");
                    clicked => { root.clicked(); }
                }
            }
        }
    }
}

// One change on a feature's page: its text, and under it where to find it
// in muted text. The changes of a kind share a card: each row draws its part
// of it (the card's edge, then its face inside it), the first under the
// kind's heading with the card's top, the last with its bottom.
component ChangeRow inherits VerticalLayout {
    in property <WhatsNewChange> change;
    in property <string> heading;
    in property <bool> first;
    in property <bool> last;

    if root.first: VerticalLayout {
        padding-top: 16px;
        padding-bottom: 6px;
        padding-left: 2px;
        padding-right: 2px;

        GroupHeading { text: root.heading; }
    }

    Rectangle {
        background: Theme.panel-border;
        border-top-left-radius: root.first ? 10px : 0px;
        border-top-right-radius: self.border-top-left-radius;
        border-bottom-left-radius: root.last ? 10px : 0px;
        border-bottom-right-radius: self.border-bottom-left-radius;

        VerticalLayout {
            padding-left: 1px;
            padding-right: 1px;
            padding-top: root.first ? 1px : 0px;
            padding-bottom: root.last ? 1px : 0px;

            Rectangle {
                background: Theme.panel;
                border-top-left-radius: root.first ? 9px : 0px;
                border-top-right-radius: self.border-top-left-radius;
                border-bottom-left-radius: root.last ? 9px : 0px;
                border-bottom-right-radius: self.border-bottom-left-radius;

                VerticalLayout {
                    // The line between two rows of a card.
                    if !root.first: Rectangle {
                        height: 1px;
                        background: Theme.panel-line;
                    }

                    VerticalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 9px;
                        padding-bottom: 9px;
                        spacing: 2px;

                        WrapText {
                            text: root.change.text;
                            font-size: 13px;
                            color: Theme.text;
                        }

                        if root.change.path != "": WrapText {
                            text: root.change.path;
                            font-size: 11px;
                            color: Theme.muted;
                        }
                    }
                }
            }
        }
    }
}

export component WhatsNewWindow inherits Window {
    default-font-family: Theme.font-family;
    title: @tr("What's new in Vento");
    default-font-size: 13px;
    // Fixed at 640 × 430, a little smaller than the Settings window.
    preferred-width: 640px;
    preferred-height: 430px;
    min-width: 640px;
    max-width: 640px;
    min-height: 430px;
    max-height: 430px;
    background: Theme.page;

    // The version shown ("Vento 0.4.0"), and the one it came from
    // ("Updated from 0.3.0"; empty when unknown).
    in property <string> version-title;
    in property <string> from-text;
    // How many changes are new, improved and fixed.
    in property <[int]> counts: [0, 0, 0];
    // The version's summary paragraph (empty for none).
    in property <string> summary;
    // Shown over the overview, with its button, when not empty.
    in property <string> notice;
    // The sidebar's feature rows, and the one shown: -1 the overview.
    in property <[WhatsNewItem]> items;
    in-out property <int> selected: -1;
    // The feature shown: its name, what it is, and whether it has Open
    // Settings; its changes.
    in property <string> detail-label;
    in property <string> detail-description;
    in property <bool> detail-has-settings;
    in property <[WhatsNewChange]> changes;

    // A row of the sidebar clicked (-1 the overview): vento sets `selected`
    // and the feature's page.
    callback select(int);
    // The feature page's Open Settings.
    callback open-settings();
    // The notice's button.
    callback notice-clicked();
    // Done, Esc and ⌘W (Ctrl+W elsewhere): vento closes the window.
    callback done();

    // The heading of sidebar section `s` and of change kind `k`.
    pure function section-name(s: int) -> string {
        s == 0 ? @tr("New") : s == 1 ? @tr("Improved") : @tr("Everywhere")
    }
    pure function kind-name(k: int) -> string {
        k == 0 ? @tr("New") : k == 1 ? @tr("Improved") : @tr("Fixed")
    }

    forward-focus: keys;

    // A page starts at its top.
    changed selected => {
        flick.content-y = 0;
    }

    keys := FocusScope {
        // `control` is ⌘ on a Mac.
        key-pressed(event) => {
            if (event.text == Key.Escape
                || (event.modifiers.control && (event.text == "w" || event.text == "W"))) {
                root.done();
                return accept;
            }
            return reject;
        }

        HorizontalLayout {
            side := Flickable {
                layout-order: Theme.rtl ? 2 : 0;
                width: 190px;
                content-width: self.width;
                content-height: max(self.height, list.preferred-height);

                list := VerticalLayout {
                    width: side.width;
                    padding: 8px;
                    spacing: 2px;
                    alignment: start;

                    VersionRow {
                        title: root.version-title;
                        from-text: root.from-text;
                        chosen: root.selected == -1;
                        clicked => { root.select(-1); }
                    }

                    for item[i] in root.items: VerticalLayout {
                        spacing: 2px;

                        if i == 0 || root.items[i - 1].section != item.section: VerticalLayout {
                            padding-top: 12px;
                            padding-bottom: 2px;
                            padding-left: 8px;
                            padding-right: 8px;

                            GroupHeading { text: root.section-name(item.section); }
                        }

                        FeatureRow {
                            icon: item.icon;
                            label: item.label;
                            unread: item.unread;
                            chosen: i == root.selected;
                            clicked => { root.select(i); }
                        }
                    }
                }
            }

            VerticalLayout {
                layout-order: Theme.rtl ? 1 : 1;
                horizontal-stretch: 1;

                flick := Flickable {
                    vertical-stretch: 1;
                    content-width: self.width;
                    content-height: max(self.height, body.preferred-height);

                    body := VerticalLayout {
                        width: flick.width;
                        padding-top: 22px;
                        padding-bottom: 16px;
                        padding-left: 24px;
                        padding-right: 24px;
                        alignment: start;

                        // The overview of the version.
                        if root.selected < 0: VerticalLayout {
                            alignment: start;

                            if root.notice != "": VerticalLayout {
                                padding-bottom: 14px;

                                NoticeCard {
                                    text: root.notice;
                                    clicked => { root.notice-clicked(); }
                                }
                            }

                            HorizontalLayout {
                                alignment: center;

                                Image {
                                    source: @image-url("../assets/app-icon.svg");
                                    width: 58px;
                                    height: 58px;
                                }
                            }

                            Rectangle { height: 10px; }

                            Text {
                                horizontal-alignment: center;
                                text: root.version-title;
                                font-size: 22px;
                                font-weight: 700;
                                color: Theme.text;
                            }

                            if root.from-text != "": Text {
                                horizontal-alignment: center;
                                text: root.from-text;
                                font-size: 13px;
                                color: Theme.muted;
                            }

                            Rectangle { height: 18px; }

                            HorizontalLayout {
                                alignment: center;
                                spacing: 36px;

                                for k in 3: VerticalLayout {
                                    layout-order: Theme.rtl ? 2 - k : k;
                                    spacing: 2px;

                                    Text {
                                        horizontal-alignment: center;
                                        text: root.counts[k];
                                        font-size: 26px;
                                        font-weight: 600;
                                        color: Theme.text;
                                    }

                                    Text {
                                        horizontal-alignment: center;
                                        text: root.kind-name(k);
                                        font-size: 11px;
                                        font-weight: 500;
                                        color: Theme.muted;
                                    }
                                }
                            }

                            Rectangle { height: 14px; }

                            if root.summary != "": HorizontalLayout {
                                alignment: center;

                                CenteredText {
                                    width: 360px;
                                    text: root.summary;
                                    font-size: 13px;
                                    color: Theme.text;
                                }
                            }

                            Rectangle { height: 14px; }

                            CenteredText {
                                text: @tr("Choose a feature on the left to see what changed.");
                                font-size: 12px;
                                color: Theme.muted;
                            }
                        }

                        // The page of the feature chosen.
                        if root.selected >= 0: VerticalLayout {
                            alignment: start;

                            Rectangle {
                                border-radius: 10px;
                                background: Theme.panel;
                                border-width: 1px;
                                border-color: Theme.panel-border;

                                HorizontalLayout {
                                    padding: 12px;
                                    spacing: 12px;

                                    VerticalLayout {
                                        layout-order: Theme.rtl ? 2 : 0;
                                        alignment: center;

                                        Image {
                                            source: root.items[root.selected].icon;
                                            width: 24px;
                                            height: 24px;
                                            colorize: Theme.accent;
                                        }
                                    }

                                    VerticalLayout {
                                        layout-order: Theme.rtl ? 1 : 1;
                                        alignment: center;
                                        spacing: 2px;
                                        horizontal-stretch: 1;

                                        LineText {
                                            horizontal-alignment: Theme.rtl ? right : left;
                                            text: root.detail-label;
                                            font-size: 16px;
                                            font-weight: 700;
                                            color: Theme.text;
                                        }

                                        WrapText {
                                            text: root.detail-description;
                                            font-size: 12px;
                                            color: Theme.muted;
                                        }
                                    }

                                    if root.detail-has-settings: VerticalLayout {
                                        layout-order: Theme.rtl ? 0 : 2;
                                        alignment: center;

                                        WelcomeButton {
                                            label: @tr("Open Settings");
                                            clicked => { root.open-settings(); }
                                        }
                                    }
                                }
                            }

                            for change[i] in root.changes: ChangeRow {
                                change: change;
                                heading: root.kind-name(change.kind);
                                first: i == 0 || root.changes[i - 1].kind != change.kind;
                                last: i == root.changes.length - 1 || root.changes[i + 1].kind != change.kind;
                            }
                        }
                    }
                }

                // Done, at the end of the line, under a hairline.
                Rectangle {
                    height: 1px;
                    background: Theme.panel-border;
                }

                HorizontalLayout {
                    height: 52px;
                    padding-left: 16px;
                    padding-right: 16px;

                    Rectangle {
                        layout-order: Theme.rtl ? 1 : 0;
                        horizontal-stretch: 1;
                    }

                    VerticalLayout {
                        layout-order: Theme.rtl ? 0 : 1;
                        alignment: center;

                        WelcomeButton {
                            label: @tr("Done");
                            primary: true;
                            clicked => { root.done(); }
                        }
                    }
                }
            }
        }
    }
}
