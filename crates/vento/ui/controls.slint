// The controls of the Quick panel and the Settings window. All of them
// take their colours from `Theme`, so they follow the Appearance setting.

import { LineText, Theme } from "theme.slint";

// Tabler Icons (MIT, see icons/LICENSE-tabler), embedded at build time.
export global PanelIcons {
    out property <image> wheel: @image-url("icons/hexagons.svg");
    out property <image> general: @image-url("icons/settings.svg");
    out property <image> pause: @image-url("icons/player-pause.svg");
    out property <image> resume: @image-url("icons/player-play.svg");
    out property <image> quit: @image-url("icons/power.svg");
    out property <image> grip: @image-url("icons/grip-vertical.svg");
    out property <image> add: @image-url("icons/plus.svg");
    out property <image> folder: @image-url("icons/folder.svg");
    // Drawn in Tabler's style (a coffee cup; text in a scan frame).
    out property <image> awake: @image-url("icons/coffee.svg");
    out property <image> scan-text: @image-url("icons/scan-text.svg");
    // An open How to card.
    out property <image> open-down: @image-url("icons/chevron-down.svg");
}

// A small heading over a group of controls.
export component SectionHeading inherits Text {
    horizontal-alignment: Theme.rtl ? right : left;
    font-size: 11px;
    font-weight: 600;
    color: Theme.muted;
}

export component Separator inherits Rectangle {
    height: 1px;
    background: Theme.separator;
}

// Text that wraps at its width and is as tall as its lines. A wrapping Text
// laid out beside something else can be given the height of fewer lines
// than it wraps into, which cuts its lines off; this one asks for its
// wrapped height.
export component WrapText {
    in property <string> text;
    in property <length> font-size;
    in property <int> font-weight;
    in property <brush> color;

    min-height: lines.preferred-height;

    lines := Text {
        width: root.width;
        height: root.height;
        text: root.text;
        font-size: root.font-size;
        font-weight: root.font-weight;
        color: root.color;
        wrap: word-wrap;
        horizontal-alignment: Theme.rtl ? right : left;
        vertical-alignment: center;
    }
}

// Settings that belong together, on a rounded card. The page puts a
// `Separator` between its rows.
export component Group inherits Rectangle {
    border-radius: 10px;
    background: Theme.card;

    VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;

        @children
    }
}

// The heading over a `Group`, with anything given to it (a button, a
// note) at the end of the line.
export component GroupHeading inherits HorizontalLayout {
    in property <string> text;

    padding-left: 4px;
    padding-right: 4px;
    padding-top: 4px;
    spacing: 8px;

    SectionHeading {
        layout-order: Theme.rtl ? 2 : 0;
        text: root.text;
        vertical-alignment: center;
        horizontal-stretch: 1;
    }

    HorizontalLayout {
        layout-order: Theme.rtl ? 1 : 0;
        horizontal-stretch: 0;

        @children
    }
}

// One setting in a `Group`: its name, and under it what it does when
// `description` is set, at the start of the line; its control (the
// children) at the end. A setting that is not `enabled` shows its name
// dimmed.
export component SettingRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> description;
    in property <bool> enabled: true;

    min-height: 44px;
    padding-top: 8px;
    padding-bottom: 8px;
    spacing: 12px;

    VerticalLayout {
        layout-order: Theme.rtl ? 2 : 0;
        alignment: center;
        spacing: 2px;
        horizontal-stretch: 1;

        WrapText {
            text: root.label;
            font-size: 13px;
            color: root.enabled ? Theme.text : Theme.muted;
        }

        if root.description != "": WrapText {
            text: root.description;
            font-size: 11px;
            color: Theme.muted;
        }
    }

    VerticalLayout {
        layout-order: Theme.rtl ? 1 : 0;
        alignment: center;
        horizontal-stretch: 0;

        @children
    }
}

// A button in a setting's row, drawn like the fields beside it. A
// `danger` one says so in red. `name` is what assistive technology calls
// it, where the word alone would not say what it acts on.
export component RowButton inherits Rectangle {
    in property <string> label;
    in property <string> name: self.label;
    in property <bool> danger;
    callback clicked();

    height: 26px;
    min-width: label.preferred-width + 20px;
    border-radius: 6px;
    background: touch.has-hover ? Theme.field-hover : Theme.field;
    border-width: Theme.dark ? 0px : 1px;
    border-color: Theme.separator;
    accessible-role: button;
    accessible-label: self.name;
    accessible-action-default => { self.clicked(); }

    label := Text {
        text: root.label;
        font-size: 12px;
        color: root.danger ? Theme.danger : Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// An on/off switch. It shows `on` as given and asks for the other state
// when clicked; whoever uses it decides. On is the knob at the end of the
// line: the right, or the left in a right-to-left language.
export component Switch inherits Rectangle {
    in property <bool> on;
    in property <string> label;
    callback toggled(bool);

    width: 26px;
    height: 15px;
    border-radius: self.height / 2;
    background: self.on ? Theme.accent : Theme.switch-off;
    animate background { duration: 120ms; }
    accessible-role: switch;
    accessible-label: self.label;
    accessible-checkable: true;
    accessible-checked: self.on;
    accessible-action-default => { self.toggled(!self.on); }

    Rectangle {
        x: root.on != Theme.rtl ? root.width - self.width - 2px : 2px;
        y: (root.height - self.height) / 2;
        width: 11px;
        height: 11px;
        border-radius: self.height / 2;
        background: white;
        drop-shadow-blur: 1px;
        drop-shadow-color: #00000033;
        animate x { duration: 120ms; easing: ease-out; }
    }

    // A little larger than the track, so it is easy to hit.
    TouchArea {
        x: -4px;
        y: -6px;
        width: root.width + 8px;
        height: root.height + 12px;
        clicked => { root.toggled(!root.on); }
    }
}

// A row-height segmented control: a rounded track with the chosen item
// raised on a pill. The first item is at the start of the line.
export component Segmented inherits Rectangle {
    in property <[string]> items;
    in property <int> current;
    callback chosen(int);

    property <length> pad: 2px;
    property <length> item-w: (self.width - 2 * self.pad) / max(1, self.items.length);

    // Where item `i` sits, counted from the left.
    pure function slot(i: int) -> int {
        Theme.rtl ? root.items.length - 1 - i : i
    }

    height: 26px;
    border-radius: 7px;
    background: Theme.track;
    accessible-role: radio-group;

    Rectangle {
        x: root.pad + root.slot(root.current) * root.item-w;
        y: root.pad;
        width: root.item-w;
        height: root.height - 2 * root.pad;
        border-radius: 5px;
        background: Theme.selected;
        drop-shadow-blur: 3px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: Theme.dark ? #00000059 : #0000001f;
        animate x { duration: 150ms; easing: ease-out; }
    }

    for item[i] in root.items: Rectangle {
        property <bool> on: i == root.current;
        x: root.pad + root.slot(i) * root.item-w;
        y: root.pad;
        width: root.item-w;
        height: root.height - 2 * root.pad;
        accessible-role: radio-button;
        accessible-label: item;
        accessible-checkable: true;
        accessible-checked: self.on;
        accessible-action-default => { root.chosen(i); }

        Text {
            width: 100%;
            height: 100%;
            text: item;
            font-size: 12px;
            font-weight: on ? 600 : 400;
            color: on ? Theme.text : Theme.muted;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        TouchArea {
            clicked => { root.chosen(i); }
        }
    }
}

// A field showing the chosen item; clicking it opens the list.
export component MenuField inherits Rectangle {
    in property <[string]> items;
    in property <int> current;
    in property <string> label;
    callback chosen(int);

    property <length> item-h: 26px;
    property <bool> valid: self.current >= 0 && self.current < self.items.length;

    height: 26px;
    border-radius: 6px;
    background: touch.has-hover ? Theme.field-hover : Theme.field;
    border-width: Theme.dark ? 0px : 1px;
    border-color: Theme.separator;
    accessible-role: combobox;
    accessible-label: self.label;
    accessible-value: self.valid ? self.items[self.current] : "";
    accessible-action-default => { popup.show(); }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;

        LineText {
            layout-order: Theme.rtl ? 2 : 0;
            horizontal-alignment: Theme.rtl ? right : left;
            text: root.valid ? root.items[root.current] : @tr("None found");
            font-size: 13px;
            color: root.valid ? Theme.text : Theme.muted;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        // A down chevron.
        VerticalLayout {
            layout-order: Theme.rtl ? 1 : 0;
            alignment: center;

            Path {
                width: 9px;
                height: 5px;
                viewbox-width: 9;
                viewbox-height: 5;
                commands: "M 1 0.5 L 4.5 4 L 8 0.5";
                stroke: Theme.muted;
                stroke-width: 1.5px;
            }
        }
    }

    touch := TouchArea {
        enabled: root.items.length > 0;
        clicked => { popup.show(); }
    }

    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: root.width;
        height: root.items.length * root.item-h + 8px;

        Rectangle {
            background: Theme.selected;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.separator;
            drop-shadow-blur: 8px;
            drop-shadow-offset-y: 2px;
            drop-shadow-color: #00000040;

            VerticalLayout {
                padding: 4px;

                for item[i] in root.items: Rectangle {
                    height: root.item-h;
                    border-radius: 6px;
                    background: item-touch.has-hover ? Theme.surface : transparent;
                    accessible-role: list-item;
                    accessible-label: item;
                    accessible-item-selected: i == root.current;
                    accessible-action-default => { root.chosen(i); }

                    HorizontalLayout {
                        padding-left: Theme.rtl ? 0px : 6px;
                        padding-right: Theme.rtl ? 6px : 0px;
                        spacing: 6px;

                        // A check mark on the chosen item.
                        VerticalLayout {
                            layout-order: Theme.rtl ? 2 : 0;
                            alignment: center;

                            Path {
                                width: 10px;
                                height: 8px;
                                viewbox-width: 10;
                                viewbox-height: 8;
                                commands: "M 1 4 L 4 7 L 9 1";
                                stroke: i == root.current ? Theme.accent : transparent;
                                stroke-width: 1.5px;
                            }
                        }

                        Text {
                            layout-order: Theme.rtl ? 1 : 0;
                            horizontal-alignment: Theme.rtl ? right : left;
                            text: item;
                            font-size: 13px;
                            color: Theme.text;
                            vertical-alignment: center;
                        }
                    }

                    item-touch := TouchArea {
                        clicked => { root.chosen(i); }
                    }
                }
            }
        }
    }
}

// A quiet button: an optional icon and a word, highlighted on hover. A
// disabled one shows its label muted and does nothing.
export component TextButton inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> has-icon;
    in property <bool> enabled: true;
    callback clicked();

    height: 24px;
    border-radius: 6px;
    background: self.enabled && touch.has-hover ? Theme.surface : transparent;
    accessible-role: button;
    accessible-label: self.label;
    accessible-enabled: self.enabled;
    accessible-action-default => {
        if (self.enabled) {
            self.clicked();
        }
    }

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 4px;

        if root.has-icon: VerticalLayout {
            layout-order: Theme.rtl ? 2 : 0;
            alignment: center;

            Image {
                source: root.icon;
                width: 14px;
                height: 14px;
                colorize: root.enabled ? Theme.text : Theme.muted;
            }
        }

        Text {
            layout-order: Theme.rtl ? 1 : 0;
            horizontal-alignment: Theme.rtl ? right : left;
            text: root.label;
            font-size: 12px;
            color: root.enabled ? Theme.text : Theme.muted;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// A Keep Awake time choice, on `surface` like the other fields, drawn
// chosen (the accent, faint) while its time runs.
export component Chip inherits Rectangle {
    in property <string> label;
    in property <bool> chosen;
    callback clicked();

    height: 28px;
    border-radius: 8px;
    background: self.chosen ? Theme.accent-soft : touch.has-hover ? Theme.hover : Theme.surface;
    accessible-role: button;
    accessible-label: self.label;
    accessible-checkable: true;
    accessible-checked: self.chosen;
    accessible-action-default => { self.clicked(); }

    Text {
        text: root.label;
        font-size: 12px;
        color: root.chosen ? Theme.accent : Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// A small square button showing only an icon; `label` names it for
// assistive technology.
export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked();

    width: 22px;
    height: 22px;
    border-radius: 6px;
    background: self.enabled && touch.has-hover ? Theme.surface : transparent;
    opacity: self.enabled ? 1 : 0.4;
    accessible-role: button;
    accessible-label: self.label;
    accessible-enabled: self.enabled;
    accessible-action-default => {
        if (self.enabled) {
            self.clicked();
        }
    }

    Image {
        source: root.icon;
        width: 14px;
        height: 14px;
        colorize: root.enabled && touch.has-hover ? Theme.text : Theme.muted;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// One of a stepper's two buttons, drawing − or +.
component StepButton inherits Rectangle {
    in property <bool> plus;
    in property <string> label;
    in property <bool> enabled;
    callback clicked();

    width: 24px;
    height: 24px;
    border-radius: 6px;
    background: self.enabled && touch.has-hover ? Theme.field-hover : Theme.field;
    border-width: Theme.dark ? 0px : 1px;
    border-color: Theme.separator;
    accessible-role: button;
    accessible-label: self.label;
    accessible-enabled: self.enabled;
    accessible-action-default => {
        if (self.enabled) {
            self.clicked();
        }
    }

    Path {
        width: 10px;
        height: 10px;
        viewbox-width: 10;
        viewbox-height: 10;
        commands: root.plus ? "M 1 5 L 9 5 M 5 1 L 5 9" : "M 1 5 L 9 5";
        stroke: root.enabled ? Theme.text : Theme.muted;
        stroke-width: 1.5px;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// A value with a − button before it and a + button after it (the other
// way round in a right-to-left language).
export component Stepper inherits HorizontalLayout {
    in property <string> text;
    in property <string> label;
    in property <bool> can-decrease;
    in property <bool> can-increase;
    callback decrease();
    callback increase();

    spacing: 4px;

    StepButton {
        layout-order: Theme.rtl ? 3 : 0;
        plus: false;
        label: @tr("Less {}", root.label);
        enabled: root.can-decrease;
        clicked => { root.decrease(); }
    }

    Text {
        layout-order: Theme.rtl ? 2 : 0;
        min-width: 56px;
        text: root.text;
        font-size: 13px;
        color: Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-label: root.label;
        accessible-value: root.text;
    }

    StepButton {
        layout-order: Theme.rtl ? 1 : 0;
        plus: true;
        label: @tr("More {}", root.label);
        enabled: root.can-increase;
        clicked => { root.increase(); }
    }
}

// A field showing a keyboard shortcut. Clicking it starts recording: it
// then reads "Press a shortcut…" and takes the keyboard, so no other key
// handling in the panel reacts; Esc, a second click or losing focus
// cancels. vento reads the combination itself and ends the recording. A
// disabled field shows its shortcut dimmed and cannot start recording.
export component ShortcutField inherits Rectangle {
    // The shortcut as the platform writes it, e.g. "⌃⌥P" or "Ctrl+Alt+P".
    in property <string> text;
    in property <string> label;
    in property <bool> enabled: true;
    in-out property <bool> recording;
    callback started();
    callback cancelled();

    height: 26px;
    border-radius: 6px;
    background: self.recording || (self.enabled && touch.has-hover) ? Theme.field-hover : Theme.field;
    border-width: self.recording ? 2px : Theme.dark ? 0px : 1px;
    border-color: self.recording ? Theme.accent : Theme.separator;
    accessible-role: button;
    accessible-label: self.label;
    accessible-value: self.recording ? @tr("Press a shortcut…") : self.text;
    accessible-enabled: self.enabled;
    accessible-action-default => { root.start(); }

    function start() {
        if (!root.enabled) {
            return;
        }
        root.recording = true;
        scope.focus();
        root.started();
    }

    Text {
        text: root.recording ? @tr("Press a shortcut…") : root.text;
        font-size: 13px;
        color: root.recording || !root.enabled ? Theme.muted : Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    scope := FocusScope {
        key-pressed(event) => {
            if (!root.recording) {
                return reject;
            }
            if (event.text == Key.Escape) {
                root.cancelled();
            }
            return accept;
        }
        changed has-focus => {
            if (!self.has-focus && root.recording) {
                root.cancelled();
            }
        }
    }

    touch := TouchArea {
        clicked => {
            if (root.recording) {
                root.cancelled();
            } else {
                root.start();
            }
        }
    }
}

// A row of a list whose rows can be dragged into a new order. While row
// `drag-from` is dragged it follows the pointer, raised, and the rows it
// passes slide aside to make room for it at `drag-to`.
export component ReorderRow inherits Rectangle {
    in property <int> index;
    in property <int> drag-from;
    in property <int> drag-to;
    in property <length> drag-offset;
    in property <length> row-h;

    property <bool> dragged: self.index == self.drag-from;
    // The place this row takes while another one is dragged past it.
    property <int> slot: self.drag-from < 0 || self.dragged
        ? self.index
        : self.index > self.drag-from && self.index <= self.drag-to
            ? self.index - 1
            : self.index < self.drag-from && self.index >= self.drag-to ? self.index + 1 : self.index;

    x: 0;
    y: self.dragged ? self.index * self.row-h + self.drag-offset : self.slot * self.row-h;
    z: self.dragged ? 1 : 0;
    height: self.row-h;
    border-radius: 6px;
    background: self.dragged ? Theme.selected : transparent;
    // Only the dragged row casts a shadow: a zero-blur shadow still draws a
    // solid offset copy of the row, which would box every row in.
    drop-shadow-blur: self.dragged ? 6px : 0px;
    drop-shadow-offset-y: self.dragged ? 1px : 0px;
    drop-shadow-color: !self.dragged ? transparent : Theme.dark ? #00000066 : #00000026;
    // Rows making room slide; the dragged row and the drop are immediate.
    animate y {
        duration: root.drag-from >= 0 && !root.dragged ? 120ms : 0ms;
        easing: ease-out;
    }
}

// The grip a `ReorderRow` is dragged by. The list keeps the drag state
// (`drag-from`, `drag-offset`), shared by all its grips; a grip starts a
// drag of its row, moves it within `lo`…`hi`, and on release reports
// `moved(from, to)` when the row would land somewhere new (`drop-to`).
export component DragGrip inherits Rectangle {
    in property <int> index;
    in property <length> row-h;
    // The first and last place the row can go, and where it would drop now.
    in property <int> lo;
    in property <int> hi;
    in property <int> drop-to;
    in-out property <int> drag-from;
    in-out property <length> drag-offset;
    callback moved(int, int);

    width: 16px;

    Image {
        source: PanelIcons.grip;
        width: 14px;
        height: 14px;
        colorize: Theme.muted;
    }

    TouchArea {
        mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down
                    && event.button == PointerEventButton.left) {
                root.drag-from = root.index;
                root.drag-offset = 0;
            } else if (root.drag-from == root.index
                    && ((event.kind == PointerEventKind.up
                            && event.button == PointerEventButton.left)
                        || event.kind == PointerEventKind.cancel)) {
                let from = root.drag-from;
                let to = root.drop-to;
                root.drag-from = -1;
                root.drag-offset = 0;
                if (to != from && event.kind == PointerEventKind.up) {
                    root.moved(from, to);
                }
            }
        }
        // The pointer is measured from where the row is now, so the offset
        // grows by how far it is from where it was pressed; the row stays
        // within the places it can go.
        moved => {
            if (root.drag-from == root.index) {
                root.drag-offset = clamp(
                    root.drag-offset + self.mouse-y - self.pressed-y,
                    (root.lo - root.index) * root.row-h,
                    (root.hi - root.index) * root.row-h);
            }
        }
    }
}

// Keep Awake's choices: a row of times, then the two open-ended ones and
// Stop. A chosen chip shows what runs; clicking another replaces it.
export component AwakeChips inherits VerticalLayout {
    // Whether anything is held: Stop is enabled only then.
    in property <bool> on;
    // The running chip: 0 to 5 the timed ones, 6 until stopped, 7 until a
    // time; -1 none.
    in property <int> chip;
    // The time the Until popup shows, set by vento as the panel opens.
    in-out property <int> until-hour;
    in-out property <int> until-minute;
    // A chip other than "Until…", or that one while it runs.
    callback chip-clicked(int);
    // The Until popup's Start.
    callback until-started(int, int);
    callback stop-clicked();

    property <[string]> times: [@tr("15 min"), @tr("30 min"), @tr("1 h"), @tr("2 h"), @tr("4 h"), @tr("8 h")];

    function two-digits(n: int) -> string {
        return (n < 10 ? "0" : "") + n;
    }

    spacing: 4px;

    HorizontalLayout {
        spacing: 4px;

        for time[i] in root.times: Chip {
            layout-order: Theme.rtl ? -i : 0;
            horizontal-stretch: 1;
            label: time;
            chosen: root.chip == i;
            clicked => { root.chip-clicked(i); }
        }
    }

    Rectangle {
        height: 28px;

        HorizontalLayout {
            spacing: 4px;

            Chip {
                layout-order: Theme.rtl ? 3 : 0;
                horizontal-stretch: 1;
                label: @tr("Until stopped");
                chosen: root.chip == 6;
                clicked => { root.chip-clicked(6); }
            }

            Chip {
                layout-order: Theme.rtl ? 2 : 0;
                horizontal-stretch: 1;
                label: @tr("Until…");
                chosen: root.chip == 7;
                clicked => {
                    if (root.chip == 7) {
                        root.chip-clicked(7);
                    } else {
                        until-popup.show();
                    }
                }
            }

            VerticalLayout {
                layout-order: Theme.rtl ? 1 : 0;
                alignment: center;

                TextButton {
                    label: @tr("Stop");
                    enabled: root.on;
                    clicked => { root.stop-clicked(); }
                }
            }
        }

        // Under "Until…", at the end of the row.
        until-popup := PopupWindow {
            x: Theme.rtl ? 0px : parent.width - self.width;
            y: parent.height + 4px;
            width: 252px;
            height: 112px;
            close-policy: PopupClosePolicy.close-on-click-outside;

            Rectangle {
                background: Theme.selected;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.separator;
                drop-shadow-blur: 8px;
                drop-shadow-offset-y: 2px;
                drop-shadow-color: #00000040;

                VerticalLayout {
                    padding: 10px;
                    spacing: 8px;

                    Text {
                        horizontal-alignment: Theme.rtl ? right : left;
                        text: @tr("Stay awake until");
                        font-size: 12px;
                        color: Theme.muted;
                    }

                    HorizontalLayout { // ltr: a time reads hours then minutes in every language
                        alignment: center;
                        spacing: 4px;

                        Stepper {
                            text: root.two-digits(root.until-hour);
                            label: @tr("Hour");
                            can-decrease: true;
                            can-increase: true;
                            decrease => { root.until-hour = Math.mod(root.until-hour + 23, 24); }
                            increase => { root.until-hour = Math.mod(root.until-hour + 1, 24); }
                        }

                        Text {
                            text: ":";
                            font-size: 13px;
                            color: Theme.text;
                            vertical-alignment: center;
                        }

                        Stepper {
                            text: root.two-digits(root.until-minute);
                            label: @tr("Minute");
                            can-decrease: true;
                            can-increase: true;
                            decrease => { root.until-minute = Math.mod(root.until-minute + 55, 60); }
                            increase => { root.until-minute = Math.mod(root.until-minute + 5, 60); }
                        }
                    }

                    HorizontalLayout {
                        alignment: Theme.rtl ? start : end;

                        TextButton {
                            label: @tr("Start");
                            clicked => {
                                root.until-started(root.until-hour, root.until-minute);
                                until-popup.close();
                            }
                        }
                    }
                }
            }
        }
    }
}

// The panel's shape, drawn as one outline so the arrow and the body share
// a fill and a hairline with no seam: a rounded rectangle below `arrow-h`,
// and on its top edge an arrow 20px wide whose centre is `arrow-x`, its tip
// rounded and its base curving into the edge. The outline runs half a
// pixel inside the element so the whole hairline is drawn.
export component PanelOutline inherits Path {
    in property <length> arrow-x;
    in property <length> arrow-h;
    in property <length> radius;

    // In path units, which are logical pixels here (see the viewbox).
    property <float> s: 0.5;
    property <float> w: self.width / 1px - self.s;
    property <float> h: self.height / 1px - self.s;
    property <float> top: self.arrow-h / 1px + self.s;
    property <float> r: self.radius / 1px;
    property <float> ax: self.arrow-x / 1px;
    // Half the arrow's base, how far its base curves into the edge, and
    // where along each side (as a fraction from the tip) the tip's
    // rounding starts.
    property <float> half: 10;
    property <float> blend: 3;
    property <float> round: 0.25;
    // The arrow's height in path units, from the top edge to the tip.
    property <float> rise: self.top - self.s;

    viewbox-x: 0;
    viewbox-y: 0;
    viewbox-width: self.width / 1px;
    viewbox-height: self.height / 1px;
    fill: Theme.bg;
    stroke: Theme.border;
    stroke-width: 1px;

    MoveTo {
        x: root.ax - root.half - root.blend;
        y: root.top;
    }
    // Into the arrow's left side, tangent to the edge and to the side.
    QuadraticTo {
        control-x: root.ax - root.half;
        control-y: root.top;
        x: root.ax - root.half + root.blend;
        y: root.top - root.rise * root.blend / root.half;
    }
    LineTo {
        x: root.ax - root.half * root.round;
        y: root.s + root.rise * root.round;
    }
    // The rounded tip: its apex lies 1.25 below `s`, and the panel code
    // places the window by that (TIP_INSET).
    QuadraticTo {
        control-x: root.ax;
        control-y: root.s;
        x: root.ax + root.half * root.round;
        y: root.s + root.rise * root.round;
    }
    LineTo {
        x: root.ax + root.half - root.blend;
        y: root.top - root.rise * root.blend / root.half;
    }
    QuadraticTo {
        control-x: root.ax + root.half;
        control-y: root.top;
        x: root.ax + root.half + root.blend;
        y: root.top;
    }
    LineTo {
        x: root.w - root.r;
        y: root.top;
    }
    ArcTo {
        x: root.w;
        y: root.top + root.r;
        radius-x: root.r;
        radius-y: root.r;
        sweep: true;
    }
    LineTo {
        x: root.w;
        y: root.h - root.r;
    }
    ArcTo {
        x: root.w - root.r;
        y: root.h;
        radius-x: root.r;
        radius-y: root.r;
        sweep: true;
    }
    LineTo {
        x: root.s + root.r;
        y: root.h;
    }
    ArcTo {
        x: root.s;
        y: root.h - root.r;
        radius-x: root.r;
        radius-y: root.r;
        sweep: true;
    }
    LineTo {
        x: root.s;
        y: root.top + root.r;
    }
    ArcTo {
        x: root.s + root.r;
        y: root.top;
        radius-x: root.r;
        radius-y: root.r;
        sweep: true;
    }
    Close { }
}
